dpc:fivetran-managed-data-lake-service a dpc:Technology ;
  skos:prefLabel "Fivetran Managed Data Lake Service"@en ;
  dcterms:description "Destination option that writes replicated data as Parquet files with Iceberg metadata, and optionally Delta Lake metadata, into the customer's S3, ADLS or GCS storage, and maintains the tables."@en ;
  dpc:realises dpc:open-table-formats ;
  dpc:realises dpc:table-catalogue ;
  dpc:realises dpc:table-maintenance ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:table-format-conversion ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://fivetran.com/docs/managed-data-lake-service> .

dpc:flyway a dpc:Technology ;
  skos:prefLabel "Flyway Community"@en ;
