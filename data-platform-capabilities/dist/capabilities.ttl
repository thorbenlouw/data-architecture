dpc:gcp-bigquery-studio a dpc:Technology ;
  skos:prefLabel "BigQuery Studio"@en ;
  dcterms:description "Workspace in the BigQuery console that combines the SQL editor, Colab Enterprise notebooks, Spark sessions, data canvas and saved assets."@en ;
