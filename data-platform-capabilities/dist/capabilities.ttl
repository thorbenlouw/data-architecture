  skos:related dpc:schema-registry ;
  skos:related dpc:data-export ;
  skos:altLabel "storage formats"@en ;
  skos:definition "Store data in open, well-specified file formats such as Parquet, ORC, Avro and JSON."@en .

dpc:file-ingestion a skos:Concept ;
  skos:prefLabel "File ingestion"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:batch-ingestion ;
