dpc:informatica-data-masking-transformation a dpc:Technology ;
  skos:prefLabel "Informatica Data Masking transformation"@en ;
  dcterms:description "Mapping transformation that replaces sensitive values with realistic masked values per column while keeping referential integrity across tables, for non-production copies."@en ;
  skos:altLabel "Cloud Data Masking"@en ;
