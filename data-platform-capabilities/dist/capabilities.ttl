dpc:freshness-monitoring a skos:Concept ;
  skos:prefLabel "Freshness monitoring"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:data-observability ;
  skos:related dpc:data-slas ;
  skos:related dpc:pipeline-monitoring ;
  skos:related dpc:asset-based-orchestration ;
  skos:related dpc:data-alerting ;
  skos:related dpc:impact-analysis ;
  skos:definition "Detect when data arrives later than expected or misses its freshness target."@en .

dpc:fti-pipelines a dpc:Pattern ;
  skos:prefLabel "Feature, training and inference pipelines"@en ;
  dcterms:description "Split an ML system into independent feature, training and inference pipelines that share a feature store and model registry."@en ;
  skos:altLabel "FTI pipelines"@en ;
  dpc:uses dpc:feature-engineering ;
  dpc:uses dpc:feature-store ;
  dpc:uses dpc:offline-feature-store ;
  dpc:uses dpc:online-feature-store ;
  dpc:uses dpc:point-in-time-joins ;
  dpc:uses dpc:model-training ;
  dpc:uses dpc:model-registry ;
  dpc:uses dpc:batch-inference ;
  dpc:uses dpc:real-time-inference ;
  dpc:uses dpc:model-lineage .

dpc:full-text-search a skos:Concept ;
  skos:prefLabel "Full-text search"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:specialised-data ;
  skos:related dpc:vector-search ;
  skos:related dpc:retrieval-augmented-generation ;
  skos:related dpc:observability-analytics ;
  skos:related dpc:permission-aware-retrieval ;
  skos:related dpc:data-skipping-indexes ;
  skos:altLabel "search engine"@en ;
  skos:altLabel "inverted index"@en ;
  skos:definition "Index text for full-text search, relevance ranking and fast filtering."@en .

dpc:galileo a dpc:Technology ;
  skos:prefLabel "Splunk Agent Observability"@en ;
  dcterms:description "Evaluation and observability for AI agents and LLM applications, formerly Galileo, that uses small evaluation models to score outputs and block bad ones at runtime."@en ;
  skos:altLabel "Galileo AI"@en ;
  skos:altLabel "Galileo"@en ;
  dpc:realises dpc:genai-evaluation ;
  dpc:realises dpc:genai-observability ;
  dpc:realises dpc:ai-guardrails ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://www.splunk.com/en_us/about-splunk/acquisitions/galileo.html> .

dpc:gcp-agent-development-kit a dpc:Technology ;
  skos:prefLabel "Google Agent Development Kit"@en ;
  dcterms:description "Open-source framework for writing single- and multi-agent applications with tools, memory and evaluation, deployable to Agent Runtime, Cloud Run or GKE."@en ;
  skos:altLabel "ADK"@en ;
  skos:altLabel "Agent Development Kit"@en ;
  dpc:realises dpc:ai-agents ;
  dpc:realises dpc:agent-tool-access ;
  dpc:realises dpc:agent-interoperability ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/gemini-enterprise-agent-platform/build/adk> .

dpc:gcp-agent-gateway a dpc:Technology ;
  skos:prefLabel "Google Cloud Agent Gateway"@en ;
  dcterms:description "Gateway that sits between agents, models and tools to enforce identity, policy, content screening and network controls on agent traffic."@en ;
  skos:altLabel "Agent Gateway"@en ;
  dpc:realises dpc:ai-gateway ;
  dpc:realises dpc:agent-tool-access ;
  dpc:realises dpc:ai-guardrails ;
  dpc:realises dpc:network-security ;
  dpc:realises dpc:agent-identity ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/gemini-enterprise-agent-platform/govern/gateways/agent-gateway-overview> .

dpc:gcp-agent-observability a dpc:Technology ;
  skos:prefLabel "Google Cloud Agent Observability"@en ;
  dcterms:description "Traces, logs, metrics and topology views of agent runs, tool calls and model calls on Agent Platform, built on Cloud Observability."@en ;
  skos:altLabel "Agent Observability"@en ;
  dpc:realises dpc:genai-observability ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/gemini-enterprise-agent-platform/optimize/observability/overview> .

dpc:gcp-agent-platform-automl a dpc:Technology ;
  skos:prefLabel "Agent Platform AutoML"@en ;
  dcterms:description "Trains tabular, image and video models from labelled data with automatic feature engineering, architecture search and tuning."@en ;
  skos:altLabel "Vertex AI AutoML"@en ;
  dpc:realises dpc:automl ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/vertex-ai/docs/beginner/beginners-guide> .

dpc:gcp-agent-platform-endpoints a dpc:Technology ;
  skos:prefLabel "Agent Platform Endpoints"@en ;
  dcterms:description "Managed online prediction endpoints, plus batch prediction jobs, for serving registered models with autoscaling, GPUs and traffic splitting between model versions."@en ;
  skos:altLabel "Agent Platform Inference"@en ;
  skos:altLabel "Vertex AI Endpoints"@en ;
  skos:altLabel "Vertex AI Prediction"@en ;
  dpc:realises dpc:real-time-inference ;
  dpc:realises dpc:batch-inference ;
  dpc:realises dpc:canary-ab-testing ;
  dpc:realises dpc:inference-logging ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/vertex-ai/docs/predictions/overview> .

dpc:gcp-agent-platform-experiments a dpc:Technology ;
  skos:prefLabel "Experiments on Agent Platform"@en ;
  dcterms:description "Tracks parameters, metrics and artefacts of training runs and pipeline runs so they can be compared, with a managed TensorBoard for visualisation."@en ;
  skos:altLabel "Vertex AI Experiments"@en ;
  dpc:realises dpc:experiment-tracking ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/vertex-ai/docs/experiments/intro-vertex-ai-experiments> .

dpc:gcp-agent-platform-feature-store a dpc:Technology ;
  skos:prefLabel "Agent Platform Feature Store"@en ;
  dcterms:description "Feature management that uses BigQuery tables as the offline store and syncs selected features to online stores for low-latency serving."@en ;
  skos:altLabel "Vertex AI Feature Store"@en ;
  dpc:realises dpc:feature-store ;
  dpc:realises dpc:offline-feature-store ;
  dpc:realises dpc:online-feature-store ;
  dpc:realises dpc:point-in-time-joins ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/vertex-ai/docs/featurestore/latest/overview> .

dpc:gcp-agent-platform-managed-training a dpc:Technology ;
  skos:prefLabel "Agent Platform Managed Training"@en ;
  dcterms:description "Runs custom training jobs in prebuilt or custom containers on CPUs, GPUs or TPUs, including multi-node distributed training and hyperparameter tuning."@en ;
  skos:altLabel "Vertex AI Training"@en ;
  skos:altLabel "Vertex AI custom training"@en ;
  dpc:realises dpc:model-training ;
  dpc:realises dpc:distributed-training ;
  dpc:realises dpc:hyperparameter-tuning ;
  dpc:realises dpc:gpu-compute ;
  dpc:realises dpc:reserved-capacity ;
  dpc:realises dpc:interruptible-compute ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/vertex-ai/docs/training/overview> .

dpc:gcp-agent-platform-model-evaluation a dpc:Technology ;
  skos:prefLabel "Agent Platform Model Evaluation"@en ;
  dcterms:description "Computes evaluation metrics for registered models on test data, including data and model bias metrics, and, with Explainable AI, gives feature attributions for predictions."@en ;
  skos:altLabel "Vertex AI Model Evaluation"@en ;
  dpc:realises dpc:model-evaluation ;
  dpc:realises dpc:model-explainability ;
  dpc:realises dpc:fairness-assessment ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/vertex-ai/docs/evaluation/introduction> .

dpc:gcp-agent-platform-model-registry a dpc:Technology ;
  skos:prefLabel "Agent Platform Model Registry"@en ;
  dcterms:description "Central registry for versioning custom, AutoML and BigQuery ML models, with aliases and deployment to endpoints or batch jobs."@en ;
  skos:altLabel "Vertex AI Model Registry"@en ;
  dpc:realises dpc:model-registry ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/vertex-ai/docs/model-registry/introduction> .

dpc:gcp-agent-platform-pipelines a dpc:Technology ;
  skos:prefLabel "Agent Platform Pipelines"@en ;
  dcterms:description "Serverless execution of Kubeflow Pipelines and TFX workflows, with each run's artefacts and parameters recorded in ML Metadata."@en ;
  skos:altLabel "Vertex AI Pipelines"@en ;
  dpc:realises dpc:ml-pipelines ;
  dpc:realises dpc:continuous-training ;
  dpc:realises dpc:model-lineage ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/vertex-ai/docs/pipelines/introduction> .

dpc:gcp-agent-platform-workbench a dpc:Technology ;
  skos:prefLabel "Agent Platform Workbench"@en ;
  dcterms:description "Managed JupyterLab instances with configurable CPUs, GPUs and Google Cloud integrations for data science and ML development."@en ;
  skos:altLabel "Vertex AI Workbench"@en ;
  dpc:realises dpc:notebooks ;
  dpc:realises dpc:gpu-compute ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/vertex-ai/docs/workbench/introduction> .

dpc:gcp-agent-registry a dpc:Technology ;
  skos:prefLabel "Google Cloud Agent Registry"@en ;
  dcterms:description "Inventory of the agents, tools and MCP servers in an organisation, used to register, discover and govern them."@en ;
  skos:altLabel "Agent Registry"@en ;
  dpc:realises dpc:agent-registry ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/gemini-enterprise-agent-platform/release-notes> .

dpc:gcp-agent-runtime a dpc:Technology ;
  skos:prefLabel "Google Cloud Agent Runtime"@en ;
  dcterms:description "Managed runtime for deploying and scaling agents built with ADK or other frameworks, with managed sessions and long-term memory."@en ;
  skos:altLabel "Agent Runtime"@en ;
  skos:altLabel "Agent Platform Sessions"@en ;
  skos:altLabel "Agent Platform Memory Bank"@en ;
  skos:altLabel "Vertex AI Agent Engine"@en ;
  skos:altLabel "Agent Engine"@en ;
  skos:altLabel "Reasoning Engine"@en ;
  dpc:realises dpc:agent-runtime ;
  dpc:realises dpc:agent-memory ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/gemini-enterprise-agent-platform/scale/runtime/deploy-an-agent> .

dpc:gcp-agent-search a dpc:Technology ;
  skos:prefLabel "Google Cloud Agent Search"@en ;
  dcterms:description "Managed enterprise search and retrieval over websites, documents, structured data and connected applications, used to ground agents and chat applications."@en ;
  skos:altLabel "Agent Search"@en ;
  skos:altLabel "Agent Search for Commerce"@en ;
  skos:altLabel "Vertex AI Search"@en ;
  skos:altLabel "AI Applications"@en ;
  skos:altLabel "Vertex AI Search and Conversation"@en ;
  skos:altLabel "Generative AI App Builder"@en ;
  dpc:realises dpc:retrieval-augmented-generation ;
  dpc:realises dpc:retrieval-pipelines ;
  dpc:realises dpc:vector-search ;
  dpc:realises dpc:permission-aware-retrieval ;
  dpc:realises dpc:full-text-search ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/generative-ai-app-builder/docs/introduction> .

dpc:gcp-agent-studio a dpc:Technology ;
  skos:prefLabel "Google Cloud Agent Studio"@en ;
  dcterms:description "Console workspace for designing and testing prompts and agents, comparing models and tuning Gemini models."@en ;
  skos:altLabel "Agent Studio"@en ;
  skos:altLabel "App Builder in Agent Studio"@en ;
  skos:altLabel "Vertex AI Studio"@en ;
  dpc:realises dpc:prompt-management ;
  dpc:realises dpc:model-customisation ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/gemini-enterprise-agent-platform/agent-studio> .

dpc:gcp-alloydb a dpc:Technology ;
  skos:prefLabel "AlloyDB for PostgreSQL"@en ;
  dcterms:description "PostgreSQL-compatible database with a disaggregated storage layer, columnar engine for analytical queries and built-in vector search and AI functions."@en ;
  skos:altLabel "AlloyDB Omni"@en ;
  skos:altLabel "AlloyDB AI"@en ;
  dpc:realises dpc:operational-database ;
  dpc:realises dpc:vector-search ;
  dpc:realises dpc:ai-functions ;
  dpc:realises dpc:deployment-options ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/alloydb/docs/overview> .

dpc:gcp-apigee a dpc:Technology ;
  skos:prefLabel "Apigee"@en ;
  dcterms:description "API management platform for publishing, securing, rate-limiting and monitoring APIs, including APIs that expose data products and LLM endpoints."@en ;
  skos:altLabel "Apigee X"@en ;
  skos:altLabel "Apigee API hub"@en ;
  dpc:realises dpc:data-apis ;
  dpc:realises dpc:ai-gateway ;
  dpc:realises dpc:ai-spend-controls ;
  dpc:realises dpc:data-product-metering ;
  dpc:realises dpc:event-api-catalogue ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/apigee/docs/api-platform/get-started/what-apigee> .

dpc:gcp-application-integration a dpc:Technology ;
  skos:prefLabel "Google Cloud Application Integration"@en ;
  dcterms:description "Integration-platform-as-a-service for building API, event and process integrations visually, using Integration Connectors to reach SaaS and on-premises systems."@en ;
  skos:altLabel "Integration Connectors"@en ;
  dpc:realises dpc:application-integration ;
  dpc:realises dpc:saas-connectors ;
  dpc:realises dpc:api-ingestion ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/application-integration/docs/overview> .

dpc:gcp-assured-workloads a dpc:Technology ;
  skos:prefLabel "Assured Workloads"@en ;
  dcterms:description "Applies controls for data location, personnel access and supported services to folders so workloads meet regulatory regimes such as FedRAMP, CJIS and EU sovereignty requirements."@en ;
  dpc:realises dpc:data-residency ;
  dpc:realises dpc:compliance-evidence ;
  dpc:realises dpc:configuration-guardrails ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/assured-workloads/docs/overview> .

dpc:gcp-bigquery a dpc:Technology ;
  skos:prefLabel "BigQuery"@en ;
  dcterms:description "Serverless analytical database that runs GoogleSQL over managed and open-format tables with storage and compute billed and scaled separately."@en ;
  skos:altLabel "BQ"@en ;
  dpc:realises dpc:sql-query-engine ;
  dpc:realises dpc:serverless-compute ;
  dpc:realises dpc:decoupled-storage-compute ;
  dpc:realises dpc:semi-structured-data ;
  dpc:realises dpc:sql-access ;
  dpc:realises dpc:approximate-query-processing ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/introduction> .

dpc:gcp-bigquery-ai-functions a dpc:Technology ;
  skos:prefLabel "BigQuery generative AI functions"@en ;
  dcterms:description "SQL functions such as AI.GENERATE, AI.GENERATE_TABLE, AI.IF, AI.CLASSIFY, AI.SCORE, AI.AGG and AI.EMBED that call Gemini and partner models over table rows and unstructured objects."@en ;
  dpc:realises dpc:ai-functions ;
  dpc:realises dpc:embedding-generation ;
  dpc:realises dpc:ai-spend-controls ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/generative-ai-overview> .

dpc:gcp-bigquery-bi-engine a dpc:Technology ;
  skos:prefLabel "BigQuery BI Engine"@en ;
  dcterms:description "In-memory cache in front of BigQuery that speeds up dashboard-style SQL queries, sized as a regional memory reservation."@en ;
  dpc:realises dpc:query-acceleration ;
  dpc:realises dpc:result-caching ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/bi-engine-intro> .

dpc:gcp-bigquery-cdc a dpc:Technology ;
  skos:prefLabel "BigQuery change data capture"@en ;
  dcterms:description "Applies streamed upserts and deletes, keyed on a declared primary key, to BigQuery tables in the background with a configurable staleness bound."@en ;
  dpc:realises dpc:change-data-capture ;
  dpc:realises dpc:row-level-updates ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/change-data-capture> .

dpc:gcp-bigquery-change-history a dpc:Technology ;
  skos:prefLabel "BigQuery change history (APPENDS and CHANGES)"@en ;
  dcterms:description "Table-valued functions that return rows appended to, or changed in, a table over a time range so downstream jobs can process only the delta."@en ;
  dpc:realises dpc:change-feeds ;
  dpc:realises dpc:incremental-processing ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/change-history> .

dpc:gcp-bigquery-continuous-queries a dpc:Technology ;
  skos:prefLabel "BigQuery continuous queries"@en ;
  dcterms:description "Long-running SQL statements that process rows as they arrive in a table and write results to BigQuery or Iceberg tables, Pub/Sub, Bigtable or Spanner."@en ;
  dpc:realises dpc:stream-processing ;
  dpc:realises dpc:streaming-sql ;
  dpc:realises dpc:reverse-etl ;
  dpc:realises dpc:streaming-inference ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/continuous-queries-introduction> .

dpc:gcp-bigquery-conversational-analytics a dpc:Technology ;
  skos:prefLabel "BigQuery conversational analytics"@en ;
  dcterms:description "Natural-language question answering over BigQuery tables, views, graphs and Lakehouse tables through configurable data agents with instructions, glossary terms and verified queries."@en ;
  dpc:realises dpc:conversational-analytics ;
  dpc:realises dpc:ai-agents ;
  dpc:realises dpc:ai-context-layer ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/conversational-analytics> .

dpc:gcp-bigquery-data-canvas a dpc:Technology ;
  skos:prefLabel "BigQuery data canvas"@en ;
  dcterms:description "Visual canvas in BigQuery where users chain search, SQL, chart and insight nodes, driven by natural-language prompts to Gemini."@en ;
  dpc:realises dpc:ad-hoc-analysis ;
  dpc:realises dpc:conversational-analytics ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/data-canvas> .

dpc:gcp-bigquery-data-clean-rooms a dpc:Technology ;
  skos:prefLabel "BigQuery data clean rooms"@en ;
  dcterms:description "Built on BigQuery sharing, lets several parties contribute data that others can query only through analysis rules or approved query templates."@en ;
  dpc:realises dpc:data-clean-rooms ;
  dpc:realises dpc:privacy-enhancing-technologies ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/data-clean-rooms> .

dpc:gcp-bigquery-data-engineering-agent a dpc:Technology ;
  skos:prefLabel "BigQuery Data Engineering Agent"@en ;
  dcterms:description "Gemini agent in BigQuery pipelines and Dataform that writes or changes pipeline code (SQLX) from natural-language requests and investigates failed runs."@en ;
  dpc:realises dpc:data-engineering-agents ;
  dpc:realises dpc:agent-interoperability ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/data-engineering-agent-pipelines> .

dpc:gcp-bigquery-data-masking a dpc:Technology ;
  skos:prefLabel "BigQuery data masking"@en ;
  dcterms:description "Masks column values at query time according to data policies, using rules such as hashing, nullifying, partial masking or custom masking routines."@en ;
  dpc:realises dpc:column-masking ;
  dpc:realises dpc:deidentification ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/column-data-masking-intro> .

dpc:gcp-bigquery-data-preparation a dpc:Technology ;
  skos:prefLabel "BigQuery data preparation"@en ;
  dcterms:description "Visual, Gemini-assisted editor for cleaning, joining and reshaping BigQuery data that saves its steps as runnable SQLX."@en ;
  dpc:realises dpc:data-preparation ;
  dpc:realises dpc:low-code-transformation ;
  dpc:realises dpc:data-cleansing ;
  dpc:realises dpc:bad-data-quarantine ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/data-prep-introduction> .

dpc:gcp-bigquery-data-transfer-service a dpc:Technology ;
  skos:prefLabel "BigQuery Data Transfer Service"@en ;
  dcterms:description "Scheduled, managed loads into BigQuery from Google marketing products, SaaS applications, other warehouses, databases and cloud object stores."@en ;
  skos:altLabel "BigQuery DTS"@en ;
  dpc:realises dpc:saas-connectors ;
  dpc:realises dpc:database-extraction ;
  dpc:realises dpc:file-ingestion ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/dts-introduction> .

dpc:gcp-bigquery-dataframes a dpc:Technology ;
  skos:prefLabel "BigQuery DataFrames"@en ;
  dcterms:description "Python library (bigframes) offering pandas- and scikit-learn-style APIs that compile to BigQuery SQL so data stays in BigQuery."@en ;
  skos:altLabel "bigframes"@en ;
  dpc:realises dpc:dataframe-apis ;
  dpc:realises dpc:feature-engineering ;
  dpc:realises dpc:ai-functions ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/bigquery-dataframes-introduction> .

dpc:gcp-bigquery-editions a dpc:Technology ;
  skos:prefLabel "BigQuery editions"@en ;
  dcterms:description "Slot-based capacity model in Standard, Enterprise and Enterprise Plus tiers, with autoscaling reservations, optional baseline slots and one- or three-year commitments."@en ;
  dpc:realises dpc:provisioned-compute ;
  dpc:realises dpc:elastic-scaling ;
  dpc:realises dpc:reserved-capacity ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/editions-intro> .

dpc:gcp-bigquery-export-data a dpc:Technology ;
  skos:prefLabel "BigQuery EXPORT DATA"@en ;
  dcterms:description "SQL statement that writes query results to Cloud Storage files or directly into Bigtable, Spanner, Pub/Sub and AlloyDB."@en ;
  dpc:realises dpc:data-export ;
  dpc:realises dpc:reverse-etl ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/exporting-data> .

dpc:gcp-bigquery-external-tables a dpc:Technology ;
  skos:prefLabel "BigQuery external tables and load jobs"@en ;
  dcterms:description "Reads or loads Parquet, ORC, Avro, JSON and CSV files from Cloud Storage, including Hive-partitioned layouts, as queryable external tables or native tables."@en ;
  skos:altLabel "BigLake tables"@en ;
  dpc:realises dpc:file-formats ;
  dpc:realises dpc:file-ingestion ;
  dpc:realises dpc:query-federation ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/external-data-sources> .

dpc:gcp-bigquery-federated-queries a dpc:Technology ;
  skos:prefLabel "BigQuery federated queries"@en ;
  dcterms:description "Sends queries from BigQuery to Cloud SQL, AlloyDB, Spanner and SAP Datasphere through connections and joins the results with BigQuery data."@en ;
  dpc:realises dpc:query-federation ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/federated-queries-intro> .

dpc:gcp-bigquery-geospatial a dpc:Technology ;
  skos:prefLabel "BigQuery geospatial analytics"@en ;
  dcterms:description "GEOGRAPHY type, spatial functions and spatial clustering for storing and analysing points, lines and polygons in BigQuery."@en ;
  skos:altLabel "BigQuery GIS"@en ;
  dpc:realises dpc:geospatial-data ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/geospatial-intro> .

dpc:gcp-bigquery-graph a dpc:Technology ;
  skos:prefLabel "BigQuery Graph"@en ;
  dcterms:description "Defines property graphs over existing BigQuery tables and queries them with ISO GQL, without copying data."@en ;
  dpc:realises dpc:graph-data ;
  dpc:realises dpc:knowledge-graphs ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/graph-overview> .

dpc:gcp-bigquery-iceberg-managed-tables a dpc:Technology ;
  skos:prefLabel "BigQuery tables for Apache Iceberg"@en ;
  dcterms:description "BigQuery-managed tables stored as Apache Iceberg files in your Cloud Storage bucket, with BigQuery handling writes, clustering, compaction and garbage collection."@en ;
  skos:altLabel "Iceberg managed tables"@en ;
  skos:altLabel "BigQuery Iceberg tables"@en ;
  skos:altLabel "BigLake tables for Apache Iceberg in BigQuery"@en ;
  skos:altLabel "BigLake managed tables"@en ;
  dpc:realises dpc:open-table-formats ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:table-maintenance ;
  dpc:realises dpc:row-level-updates ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/biglake/docs/biglake-iceberg-tables> .

dpc:gcp-bigquery-information-schema a dpc:Technology ;
  skos:prefLabel "BigQuery INFORMATION_SCHEMA views"@en ;
  dcterms:description "System views exposing jobs, slot usage, reservations, storage, table metadata and replication state as queryable tables."@en ;
  dpc:realises dpc:system-telemetry ;
  dpc:realises dpc:query-performance-analysis ;
  dpc:realises dpc:cost-attribution ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/information-schema-intro> .

dpc:gcp-bigquery-managed-disaster-recovery a dpc:Technology ;
  skos:prefLabel "BigQuery managed disaster recovery"@en ;
  dcterms:description "Cross-region dataset replication paired with failover reservations so compute and storage can be switched to a secondary region in a hard or soft failover."@en ;
  dpc:realises dpc:cross-region-failover ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/managed-disaster-recovery> .

dpc:gcp-bigquery-managed-storage a dpc:Technology ;
  skos:prefLabel "BigQuery managed storage"@en ;
  dcterms:description "Internal columnar storage for native BigQuery tables, with automatic compression, replication, partitioning, clustering and transactional writes."@en ;
  dpc:realises dpc:managed-storage ;
  dpc:realises dpc:columnar-storage ;
  dpc:realises dpc:partitioning-clustering ;
  dpc:realises dpc:acid-transactions ;
  dpc:realises dpc:schema-evolution ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/storage_overview> .

dpc:gcp-bigquery-materialized-views a dpc:Technology ;
  skos:prefLabel "BigQuery materialized views"@en ;
  dcterms:description "Precomputed query results that BigQuery refreshes incrementally and uses to rewrite matching queries automatically."@en ;
