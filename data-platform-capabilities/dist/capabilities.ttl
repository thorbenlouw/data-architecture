dpc:purview-data-lifecycle-management a dpc:Technology ;
  skos:prefLabel "Microsoft Purview Data Lifecycle Management"@en ;
  dcterms:description "Applies retention policies and labels that keep or delete content for set periods, with records management for regulated items."@en ;
  dpc:realises dpc:data-retention ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/purview/data-lifecycle-management> .

dpc:purview-data-loss-prevention a dpc:Technology ;
  skos:prefLabel "Microsoft Purview Data Loss Prevention"@en ;
  dcterms:description "Detects sensitive information in Microsoft 365, endpoints and Fabric items and raises policy tips, alerts or access restrictions."@en ;
  dpc:realises dpc:data-loss-prevention ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/governance/data-loss-prevention-overview> .

dpc:purview-data-map a dpc:Technology ;
  skos:prefLabel "Microsoft Purview Data Map"@en ;
  dcterms:description "Scans on-premises, multicloud and SaaS sources to harvest schemas, classifications and lineage into a metadata graph with Apache Atlas-compatible APIs."@en ;
  skos:altLabel "Azure Purview"@en ;
  dpc:realises dpc:metadata-harvesting ;
  dpc:realises dpc:data-classification ;
  dpc:realises dpc:metadata-interoperability ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/purview/data-map> .

dpc:purview-data-products a dpc:Technology ;
  skos:prefLabel "Data products in Microsoft Purview Unified Catalog"@en ;
  dcterms:description "Groups related tables, files and reports into a published data product with owners, terms of use and an access request and approval workflow."@en ;
  dpc:realises dpc:data-product-specification ;
  dpc:realises dpc:access-requests ;
  dpc:realises dpc:data-product-lifecycle ;
  dpc:realises dpc:data-marketplace ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/purview/unified-catalog-data-products> .

dpc:purview-data-quality a dpc:Technology ;
  skos:prefLabel "Microsoft Purview Data Quality"@en ;
  dcterms:description "Profiles data and runs out-of-the-box, custom and AI-suggested quality rules on data products, rolling scores up to products and domains."@en ;
  dpc:realises dpc:data-quality-rules ;
  dpc:realises dpc:data-profiling ;
  dpc:realises dpc:data-quality-scorecards ;
  dpc:realises dpc:freshness-monitoring ;
  dpc:realises dpc:data-issue-management ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/purview/unified-catalog-data-quality> .

dpc:purview-dspm a dpc:Technology ;
  skos:prefLabel "Microsoft Purview Data Security Posture Management"@en ;
  dcterms:description "Finds sensitive data and oversharing risks across Microsoft 365, AI apps and agents and connected third-party stores, and recommends DLP, labelling and insider risk policies."@en ;
  skos:altLabel "Purview DSPM"@en ;
  skos:altLabel "Microsoft Purview AI Hub"@en ;
  skos:altLabel "DSPM for AI"@en ;
  dpc:realises dpc:data-security-posture ;
  dpc:realises dpc:ai-system-discovery ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/purview/data-security-posture-management-learn-about> .

dpc:purview-information-protection a dpc:Technology ;
  skos:prefLabel "Microsoft Purview Information Protection"@en ;
  dcterms:description "Sensitivity labels applied manually or automatically to files, emails and Fabric and Power BI items, with encryption and inheritance downstream."@en ;
  skos:altLabel "Microsoft Purview sensitivity labels"@en ;
  skos:altLabel "Microsoft Information Protection"@en ;
  dpc:realises dpc:data-classification ;
  dpc:realises dpc:encryption ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/governance/information-protection> .

dpc:purview-insider-risk-management a dpc:Technology ;
  skos:prefLabel "Microsoft Purview Insider Risk Management"@en ;
  dcterms:description "Correlates user activity signals to detect and investigate risky behaviour such as data theft or leaks by people inside the organisation."@en ;
