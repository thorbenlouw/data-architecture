  dpc:realises dpc:data-threat-detection ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/purview/insider-risk-management> .

dpc:purview-lineage a dpc:Technology ;
  skos:prefLabel "Data lineage in Microsoft Purview"@en ;
