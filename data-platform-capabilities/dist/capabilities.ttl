  dpc:realises dpc:notebooks ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/query-overview> .

dpc:gcp-bigquery-table-clones a dpc:Technology ;
  skos:prefLabel "BigQuery table clones"@en ;
  dcterms:description "Writable copies of a table that share storage with the base table and are billed only for data that later changes in either."@en ;
  dpc:realises dpc:zero-copy-cloning ;
  dpc:realises dpc:test-data-management ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/table-clones-intro> .

dpc:gcp-bigquery-table-snapshots a dpc:Technology ;
  skos:prefLabel "BigQuery table snapshots"@en ;
  dcterms:description "Read-only, point-in-time copies of a table that store only the bytes that differ from the base table and can be kept beyond the time travel window."@en ;
  dpc:realises dpc:backup-restore ;
  dpc:realises dpc:data-versioning ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/table-snapshots-intro> .

dpc:gcp-bigquery-time-travel a dpc:Technology ;
  skos:prefLabel "BigQuery time travel"@en ;
  dcterms:description "Lets you query or restore a table as it was at any point within a configurable window of two to seven days, backed by a further fail-safe period."@en ;
  dpc:realises dpc:time-travel ;
  dpc:realises dpc:backup-restore ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/time-travel> .

dpc:gcp-bigquery-udfs a dpc:Technology ;
  skos:prefLabel "BigQuery user-defined functions"@en ;
  dcterms:description "Extends GoogleSQL with SQL, JavaScript and Python UDFs, remote functions on Cloud Run, stored procedures and stored procedures for Apache Spark."@en ;
  dpc:realises dpc:user-defined-functions ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/user-defined-functions> .

dpc:gcp-bigquery-vector-search a dpc:Technology ;
  skos:prefLabel "BigQuery vector search"@en ;
  dcterms:description "Stores embeddings in BigQuery tables and finds nearest neighbours with VECTOR_SEARCH and AI.SEARCH, optionally using IVF or TreeAH vector indexes."@en ;
