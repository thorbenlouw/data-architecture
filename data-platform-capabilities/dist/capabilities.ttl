  skos:altLabel "landing zone ingestion"@en ;
  skos:altLabel "incremental file loading"@en ;
  skos:altLabel "Snowpipe"@en ;
  skos:definition "Detect and load files arriving in landing storage, processing each file exactly once."@en .

dpc:fivetran a dpc:Technology ;
  skos:prefLabel "Fivetran"@en ;
  dcterms:description "Managed ELT service that extracts data from SaaS applications, databases, files and APIs through prebuilt connectors and loads it into warehouses and lakes on a schedule."@en ;
  dpc:realises dpc:saas-connectors ;
  dpc:realises dpc:database-extraction ;
  dpc:realises dpc:change-data-capture ;
  dpc:realises dpc:custom-connectors ;
  dpc:realises dpc:hybrid-data-plane ;
  dpc:realises dpc:idempotent-loading ;
  dpc:platform dpc:platform-independent ;
