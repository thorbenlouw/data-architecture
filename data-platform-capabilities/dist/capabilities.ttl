  dpc:realises dpc:data-catalogue ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/ui-snowsight-universal-search> .

dpc:snowflake-unload a dpc:Technology ;
  skos:prefLabel "Snowflake data unloading (COPY INTO <location>)"@en ;
