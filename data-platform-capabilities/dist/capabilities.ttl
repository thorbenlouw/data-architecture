  dpc:realises dpc:ai-assisted-development ;
  dpc:realises dpc:data-reconciliation ;
  dpc:realises dpc:code-translation ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/migration-intro> .

dpc:gcp-bigquery-ml a dpc:Technology ;
  skos:prefLabel "BigQuery ML"@en ;
  dcterms:description "Creates, trains, evaluates and runs machine learning models with SQL inside BigQuery, including imported and remote models."@en ;
