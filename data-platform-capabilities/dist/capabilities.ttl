  skos:related dpc:entity-resolution ;
  skos:related dpc:streaming-ingestion ;
  dpc:dependsOn dpc:acid-transactions ;
  skos:altLabel "exactly-once delivery"@en ;
  skos:altLabel "deduplication"@en ;
  skos:definition "Make loads safe to retry or replay by removing duplicates on write so nothing is counted twice."@en .

