dpc:warpstream a dpc:Technology ;
  skos:prefLabel "WarpStream"@en ;
  dcterms:description "Kafka-compatible streaming service that runs as stateless agents in the customer's cloud account and writes data directly to object storage, managed by Confluent."@en ;
