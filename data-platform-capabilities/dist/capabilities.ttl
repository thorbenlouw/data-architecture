dpc:informatica-data-observability a dpc:Technology ;
  skos:prefLabel "Informatica data observability"@en ;
  dcterms:description "Learns normal trends in scanned source data, raises events for sudden deviations, grouped by metric and severity, and improves its alerts from how users respond to them."@en ;
