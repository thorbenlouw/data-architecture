dpc:transactional-outbox a dpc:Pattern ;
  skos:prefLabel "Transactional outbox"@en ;
  dcterms:description "Write events to an outbox table in the same transaction as the business change, then publish them reliably."@en ;
  skos:altLabel "outbox pattern"@en ;
  skos:altLabel "outbox table"@en ;
  dpc:uses dpc:operational-database ;
  dpc:uses dpc:change-data-capture ;
  dpc:uses dpc:event-streaming ;
  dpc:uses dpc:message-queuing ;
  dpc:uses dpc:schema-registry ;
  dpc:uses dpc:data-contracts ;
  dpc:uses dpc:idempotent-loading .

dpc:transformation-as-code a skos:Concept ;
