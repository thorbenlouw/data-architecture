  dpc:realises dpc:hyperparameter-tuning ;
  dpc:realises dpc:model-explainability ;
  dpc:realises dpc:pretrained-predictive-models ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/bqml-introduction> .

dpc:gcp-bigquery-object-tables a dpc:Technology ;
  skos:prefLabel "BigQuery object tables and ObjectRef"@en ;
  dcterms:description "Exposes files in Cloud Storage as rows of metadata (object tables) or as ObjectRef values inside ordinary tables so images, documents and audio can be governed and processed with SQL."@en ;
  dpc:realises dpc:unstructured-data ;
  dpc:realises dpc:unstructured-ingestion ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/object-table-introduction> .

dpc:gcp-bigquery-omni a dpc:Technology ;
  skos:prefLabel "BigQuery Omni"@en ;
  dcterms:description "Runs BigQuery queries on data held in Amazon S3 or Azure Blob Storage, using BigQuery-managed compute in the corresponding AWS or Azure region."@en ;
  dpc:realises dpc:query-federation ;
  dpc:realises dpc:deployment-options ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/omni-introduction> .

dpc:gcp-bigquery-pipelines a dpc:Technology ;
  skos:prefLabel "BigQuery pipelines"@en ;
  dcterms:description "Console-built, Dataform-backed pipelines that run SQL, notebook, data preparation and SQLX tasks in dependency order on a schedule."@en ;
  dpc:realises dpc:workflow-orchestration ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/pipelines-introduction> .

dpc:gcp-bigquery-policy-tags a dpc:Technology ;
  skos:prefLabel "BigQuery policy tags"@en ;
  dcterms:description "Hierarchical taxonomies of tags attached to columns that drive column-level access control and data masking policies."@en ;
  dpc:realises dpc:attribute-based-access ;
  dpc:realises dpc:column-masking ;
  dpc:realises dpc:data-classification ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/column-level-security-intro> .

dpc:gcp-bigquery-row-level-security a dpc:Technology ;
  skos:prefLabel "BigQuery row-level security"@en ;
  dcterms:description "Row access policies that filter which rows of a table each user or group can see, using SQL filter expressions and optional lookup subqueries."@en ;
  dpc:realises dpc:row-level-security ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/row-level-security-intro> .

dpc:gcp-bigquery-search-indexes a dpc:Technology ;
  skos:prefLabel "BigQuery search indexes"@en ;
  dcterms:description "Indexes text and JSON columns so the SEARCH function and equality or LIKE filters can find matching rows without full scans."@en ;
  dpc:realises dpc:data-skipping-indexes ;
  dpc:realises dpc:full-text-search ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/search-intro> .

dpc:gcp-bigquery-sharing a dpc:Technology ;
  skos:prefLabel "BigQuery sharing"@en ;
  dcterms:description "Data exchange service where publishers list datasets, views, models and Pub/Sub topics for subscribers, who get linked read-only copies without data duplication."@en ;
  skos:altLabel "Analytics Hub"@en ;
