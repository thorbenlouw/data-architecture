  skos:inScheme dpc:capabilities ;
  skos:broader dpc:data-quality ;
  skos:related dpc:critical-data-elements ;
  skos:related dpc:governance-metrics ;
  skos:related dpc:data-certification ;
  skos:related dpc:data-catalogue ;
  skos:related dpc:data-slas ;
  dpc:dependsOn dpc:data-quality-rules ;
  skos:altLabel "DQ dashboards"@en ;
  skos:definition "Track quality results over time and report them by dataset, domain and quality dimension."@en .

dpc:data-reconciliation a skos:Concept ;
  skos:prefLabel "Data reconciliation"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:data-quality ;
  skos:related dpc:platform-migration ;
  skos:related dpc:critical-data-elements ;
  skos:related dpc:compliance-evidence ;
  skos:related dpc:idempotent-loading ;
  skos:related dpc:data-quality-rules ;
  skos:altLabel "control totals"@en ;
  skos:altLabel "source-to-target checks"@en ;
  skos:definition "Prove that data moved between systems is complete and correct using counts, totals and record matching."@en .

dpc:data-residency a skos:Concept ;
  skos:prefLabel "Data residency and sovereignty"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:governance ;
  skos:related dpc:cross-region-sharing ;
  skos:related dpc:cross-region-failover ;
  skos:related dpc:deployment-options ;
  skos:related dpc:hybrid-data-plane ;
  skos:related dpc:customer-managed-keys ;
  dpc:dependsOn dpc:data-classification ;
  skos:definition "Keep data and its processing in approved jurisdictions and prove that you have."@en .

dpc:data-retention a skos:Concept ;
  skos:prefLabel "Retention and disposal"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:governance ;
  skos:related dpc:storage-tiering ;
  skos:related dpc:immutable-backups ;
  skos:related dpc:row-level-updates ;
  skos:related dpc:table-maintenance ;
  skos:related dpc:records-of-processing ;
  dpc:dependsOn dpc:data-classification ;
  dpc:dependsOn dpc:row-level-updates ;
  skos:definition "Keep data for as long as required, then delete it reliably, including from history, snapshots and backups, with legal holds when needed."@en .

dpc:data-security-posture a skos:Concept ;
  skos:prefLabel "Data security posture management"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:security ;
  skos:related dpc:data-classification ;
  skos:related dpc:governance-metrics ;
  skos:related dpc:ai-system-discovery ;
  skos:related dpc:usage-metadata ;
  skos:related dpc:data-threat-detection ;
  dpc:dependsOn dpc:data-classification ;
  dpc:dependsOn dpc:metadata-harvesting ;
  skos:altLabel "DSPM"@en ;
  skos:definition "Find continuously where sensitive data lives, who can reach it and which configurations put it at risk."@en .

dpc:data-sharing a skos:Concept ;
  skos:prefLabel "Data sharing and collaboration"@en ;
  skos:inScheme dpc:capabilities ;
  skos:topConceptOf dpc:capabilities ;
  skos:related dpc:data-products ;
  skos:related dpc:data-usage-rights ;
  skos:related dpc:privacy-enhancing-technologies ;
  skos:related dpc:audit-logging ;
  skos:related dpc:managed-file-transfer ;
  dpc:dependsOn dpc:access-control ;
  skos:definition "Share data within and beyond the organisation safely, without unnecessary copies."@en .

dpc:data-skipping-indexes a skos:Concept ;
  skos:prefLabel "Indexes and data skipping"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:query-acceleration ;
  skos:related dpc:partitioning-clustering ;
  skos:related dpc:columnar-storage ;
  skos:related dpc:full-text-search ;
  skos:related dpc:low-latency-serving ;
  skos:related dpc:query-performance-analysis ;
  skos:altLabel "search optimisation"@en ;
  skos:altLabel "bloom filters"@en ;
  skos:altLabel "zone maps"@en ;
  skos:definition "Use indexes, statistics and filters to avoid scanning data that cannot match a query."@en .

dpc:data-slas a skos:Concept ;
  skos:prefLabel "Data service levels"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:data-products ;
  skos:related dpc:data-contracts ;
  skos:related dpc:data-quality-scorecards ;
  skos:related dpc:data-observability ;
  skos:related dpc:pipeline-monitoring ;
  skos:related dpc:data-issue-management ;
  dpc:dependsOn dpc:freshness-monitoring ;
  skos:altLabel "data SLOs"@en ;
  skos:altLabel "data SLAs"@en ;
  skos:definition "Set and track service levels for data products, such as freshness, availability and quality."@en .

dpc:data-subject-requests a skos:Concept ;
  skos:prefLabel "Data subject requests"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:privacy-management ;
  skos:related dpc:row-level-updates ;
  skos:related dpc:entity-resolution ;
  skos:related dpc:data-retention ;
  skos:related dpc:time-travel ;
  skos:related dpc:table-maintenance ;
  dpc:dependsOn dpc:data-classification ;
  dpc:dependsOn dpc:data-lineage ;
  dpc:dependsOn dpc:row-level-updates ;
  skos:altLabel "DSAR"@en ;
  skos:altLabel "right to be forgotten"@en ;
  skos:altLabel "right to erasure"@en ;
  skos:definition "Find, export or erase a person's data across the platform when they ask."@en .

dpc:data-testing a skos:Concept ;
  skos:prefLabel "Data pipeline testing"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:development-lifecycle ;
  skos:related dpc:data-quality-rules ;
  skos:related dpc:data-reconciliation ;
  skos:related dpc:transformation-as-code ;
  skos:related dpc:ci-cd ;
  skos:related dpc:data-contracts ;
  dpc:dependsOn dpc:test-data-management ;
  skos:altLabel "unit tests for SQL"@en ;
  skos:altLabel "data unit tests"@en ;
  skos:altLabel "regression testing"@en ;
  skos:altLabel "data diff"@en ;
  skos:altLabel "pipeline tests"@en ;
  skos:definition "Test transformation logic and data with unit, integration and regression tests before release."@en .

dpc:data-threat-detection a skos:Concept ;
  skos:prefLabel "Data threat detection"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:security ;
  skos:related dpc:audit-logging ;
  skos:related dpc:data-security-posture ;
  skos:related dpc:immutable-backups ;
  skos:related dpc:data-anomaly-detection ;
  skos:related dpc:data-loss-prevention ;
  dpc:dependsOn dpc:audit-logging ;
  skos:altLabel "insider risk"@en ;
  skos:altLabel "database activity monitoring"@en ;
  skos:altLabel "database firewall"@en ;
  skos:definition "Analyse data access behaviour to detect and respond to insider threats, ransomware and abnormal access."@en .

dpc:data-trust-indicators a skos:Concept ;
  skos:prefLabel "Data trust indicators"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:data-catalogue ;
  skos:broader dpc:analytics-bi ;
  skos:related dpc:data-certification ;
  skos:related dpc:data-issue-management ;
  skos:related dpc:data-quality-scorecards ;
  skos:related dpc:data-consumer-portal ;
  skos:related dpc:data-slas ;
  dpc:dependsOn dpc:freshness-monitoring ;
  dpc:dependsOn dpc:data-quality-rules ;
  dpc:dependsOn dpc:table-lineage ;
  skos:altLabel "trust signals"@en ;
  skos:altLabel "data health indicators"@en ;
  skos:altLabel "data quality warnings"@en ;
  skos:altLabel "health badges"@en ;
  skos:altLabel "reliability status"@en ;
  skos:definition "Show consumers, where they use data, whether a dataset, dashboard or answer is certified, fresh, passing its checks and free of open incidents."@en .

dpc:data-usage-rights a skos:Concept ;
  skos:prefLabel "Data licensing and usage rights"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:governance ;
  skos:related dpc:consent-management ;
  skos:related dpc:data-marketplace ;
  skos:related dpc:model-lineage ;
  skos:related dpc:external-data-sharing ;
  skos:related dpc:attribute-based-access ;
  dpc:dependsOn dpc:data-lineage ;
  skos:altLabel "data rights management"@en ;
  skos:definition "Record licence terms and permitted uses of datasets and check use against them, including for model training."@en .

dpc:data-vault a dpc:Pattern ;
  skos:prefLabel "Data Vault"@en ;
  dcterms:description "Model integrated history with hubs, links and satellites so new sources can be added without rework."@en ;
  skos:altLabel "Data Vault 2.0"@en ;
  skos:altLabel "raw vault"@en ;
  skos:altLabel "business vault"@en ;
  skos:altLabel "hubs, links and satellites"@en ;
  dpc:uses dpc:data-modelling ;
  dpc:uses dpc:sql-transformation ;
  dpc:uses dpc:transformation-as-code ;
  dpc:uses dpc:incremental-processing ;
  dpc:uses dpc:idempotent-loading ;
  dpc:uses dpc:temporal-data ;
  dpc:uses dpc:master-data-management ;
  dpc:uses dpc:data-lineage .

dpc:data-versioning a skos:Concept ;
  skos:prefLabel "Data versioning"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:storage ;
  skos:related dpc:backup-restore ;
  skos:related dpc:experiment-tracking ;
  skos:related dpc:model-lineage ;
  skos:related dpc:data-retention ;
  skos:related dpc:ci-cd ;
  skos:definition "Keep and reference past versions of data so you can reproduce results, compare changes or roll back."@en .

dpc:data-warehouse a dpc:Pattern ;
  skos:prefLabel "Data warehouse"@en ;
  dcterms:description "A central store of integrated, historical data, modelled for analysis and reporting."@en ;
  skos:altLabel "EDW"@en ;
  skos:altLabel "enterprise data warehouse"@en ;
  skos:altLabel "DWH"@en ;
  skos:altLabel "Inmon"@en ;
  dpc:uses dpc:sql-query-engine ;
  dpc:uses dpc:sql-transformation ;
  dpc:uses dpc:data-modelling ;
  dpc:uses dpc:columnar-storage ;
  dpc:uses dpc:batch-ingestion ;
  dpc:uses dpc:workload-isolation ;
  dpc:uses dpc:semantic-layer ;
  dpc:uses dpc:data-quality-rules ;
  dpc:uses dpc:managed-storage .

dpc:data-world a dpc:Technology ;
  skos:prefLabel "data.world"@en ;
  dcterms:description "Data catalogue and governance service built on a knowledge graph, which links technical assets to business concepts."@en ;
  dpc:realises dpc:data-catalogue ;
  dpc:realises dpc:knowledge-graphs ;
  dpc:realises dpc:business-glossary ;
  dpc:realises dpc:ai-context-layer ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://data.world/> .

dpc:data-writeback a skos:Concept ;
  skos:prefLabel "Data entry and write-back"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:analytics-bi ;
  skos:related dpc:reference-data-management ;
  skos:related dpc:data-applications ;
  skos:related dpc:enterprise-planning ;
  skos:related dpc:audit-logging ;
  skos:related dpc:spreadsheet-integration ;
  skos:altLabel "writeback"@en ;
  skos:altLabel "translytical"@en ;
  skos:altLabel "input tables"@en ;
  skos:altLabel "operational actions"@en ;
  skos:definition "Let users enter or correct data in analytics tools and write it back to governed tables with an audit trail."@en .

dpc:database-extraction a skos:Concept ;
  skos:prefLabel "Database extraction"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:batch-ingestion ;
  skos:related dpc:change-data-capture ;
  skos:related dpc:database-replication ;
  skos:related dpc:data-reconciliation ;
  skos:related dpc:mainframe-integration ;
  skos:altLabel "JDBC extract"@en ;
  skos:altLabel "high-watermark extraction"@en ;
  skos:definition "Extract full or incremental snapshots from relational and NoSQL databases using queries or bulk export."@en .

dpc:database-migration a skos:Concept ;
  skos:prefLabel "Database migration"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:platform-migration ;
  skos:related dpc:database-replication ;
  skos:related dpc:schema-change-management ;
  skos:related dpc:data-reconciliation ;
  skos:related dpc:bulk-data-transfer ;
  skos:related dpc:code-translation ;
  dpc:dependsOn dpc:change-data-capture ;
  skos:altLabel "schema conversion"@en ;
  skos:definition "Move databases to new engines or platforms, converting schemas and keeping data in sync until cut-over."@en .

dpc:database-replication a skos:Concept ;
  skos:prefLabel "Database replication and mirroring"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:ingestion-integration ;
  skos:related dpc:operational-database ;
  skos:related dpc:database-extraction ;
  skos:related dpc:freshness-monitoring ;
  skos:related dpc:database-migration ;
  dpc:dependsOn dpc:change-data-capture ;
  skos:altLabel "zero-ETL"@en ;
  skos:altLabel "mirroring"@en ;
  skos:altLabel "managed replication"@en ;
  skos:definition "Replicate operational databases continuously into the analytical platform without building pipelines."@en .

dpc:databricks-abac a dpc:Technology ;
  skos:prefLabel "Unity Catalog attribute-based access control (ABAC)"@en ;
  dcterms:description "Policies attached at catalogue, schema or table level that use governed tags and user attributes to apply row filters, column masks and dynamic grants automatically."@en ;
  dpc:realises dpc:attribute-based-access ;
  dpc:realises dpc:row-level-security ;
  dpc:realises dpc:column-masking ;
  dpc:realises dpc:data-policy-management ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/data-governance/unity-catalog/abac/> .

dpc:databricks-agent-bricks a dpc:Technology ;
  skos:prefLabel "Agent Bricks"@en ;
  dcterms:description "Databricks' platform for developing agents. It brings together agent hosting, sandboxed code execution, memory, MCP tools, retrieval, tracing, evaluation and governed model access."@en ;
  dpc:realises dpc:ai-agents ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/generative-ai/agent-bricks/> .

dpc:databricks-agent-evaluation a dpc:Technology ;
  skos:prefLabel "Databricks Agent Evaluation (MLflow GenAI evaluation)"@en ;
  dcterms:description "Evaluates agents and LLM applications against datasets, using built-in and custom scorers, LLM judges and human feedback, and also monitors production traces."@en ;
  skos:altLabel "Mosaic AI Agent Evaluation"@en ;
  dpc:realises dpc:genai-evaluation ;
  dpc:realises dpc:data-labelling ;
  dpc:realises dpc:training-dataset-management ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/mlflow/> .

dpc:databricks-agent-runtime a dpc:Technology ;
  skos:prefLabel "Databricks Agent Runtime and Agent Bricks CLI"@en ;
  dcterms:description "Serverless hosting for code-based agents on Databricks Apps, with durable run state, an authenticated endpoint, a service-principal identity and MLflow tracing, deployed with the agentbricks CLI."@en ;
  dpc:realises dpc:agent-runtime ;
  dpc:realises dpc:agent-memory ;
  dpc:realises dpc:agent-identity ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/agents/deploy/agent-runtime> .

dpc:databricks-agentic-code-converter a dpc:Technology ;
  skos:prefLabel "Databricks agentic code converter"@en ;
  dcterms:description "A Genie Code-based migration project that converts T-SQL, Snowflake, Redshift, Oracle, BigQuery and Teradata SQL into Databricks SQL or DataFrame notebooks."@en ;
  dpc:realises dpc:code-translation ;
  dpc:realises dpc:ai-assisted-development ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/migration/agentic-code-converter> .

dpc:databricks-ai-bi-dashboards a dpc:Technology ;
  skos:prefLabel "Databricks AI/BI dashboards"@en ;
  dcterms:description "Built-in dashboards with AI-assisted authoring, cross-filtering and drill-through. They can be shared at account level, sent on schedules by email or Slack, and embedded in external applications."@en ;
  skos:altLabel "Lakeview dashboards"@en ;
  dpc:realises dpc:dashboards-reports ;
  dpc:realises dpc:embedded-analytics ;
  dpc:realises dpc:data-alerting ;
  dpc:realises dpc:dashboards-as-code ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/dashboards/> .

dpc:databricks-ai-functions a dpc:Technology ;
  skos:prefLabel "Databricks AI Functions"@en ;
  dcterms:description "SQL and Python functions that call models over table data. They include ai_query, ai_extract, ai_classify, ai_summarize, ai_translate, ai_mask, ai_forecast and ai_similarity, with ai_search, ai_prep_search and ai_transcribe in Beta."@en ;
  dpc:realises dpc:ai-functions ;
  dpc:realises dpc:batch-inference ;
  dpc:realises dpc:deidentification ;
  dpc:realises dpc:audio-video-processing ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/large-language-models/ai-functions> .

dpc:databricks-ai-parse-document a dpc:Technology ;
  skos:prefLabel "Databricks ai_parse_document"@en ;
  dcterms:description "An AI Function that extracts text, tables and layout elements from PDFs, images and office documents stored in volumes, returning structured output."@en ;
  dpc:realises dpc:document-processing ;
  dpc:realises dpc:unstructured-ingestion ;
  dpc:realises dpc:retrieval-pipelines ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/large-language-models/ai-functions> .

dpc:databricks-ai-runtime a dpc:Technology ;
  skos:prefLabel "Databricks AI Runtime"@en ;
  dcterms:description "Serverless GPU compute for deep learning, used to train and fine-tune models on one or many GPUs with PyTorch DDP and FSDP, DeepSpeed or Ray."@en ;
  skos:altLabel "Serverless GPU compute"@en ;
  dpc:realises dpc:gpu-compute ;
  dpc:realises dpc:distributed-training ;
  dpc:realises dpc:model-customisation ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/machine-learning/ai-runtime/> .

dpc:databricks-ai-search a dpc:Technology ;
  skos:prefLabel "Databricks AI Search"@en ;
  dcterms:description "A managed vector and full-text search service. Delta Sync indexes stay in step with source tables and can compute embeddings, and hybrid retrieval is supported."@en ;
  skos:altLabel "Mosaic AI Vector Search"@en ;
  skos:altLabel "Databricks Vector Search"@en ;
  dpc:realises dpc:vector-search ;
  dpc:realises dpc:retrieval-pipelines ;
  dpc:realises dpc:full-text-search ;
  dpc:realises dpc:embedding-generation ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/vector-search/vector-search> .

dpc:databricks-apps a dpc:Technology ;
  skos:prefLabel "Databricks Apps"@en ;
  dcterms:description "Serverless hosting for Python and Node.js web applications (for example Streamlit, Dash, Gradio and React) that run inside the workspace with Unity Catalog, SQL warehouse and OAuth integration."@en ;
  dpc:realises dpc:data-applications ;
  dpc:realises dpc:container-services ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/dev-tools/databricks-apps/> .

dpc:databricks-auto-loader a dpc:Technology ;
  skos:prefLabel "Databricks Auto Loader"@en ;
  dcterms:description "A Structured Streaming source (cloudFiles) that discovers new files in cloud storage and processes each one exactly once, with schema inference, schema evolution and a rescued-data column."@en ;
  skos:altLabel "cloudFiles"@en ;
  dpc:realises dpc:file-ingestion ;
  dpc:realises dpc:incremental-processing ;
  dpc:realises dpc:schema-evolution ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/ingestion/cloud-object-storage/auto-loader/> .

dpc:databricks-automatic-identity-management a dpc:Technology ;
  skos:prefLabel "Databricks automatic identity management"@en ;
  dcterms:description "Synchronises users, groups and service principals from Microsoft Entra ID or Okta on demand, without configuring SCIM provisioning. It works alongside SSO, OAuth and service principals."@en ;
  dpc:realises dpc:identity-authentication ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/may> .

dpc:databricks-automl a dpc:Technology ;
  skos:prefLabel "Databricks AutoML"@en ;
  dcterms:description "Generates baseline classification, regression and forecasting models through a UI or Python API, and produces editable notebooks for each trial."@en ;
  dpc:realises dpc:automl ;
  dpc:realises dpc:hyperparameter-tuning ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/machine-learning/automl/> .

dpc:databricks-budgets a dpc:Technology ;
  skos:prefLabel "Databricks budgets"@en ;
  dcterms:description "Account-level spend tracking at list price, filtered by workspace, resource type and tags. You set monthly thresholds with email alerts and, for Unity Gateway, optional per-user blocking."@en ;
  dpc:realises dpc:spend-controls ;
  dpc:realises dpc:cost-attribution ;
  dpc:realises dpc:ai-spend-controls ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/admin/account-settings/budgets> .

dpc:databricks-catalog-explorer a dpc:Technology ;
  skos:prefLabel "Databricks Catalog Explorer"@en ;
  dcterms:description "The workspace UI for browsing and managing Unity Catalog assets. It shows schemas, permissions, lineage, popularity, table health indicators and AI-generated comments."@en ;
  skos:altLabel "Data Explorer"@en ;
  dpc:realises dpc:data-catalogue ;
  dpc:realises dpc:ai-generated-documentation ;
  dpc:realises dpc:usage-metadata ;
  dpc:realises dpc:metadata-harvesting ;
  dpc:realises dpc:data-trust-indicators ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/data-governance/unity-catalog/> .

dpc:databricks-catalog-federation a dpc:Technology ;
  skos:prefLabel "Databricks catalog federation"@en ;
  dcterms:description "Mounts external catalogues such as Hive metastore, AWS Glue, Snowflake Horizon and Salesforce Data 360 as foreign catalogs, read from object storage under Unity Catalog governance."@en ;
  dpc:realises dpc:catalogue-federation ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:metadata-interoperability ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/query-federation/> .

dpc:databricks-change-data-feed a dpc:Technology ;
  skos:prefLabel "Databricks change data feed"@en ;
  dcterms:description "Records row-level inserts, updates and deletes on Delta tables so downstream jobs and streams can read only the changes."@en ;
  skos:altLabel "CDF"@en ;
  dpc:realises dpc:change-feeds ;
  dpc:realises dpc:incremental-processing ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/september> .

dpc:databricks-classic-compute a dpc:Technology ;
  skos:prefLabel "Databricks classic compute (Databricks Runtime clusters)"@en ;
  dcterms:description "All-purpose and job clusters, plus instance pools, running Databricks Runtime in the customer's cloud account. You choose instance types, autoscaling and access mode."@en ;
  skos:altLabel "all-purpose compute"@en ;
  skos:altLabel "jobs compute"@en ;
  skos:altLabel "Databricks Runtime"@en ;
  skos:altLabel "DBR"@en ;
  dpc:realises dpc:provisioned-compute ;
  dpc:realises dpc:distributed-processing ;
  dpc:realises dpc:dataframe-apis ;
  dpc:realises dpc:distributed-training ;
  dpc:realises dpc:hybrid-data-plane ;
  dpc:realises dpc:runtime-management ;
  dpc:realises dpc:interruptible-compute ;
  dpc:realises dpc:configuration-guardrails ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/compute/> .

dpc:databricks-clean-rooms a dpc:Technology ;
  skos:prefLabel "Databricks Clean Rooms"@en ;
  dcterms:description "Isolated serverless environments where up to ten organisations share data through OpenSharing and run notebooks that every party has approved. No party sees the others' underlying data."@en ;
  dpc:realises dpc:data-clean-rooms ;
  dpc:realises dpc:privacy-enhancing-technologies ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/clean-rooms/> .

dpc:databricks-compliance-security-profile a dpc:Technology ;
  skos:prefLabel "Databricks compliance security profile"@en ;
  dcterms:description "A workspace setting that applies a hardened, FIPS-validated compute image, enhanced security monitoring and encrypted egress, required for HIPAA, PCI-DSS, FedRAMP and similar regulated data."@en ;
  dpc:realises dpc:compliance-evidence ;
  dpc:realises dpc:data-residency ;
  dpc:realises dpc:configuration-guardrails ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/security/privacy/security-profile> .

dpc:databricks-connect a dpc:Technology ;
  skos:prefLabel "Databricks Connect"@en ;
  dcterms:description "A client library built on Spark Connect. Python, Scala and R DataFrame code written in an IDE or application runs on remote Databricks compute, including serverless."@en ;
  dpc:realises dpc:local-development ;
  dpc:realises dpc:dataframe-apis ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/dev-tools/databricks-connect/> .

dpc:databricks-customer-managed-keys a dpc:Technology ;
  skos:prefLabel "Databricks customer-managed keys"@en ;
  dcterms:description "Customer-held cloud KMS keys that encrypt control-plane data (notebooks, secrets, queries), workspace storage and, at catalogue level, Unity Catalog managed data."@en ;
  dpc:realises dpc:customer-managed-keys ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/security/keys/> .

dpc:databricks-data-classification a dpc:Technology ;
  skos:prefLabel "Databricks Data Classification"@en ;
  dcterms:description "A serverless agent that scans Unity Catalog tables incrementally, detects sensitive data such as PII and payment-card data, and tags the columns."@en ;
  dpc:realises dpc:data-classification ;
  dpc:realises dpc:data-security-posture ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/data-governance/unity-catalog/data-classification> .

dpc:databricks-data-profiling a dpc:Technology ;
  skos:prefLabel "Databricks data profiling"@en ;
  dcterms:description "Computes profile and drift metrics for a table over time as snapshot, time-series or inference profiles, and stores them in Delta tables with a generated dashboard."@en ;
  skos:altLabel "Lakehouse Monitoring"@en ;
  skos:altLabel "Databricks Lakehouse Monitoring"@en ;
  dpc:realises dpc:data-profiling ;
  dpc:realises dpc:drift-detection ;
  dpc:realises dpc:model-performance-monitoring ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/data-quality-monitoring> .

dpc:databricks-declarative-automation-bundles a dpc:Technology ;
  skos:prefLabel "Databricks Declarative Automation Bundles"@en ;
  dcterms:description "A Databricks CLI feature that defines jobs, pipelines, dashboards, apps, serving endpoints, AI Search, Lakebase and other resources in YAML with per-target settings. The CLI then validates, plans and deploys them from CI/CD."@en ;
  skos:altLabel "DABs"@en ;
  skos:altLabel "Databricks Asset Bundles"@en ;
  dpc:realises dpc:ci-cd ;
  dpc:realises dpc:environment-promotion ;
  dpc:realises dpc:infrastructure-as-code ;
  dpc:realises dpc:ephemeral-environments ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/dev-tools/bundles/> .

dpc:databricks-delta-lake a dpc:Technology ;
  skos:prefLabel "Delta Lake on Databricks"@en ;
  dcterms:description "Databricks' managed implementation of Delta Lake tables, with ACID commits, MERGE, UPDATE and DELETE, schema enforcement, time travel, deletion vectors and type widening."@en ;
  dpc:realises dpc:open-table-formats ;
  dpc:realises dpc:acid-transactions ;
  dpc:realises dpc:row-level-updates ;
  dpc:realises dpc:time-travel ;
  dpc:realises dpc:schema-evolution ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/delta/> .

dpc:databricks-discover a dpc:Technology ;
  skos:prefLabel "Databricks Discover"@en ;
  dcterms:description "A curated browsing page that groups governed tables, dashboards, notebooks and Genie Agents into business domains and subdomains, with highlighted assets chosen by admins and AI recommendations."@en ;
  dpc:realises dpc:data-catalogue ;
  dpc:realises dpc:data-certification ;
  dpc:realises dpc:data-domains ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/october> .

dpc:databricks-dqm-anomaly-detection a dpc:Technology ;
  skos:prefLabel "Databricks data quality monitoring anomaly detection"@en ;
  dcterms:description "Monitors every table in a schema with one setting. It learns each table's update and volume patterns, flags late or incomplete tables, and suggests root causes using lineage."@en ;
  dpc:realises dpc:data-anomaly-detection ;
  dpc:realises dpc:freshness-monitoring ;
  dpc:realises dpc:data-issue-management ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/data-governance/unity-catalog/data-quality-monitoring/anomaly-detection/> .

dpc:databricks-excel-add-in a dpc:Technology ;
  skos:prefLabel "Databricks Excel Add-in"@en ;
  dcterms:description "A Microsoft Excel add-in for querying governed Databricks tables and metric views from a workbook."@en ;
  dpc:realises dpc:spreadsheet-integration ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/september> .

dpc:databricks-feature-store a dpc:Technology ;
  skos:prefLabel "Databricks Feature Store"@en ;
  dcterms:description "A feature registry in Unity Catalog that stores features in primary-keyed Delta tables, with point-in-time training set creation, automatic lookup at inference and lineage to models."@en ;
  skos:altLabel "Feature Engineering in Unity Catalog"@en ;
  dpc:realises dpc:feature-store ;
  dpc:realises dpc:offline-feature-store ;
  dpc:realises dpc:point-in-time-joins ;
  dpc:realises dpc:feature-engineering ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/machine-learning/feature-store/> .

dpc:databricks-feature-views a dpc:Technology ;
  skos:prefLabel "Databricks Feature Views"@en ;
  dcterms:description "Declarative feature definitions, including time-windowed aggregations over batch, streaming and request-time data, for which Databricks builds and runs the pipelines."@en ;
  dpc:realises dpc:feature-engineering ;
  dpc:realises dpc:point-in-time-joins ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/october> .

dpc:databricks-foundation-model-apis a dpc:Technology ;
  skos:prefLabel "Databricks Foundation Model APIs"@en ;
  dcterms:description "Databricks-hosted proprietary and open language and embedding models, available pay-per-token or with provisioned throughput. They are exposed as governed model services in the system.ai schema."@en ;
  dpc:realises dpc:foundation-model-access ;
  dpc:realises dpc:embedding-generation ;
  dpc:realises dpc:reserved-capacity ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/machine-learning/model-serving/> .

dpc:databricks-free-edition a dpc:Technology ;
  skos:prefLabel "Databricks Free Edition"@en ;
  dcterms:description "A no-cost, serverless-only, quota-limited Databricks environment for learning and experiments. It includes notebooks, SQL, Lakeflow, dashboards, Genie, Genie Code and Lakebase."@en ;
  dpc:realises dpc:serverless-compute ;
  dpc:realises dpc:notebooks ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/getting-started/free-edition> .

dpc:databricks-genie-agents a dpc:Technology ;
  skos:prefLabel "Genie Agents"@en ;
  dcterms:description "Domain-specific chat interfaces that analysts curate with tables, metric views, example SQL and instructions. They answer business questions in natural language with SQL, tables and charts."@en ;
  skos:altLabel "Genie spaces"@en ;
  skos:altLabel "AI/BI Genie"@en ;
  dpc:realises dpc:conversational-analytics ;
  dpc:realises dpc:ai-context-layer ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/genie-agents/> .

dpc:databricks-genie-code a dpc:Technology ;
  skos:prefLabel "Genie Code"@en ;
  dcterms:description "An AI coding and data agent in notebooks, the SQL editor, the pipelines editor, dashboards and MLflow. It plans, writes and runs code, fixes errors and builds pipelines and dashboards, using Unity Catalog context and the user's permissions."@en ;
  skos:altLabel "Databricks Assistant"@en ;
  dpc:realises dpc:ai-assisted-development ;
  dpc:realises dpc:data-engineering-agents ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/genie-code/> .

dpc:databricks-genie-one a dpc:Technology ;
  skos:prefLabel "Genie One"@en ;
  dcterms:description "A simplified interface for business users that combines chat across governed data, dashboards and apps in one place, available in the browser, desktop, Excel and Google Sheets."@en ;
  skos:altLabel "Databricks One"@en ;
  dpc:realises dpc:conversational-analytics ;
  dpc:realises dpc:dashboards-reports ;
  dpc:realises dpc:spreadsheet-integration ;
  dpc:realises dpc:data-consumer-portal ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/gcp/en/genie-one/> .

dpc:databricks-git-folders a dpc:Technology ;
  skos:prefLabel "Databricks Git folders"@en ;
  dcterms:description "Workspace folders backed by a Git repository. Users clone, branch, commit, merge and resolve conflicts from the UI, the API or Git CLI commands."@en ;
  skos:altLabel "Repos"@en ;
  skos:altLabel "Databricks Repos"@en ;
  dpc:realises dpc:version-control ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/repos/> .

dpc:databricks-governance-hub a dpc:Technology ;
  skos:prefLabel "Databricks Governance Hub"@en ;
  dcterms:description "An account-level console that brings together data health and governance coverage, tag usage, AI usage and spend, and cost drivers, with recommended actions."@en ;
  dpc:realises dpc:data-security-posture ;
  dpc:realises dpc:ai-governance ;
  dpc:realises dpc:cost-management ;
  dpc:realises dpc:governance-metrics ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/admin/governance-hub/> .

dpc:databricks-governed-tags a dpc:Technology ;
  skos:prefLabel "Databricks governed tags"@en ;
  dcterms:description "Account-level tag definitions with controlled values and assignment permissions, applied to Unity Catalog objects and workspace assets and used by ABAC, classification and cost reporting."@en ;
  dpc:realises dpc:data-classification ;
  dpc:realises dpc:active-metadata ;
  dpc:realises dpc:data-policy-management ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/april> .

dpc:databricks-iceberg-reads-uniform a dpc:Technology ;
  skos:prefLabel "Databricks Iceberg reads (UniForm)"@en ;
  dcterms:description "Generates Iceberg metadata asynchronously for Delta tables so that Iceberg clients can read them without copying the data."@en ;
  skos:altLabel "Delta Lake Universal Format (UniForm)"@en ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:table-format-conversion ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/delta/uniform> .

dpc:databricks-iceberg-rest-catalog a dpc:Technology ;
  skos:prefLabel "Unity Catalog Iceberg REST Catalog API"@en ;
  dcterms:description "An Iceberg REST catalogue endpoint with credential vending. Spark, Flink, Trino, Snowflake and other engines can use it to read and write Unity Catalog tables."@en ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:metadata-interoperability ;
  dpc:realises dpc:credential-vending ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/iceberg/> .

dpc:databricks-inference-tables a dpc:Technology ;
  skos:prefLabel "Databricks inference tables"@en ;
  dcterms:description "Logs requests and responses from serving endpoints, foundation model calls and agents to Unity Catalog Delta tables for monitoring, audit and retraining."@en ;
  dpc:realises dpc:inference-logging ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/machine-learning/model-serving/inference-tables> .

dpc:databricks-knowledge-assistant-supervisor-agent a dpc:Technology ;
  skos:prefLabel "Agent Bricks Knowledge Assistant and Supervisor Agent"@en ;
  dcterms:description "No-code agents. Knowledge Assistant answers questions over documents with citations, and Supervisor Agent coordinates Genie Agents, tables, AI Search indexes, MCP servers and other agents."@en ;
  skos:altLabel "Multi-Agent Supervisor"@en ;
  dpc:realises dpc:retrieval-augmented-generation ;
  dpc:realises dpc:ai-agents ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/gcp/en/agents/legacy/> .

dpc:databricks-lakebase a dpc:Technology ;
  skos:prefLabel "Lakebase"@en ;
  dcterms:description "Fully managed Postgres in the Databricks platform. Compute is separate from storage, and it offers autoscaling, scale-to-zero, copy-on-write branching, instant point-in-time restore and read replicas."@en ;
  skos:altLabel "Lakebase Postgres"@en ;
  skos:altLabel "Lakebase Autoscaling"@en ;
  dpc:realises dpc:operational-database ;
  dpc:realises dpc:low-latency-serving ;
  dpc:realises dpc:data-branching ;
  dpc:realises dpc:read-optimised-views ;
  dpc:realises dpc:backup-restore ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/oltp/about> .

dpc:databricks-lakebridge a dpc:Technology ;
  skos:prefLabel "Lakebridge"@en ;
  dcterms:description "A Databricks Labs migration toolkit. It assesses legacy warehouse and ETL estates, transpiles their SQL and ETL code to Databricks, and reconciles the migrated data against the source."@en ;
  skos:altLabel "Remorph"@en ;
  dpc:realises dpc:platform-migration ;
  dpc:realises dpc:data-reconciliation ;
  dpc:realises dpc:code-translation ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://databrickslabs.github.io/lakebridge/> .

dpc:databricks-lakeflow-connect a dpc:Technology ;
  skos:prefLabel "Lakeflow Connect"@en ;
  dcterms:description "Managed connectors that ingest data incrementally from SaaS applications, databases (including change data capture), file sources and message buses into Unity Catalog tables, running on serverless Lakeflow pipelines."@en ;
  dpc:realises dpc:saas-connectors ;
  dpc:realises dpc:change-data-capture ;
  dpc:realises dpc:database-extraction ;
  dpc:realises dpc:unstructured-ingestion ;
  dpc:realises dpc:custom-connectors ;
  dpc:realises dpc:database-replication ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/ingestion/lakeflow-connect/> .

dpc:databricks-lakeflow-designer a dpc:Technology ;
  skos:prefLabel "Lakeflow Designer"@en ;
  dcterms:description "A visual, no-code canvas where analysts build data preparation flows from operators or natural-language prompts. The flows are backed by generated code governed in Unity Catalog."@en ;
  dpc:realises dpc:low-code-transformation ;
  dpc:realises dpc:data-preparation ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/designer/> .

dpc:databricks-lakeflow-jobs a dpc:Technology ;
  skos:prefLabel "Lakeflow Jobs"@en ;
  dcterms:description "Built-in orchestrator that runs dependency graphs of notebooks, pipelines, SQL, dbt and other tasks on schedules or on file-arrival, table-update and continuous triggers, with retries and loops."@en ;
  skos:altLabel "Databricks Jobs"@en ;
  skos:altLabel "Databricks Workflows"@en ;
  dpc:realises dpc:workflow-orchestration ;
  dpc:realises dpc:event-driven-triggering ;
  dpc:realises dpc:pipeline-monitoring ;
  dpc:realises dpc:backfill-replay ;
  dpc:realises dpc:asset-based-orchestration ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/jobs/> .

dpc:databricks-lakeflow-pipelines a dpc:Technology ;
  skos:prefLabel "Lakeflow pipelines"@en ;
  dcterms:description "A declarative framework in which you define streaming tables, materialised views and flows in SQL or Python. The platform then works out dependencies, incremental refresh, retries and infrastructure."@en ;
  skos:altLabel "DLT"@en ;
  skos:altLabel "Delta Live Tables"@en ;
  skos:altLabel "Lakeflow Declarative Pipelines"@en ;
  skos:altLabel "Lakeflow Spark Declarative Pipelines"@en ;
  dpc:realises dpc:declarative-pipelines ;
  dpc:realises dpc:incremental-processing ;
  dpc:realises dpc:materialised-views ;
  dpc:realises dpc:streaming-sql ;
  dpc:realises dpc:streaming-inference ;
  dpc:realises dpc:read-optimised-views ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/ldp/where-is-dlt> .

dpc:databricks-lakeguard a dpc:Technology ;
  skos:prefLabel "Lakeguard"@en ;
  dcterms:description "Isolation technology that sandboxes each user's code and UDFs away from the Spark engine and from other users, so shared compute can enforce Unity Catalog row filters and column masks."@en ;
  dpc:realises dpc:compute-user-isolation ;
  dpc:realises dpc:row-level-security ;
  dpc:realises dpc:column-masking ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/compute/lakeguard> .

dpc:databricks-lakehouse-federation a dpc:Technology ;
  skos:prefLabel "Lakehouse Federation (query federation)"@en ;
  dcterms:description "Read-only queries against external databases such as PostgreSQL, Oracle, SQL Server, Snowflake, BigQuery, Redshift and Teradata through Unity Catalog foreign catalogs, with query pushdown."@en ;
  dpc:realises dpc:query-federation ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/query-federation/> .

dpc:databricks-lakehouse-real-time a dpc:Technology ;
  skos:prefLabel "Databricks Lakehouse Real-Time"@en ;
  dcterms:description "A serverless SQL warehouse type tuned for sub-second reads of Unity Catalog tables by many concurrent users and applications."@en ;
  dpc:realises dpc:real-time-analytics ;
  dpc:realises dpc:low-latency-serving ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/june> .

dpc:databricks-liquid-clustering a dpc:Technology ;
  skos:prefLabel "Databricks liquid clustering"@en ;
  dcterms:description "A data layout method that clusters table files by key columns you can change at any time, replacing partitioning and Z-ordering. With CLUSTER BY AUTO, Databricks chooses the keys from query history."@en ;
  dpc:realises dpc:partitioning-clustering ;
  dpc:realises dpc:data-skipping-indexes ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/delta/clustering> .

dpc:databricks-managed-disaster-recovery a dpc:Technology ;
  skos:prefLabel "Databricks managed disaster recovery"@en ;
  dcterms:description "Replicates Unity Catalog metadata, managed table data and workspace assets to a secondary region, behind a stable URL that survives failover."@en ;
  dpc:realises dpc:cross-region-failover ;
  dpc:realises dpc:backup-restore ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/june> .

dpc:databricks-managed-iceberg-tables a dpc:Technology ;
  skos:prefLabel "Unity Catalog managed Iceberg tables"@en ;
  dcterms:description "Apache Iceberg tables (v1 to v3) that Unity Catalog manages, with compaction, snapshot expiry and liquid clustering. Databricks and external engines can read and write them through the Iceberg REST catalogue."@en ;
  dpc:realises dpc:open-table-formats ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:table-maintenance ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/iceberg/> .

dpc:databricks-managed-mcp-servers a dpc:Technology ;
  skos:prefLabel "Databricks managed MCP servers"@en ;
  dcterms:description "Hosted Model Context Protocol servers that expose Unity Catalog functions, AI Search indexes, Genie Agents and Genie One to agents as tools. External MCP servers can also be registered as Unity Catalog MCP services."@en ;
  dpc:realises dpc:agent-tool-access ;
  dpc:realises dpc:agent-registry ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/september> .

dpc:databricks-managed-mlflow a dpc:Technology ;
  skos:prefLabel "Managed MLflow on Databricks"@en ;
  dcterms:description "MLflow 3 hosted by Databricks, with experiment and run tracking, logged models, prompt management and deployment jobs, all integrated with Unity Catalog permissions and lineage."@en ;
  dpc:realises dpc:experiment-tracking ;
  dpc:realises dpc:prompt-management ;
  dpc:realises dpc:ml-cicd ;
  dpc:realises dpc:model-lineage ;
  dpc:realises dpc:model-explainability ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/mlflow/> .

dpc:databricks-marketplace a dpc:Technology ;
  skos:prefLabel "Databricks Marketplace"@en ;
  dcterms:description "An exchange for publishing and finding datasets, AI models, notebooks, apps and MCP servers, either publicly or through private exchanges, delivered with OpenSharing."@en ;
  dpc:realises dpc:data-marketplace ;
  dpc:realises dpc:application-sharing ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/marketplace/> .

dpc:databricks-metric-views a dpc:Technology ;
  skos:prefLabel "Unity Catalog metric views"@en ;
  dcterms:description "YAML- or SQL-defined semantic objects that keep measures apart from dimensions. They are registered in Unity Catalog and queried from SQL, dashboards, Genie and external BI tools."@en ;
  dpc:realises dpc:semantic-layer ;
  dpc:realises dpc:metric-definitions ;
  dpc:realises dpc:materialised-views ;
  dpc:realises dpc:ai-context-layer ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/metric-views/> .

dpc:databricks-mlflow-tracing a dpc:Technology ;
  skos:prefLabel "MLflow Tracing on Databricks"@en ;
  dcterms:description "Records each step of agent and LLM calls, including inputs, outputs, latency, tokens and feedback, and stores the traces in Unity Catalog tables that can be queried with SQL."@en ;
  dpc:realises dpc:genai-observability ;
  dpc:realises dpc:inference-logging ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/july> .

dpc:databricks-model-serving a dpc:Technology ;
  skos:prefLabel "Databricks Model Serving"@en ;
  dcterms:description "Serverless CPU and GPU endpoints for serving custom MLflow models, Databricks-hosted foundation models and external models in real time, with traffic splitting between model versions."@en ;
  skos:altLabel "Mosaic AI Model Serving"@en ;
  dpc:realises dpc:real-time-inference ;
  dpc:realises dpc:canary-ab-testing ;
  dpc:realises dpc:gpu-compute ;
  dpc:realises dpc:generative-model-serving ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/machine-learning/model-serving/> .

dpc:databricks-models-in-unity-catalog a dpc:Technology ;
  skos:prefLabel "Models in Unity Catalog"@en ;
  dcterms:description "The MLflow model registry hosted in Unity Catalog, with versions, aliases, permissions, tags and lineage to training data and features shared across workspaces."@en ;
  dpc:realises dpc:model-registry ;
  dpc:realises dpc:model-governance ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/mlflow/> .

dpc:databricks-notebooks a dpc:Technology ;
  skos:prefLabel "Databricks notebooks"@en ;
  dcterms:description "Collaborative notebooks with Python, SQL, Scala and R cells, comments, version history, widgets and visualisations that can be scheduled as jobs."@en ;
  dpc:realises dpc:notebooks ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/notebooks/> .

dpc:databricks-online-feature-store a dpc:Technology ;
  skos:prefLabel "Databricks Online Feature Store"@en ;
  dcterms:description "A Lakebase-backed store that publishes feature tables for millisecond lookups by Model Serving endpoints and feature serving endpoints."@en ;
  dpc:realises dpc:online-feature-store ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/machine-learning/feature-store/online-feature-store> .

dpc:databricks-opensharing a dpc:Technology ;
  skos:prefLabel "Databricks OpenSharing"@en ;
  dcterms:description "Live sharing of tables, views, materialised views, metric views, volumes, models and notebooks with other Databricks accounts, or tabular data with any client through an open protocol, without copying."@en ;
  skos:altLabel "Delta Sharing"@en ;
  dpc:realises dpc:external-data-sharing ;
  dpc:realises dpc:internal-data-sharing ;
  dpc:realises dpc:cross-region-sharing ;
  dpc:realises dpc:open-protocol-sharing ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/delta-sharing/> .

dpc:databricks-photon a dpc:Technology ;
  skos:prefLabel "Databricks Photon"@en ;
  dcterms:description "Databricks' native C++ vectorised execution engine. It runs Spark SQL and DataFrame operations on columnar batches and falls back to Spark for operations it does not support."@en ;
  skos:altLabel "Photon engine"@en ;
  dpc:realises dpc:sql-query-engine ;
  dpc:realises dpc:native-execution-acceleration ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/compute/photon> .

dpc:databricks-pipeline-expectations a dpc:Technology ;
  skos:prefLabel "Lakeflow pipelines expectations"@en ;
  dcterms:description "Declarative data quality constraints on pipeline datasets. For each failing record you choose to warn, drop it or fail the update, and the results are recorded in the pipeline event log."@en ;
  dpc:realises dpc:data-quality-rules ;
  dpc:realises dpc:bad-data-quarantine ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/ldp/> .

dpc:databricks-predictive-optimization a dpc:Technology ;
  skos:prefLabel "Databricks predictive optimization"@en ;
  dcterms:description "Runs OPTIMIZE, VACUUM and ANALYZE automatically on Unity Catalog managed tables and chooses liquid clustering keys, based on how each table is used."@en ;
  dpc:realises dpc:table-maintenance ;
  dpc:realises dpc:cost-optimisation ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/optimizations/predictive-optimization> .

dpc:databricks-private-link a dpc:Technology ;
  skos:prefLabel "Private Link for Databricks"@en ;
  dcterms:description "AWS PrivateLink, Azure Private Link and Private Service Connect connectivity for front-end access, classic compute to the control plane, and inbound access to serverless services such as Lakebase and Zerobus Ingest."@en ;
  dpc:realises dpc:network-security ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/security/network/> .

dpc:databricks-secrets-in-unity-catalog a dpc:Technology ;
  skos:prefLabel "Secrets in Unity Catalog"@en ;
  dcterms:description "Credentials stored as governed Unity Catalog securables under a catalog.schema.secret name, with grants and audit."@en ;
  dpc:realises dpc:secrets-management ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/august> .

dpc:databricks-serverless-compute a dpc:Technology ;
  skos:prefLabel "Databricks serverless compute"@en ;
  dcterms:description "Databricks-managed, versionless compute for notebooks, jobs and pipelines. It starts quickly, scales automatically and is billed in DBUs per use."@en ;
  dpc:realises dpc:serverless-compute ;
  dpc:realises dpc:elastic-scaling ;
  dpc:realises dpc:decoupled-storage-compute ;
  dpc:realises dpc:runtime-management ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/compute/serverless/> .

dpc:databricks-serverless-egress-control a dpc:Technology ;
  skos:prefLabel "Databricks serverless egress control"@en ;
  dcterms:description "Account-level network policies that limit which destinations serverless compute, apps and model serving can reach, used with network connectivity configurations and private endpoint rules."@en ;
  dpc:realises dpc:network-security ;
  dpc:realises dpc:data-loss-prevention ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/security/network/> .

dpc:databricks-serverless-usage-policies a dpc:Technology ;
  skos:prefLabel "Databricks serverless usage policies"@en ;
  dcterms:description "Sets of tags applied automatically to the serverless usage of the users assigned to a policy, so that spend from notebooks, jobs, pipelines, serving, apps and Lakebase can be attributed."@en ;
  skos:altLabel "Serverless budget policies"@en ;
  dpc:realises dpc:cost-attribution ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/admin/usage/budget-policies> .

dpc:databricks-spatial-sql a dpc:Technology ;
  skos:prefLabel "Databricks spatial SQL (GEOMETRY and GEOGRAPHY)"@en ;
  dcterms:description "Native GEOMETRY and GEOGRAPHY types with ST_ functions for constructing, measuring, relating and transforming spatial data, plus H3 functions."@en ;
  dpc:realises dpc:geospatial-data ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/sql/language-manual/sql-ref-st-geospatial-functions> .

dpc:databricks-sql a dpc:Technology ;
  skos:prefLabel "Databricks SQL"@en ;
  dcterms:description "The data warehousing product on the lakehouse. It includes the SQL editor, queries, ANSI SQL engine, SQL transformations, materialised views and BI connectivity, running on SQL warehouses."@en ;
  skos:altLabel "DBSQL"@en ;
  dpc:realises dpc:sql-query-engine ;
  dpc:realises dpc:ad-hoc-analysis ;
  dpc:realises dpc:sql-transformation ;
  dpc:realises dpc:query-performance-analysis ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/compute/sql-warehouse/> .

dpc:databricks-sql-alerts a dpc:Technology ;
  skos:prefLabel "Databricks SQL alerts"@en ;
  dcterms:description "Scheduled queries that evaluate a condition and send email, Slack or webhook notifications when it is met."@en ;
  dpc:realises dpc:data-alerting ;
  dpc:realises dpc:freshness-monitoring ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/sql/user/alerts/> .

dpc:databricks-sql-drivers a dpc:Technology ;
  skos:prefLabel "Databricks JDBC, ODBC and ADBC drivers"@en ;
  dcterms:description "Client drivers and connectors (JDBC, ODBC, ADBC, Python, Go and Node.js) plus the SQL Statement Execution REST API, used to query Databricks SQL warehouses from tools and code."@en ;
  skos:altLabel "Simba Spark ODBC Driver"@en ;
  dpc:realises dpc:sql-access ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/february> .

dpc:databricks-sql-warehouses a dpc:Technology ;
  skos:prefLabel "Databricks SQL warehouses (serverless, pro and classic)"@en ;
  dcterms:description "Compute for Databricks SQL in serverless, pro or classic form. Serverless warehouses start in seconds and use intelligent workload management to scale and queue queries."@en ;
  skos:altLabel "SQL endpoints"@en ;
  dpc:realises dpc:serverless-compute ;
  dpc:realises dpc:elastic-scaling ;
  dpc:realises dpc:workload-management ;
  dpc:realises dpc:result-caching ;
  dpc:realises dpc:workload-isolation ;
  dpc:realises dpc:hybrid-data-plane ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/compute/sql-warehouse/> .

dpc:databricks-system-tables a dpc:Technology ;
  skos:prefLabel "Databricks system tables"@en ;
  dcterms:description "Databricks-hosted tables in the system catalog that cover billing, audit, lineage, compute, query history, jobs, pipelines, serving, MLflow, classification, data quality and Lakebase activity."@en ;
  dpc:realises dpc:system-telemetry ;
  dpc:realises dpc:audit-logging ;
  dpc:realises dpc:cost-attribution ;
  dpc:realises dpc:query-performance-analysis ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/admin/system-tables/> .

dpc:databricks-table-clone a dpc:Technology ;
  skos:prefLabel "Databricks table clone (shallow and deep clone)"@en ;
  dcterms:description "Copies a table at a given version. A shallow clone copies only metadata and points at the source files, while a deep clone copies the data as well."@en ;
  skos:altLabel "Delta table clone"@en ;
  dpc:realises dpc:zero-copy-cloning ;
  dpc:realises dpc:backup-restore ;
  dpc:realises dpc:test-data-management ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/delta/clone> .

dpc:databricks-terraform-provider a dpc:Technology ;
  skos:prefLabel "Databricks Terraform provider"@en ;
  dcterms:description "A Terraform provider (databricks/databricks) that manages workspaces, Unity Catalog objects, permissions, compute, jobs and other Databricks resources as code."@en ;
  dpc:realises dpc:infrastructure-as-code ;
  dpc:realises dpc:self-service-provisioning ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/dev-tools/terraform/> .

dpc:databricks-unity-catalog a dpc:Technology ;
  skos:prefLabel "Unity Catalog"@en ;
  dcterms:description "The account-wide catalogue and governance layer for tables, volumes, functions, models, AI services and connections. It provides a three-level namespace, SQL privileges, audit and workspace bindings."@en ;
  skos:altLabel "UC"@en ;
  dpc:realises dpc:table-catalogue ;
  dpc:realises dpc:role-based-access ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/data-governance/unity-catalog/> .

dpc:databricks-unity-catalog-functions a dpc:Technology ;
  skos:prefLabel "Unity Catalog functions (UDFs)"@en ;
  dcterms:description "SQL, Python, Scala and Java user-defined functions registered and governed in Unity Catalog. They run on serverless and standard compute with sandboxing."@en ;
  dpc:realises dpc:user-defined-functions ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/september> .

dpc:databricks-unity-catalog-lineage a dpc:Technology ;
  skos:prefLabel "Unity Catalog data lineage"@en ;
  dcterms:description "Captures table- and column-level lineage automatically for queries, notebooks, jobs, pipelines, dashboards and models. External sources and BI tools can be registered so they appear in the same graph."@en ;
  dpc:realises dpc:table-lineage ;
  dpc:realises dpc:column-lineage ;
  dpc:realises dpc:model-lineage ;
  dpc:realises dpc:cross-system-lineage ;
  dpc:realises dpc:impact-analysis ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/data-governance/unity-catalog/data-lineage> .

dpc:databricks-unity-catalog-managed-tables a dpc:Technology ;
  skos:prefLabel "Unity Catalog managed tables"@en ;
  dcterms:description "Delta or Iceberg tables whose storage location, file layout, maintenance and lifecycle Unity Catalog manages, including on Databricks-managed default storage."@en ;
  dpc:realises dpc:managed-storage ;
  dpc:realises dpc:table-maintenance ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/optimizations/predictive-optimization> .

dpc:databricks-unity-gateway a dpc:Technology ;
  skos:prefLabel "Unity Gateway"@en ;
  dcterms:description "A governance and routing layer in Unity Catalog for model, MCP and agent traffic, with provider fallbacks, rate and consumption limits, guardrails, inference logging and budgets."@en ;
  skos:altLabel "Mosaic AI Gateway"@en ;
  skos:altLabel "Databricks AI Gateway"@en ;
  skos:altLabel "Unity AI Gateway"@en ;
  dpc:realises dpc:ai-gateway ;
  dpc:realises dpc:ai-guardrails ;
  dpc:realises dpc:genai-observability ;
  dpc:realises dpc:agent-tool-access ;
  dpc:realises dpc:ai-spend-controls ;
  dpc:realises dpc:agent-registry ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/ai-gateway/> .

dpc:databricks-variant a dpc:Technology ;
  skos:prefLabel "Databricks VARIANT data type"@en ;
  dcterms:description "A binary type for semi-structured data such as JSON that is queried without a fixed schema, with shredding into columns for faster reads."@en ;
  dpc:realises dpc:semi-structured-data ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/release-notes/product/2026/july> .

dpc:databricks-volumes a dpc:Technology ;
  skos:prefLabel "Unity Catalog volumes"@en ;
  dcterms:description "Governed, path-addressable storage for non-tabular files such as documents, images, libraries and landing data. Volumes can be managed or external."@en ;
  skos:altLabel "UC volumes"@en ;
  dpc:realises dpc:unstructured-data ;
  dpc:realises dpc:unstructured-ingestion ;
  dpc:realises dpc:object-file-access ;
  dpc:realises dpc:analytical-sandboxes ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/volumes/> .

dpc:databricks-zerobus-ingest a dpc:Technology ;
  skos:prefLabel "Zerobus Ingest"@en ;
  dcterms:description "A serverless push API that writes records straight into Unity Catalog Delta tables. Clients can use gRPC SDKs, REST, OpenTelemetry (OTLP), MQTT or Kafka-compatible producers, and no message broker is needed."@en ;
  skos:altLabel "Zerobus"@en ;
  dpc:realises dpc:streaming-ingestion ;
  dpc:realises dpc:iot-ingestion ;
  dpc:platform dpc:platform-databricks ;
  rdfs:seeAlso <https://docs.databricks.com/aws/en/ingestion/zerobus-overview> .

dpc:dataframe-apis a skos:Concept ;
  skos:prefLabel "DataFrame APIs"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:processing ;
  skos:related dpc:user-defined-functions ;
  skos:related dpc:notebooks ;
  skos:related dpc:feature-engineering ;
  skos:related dpc:sql-transformation ;
  skos:related dpc:data-testing ;
  skos:altLabel "PySpark"@en ;
  skos:altLabel "Snowpark"@en ;
  skos:altLabel "BigQuery DataFrames"@en ;
  skos:definition "Express transformations in Python, Scala or other languages through DataFrame interfaces that run in the engine."@en .

dpc:datahub a dpc:Technology ;
  skos:prefLabel "DataHub"@en ;
  dcterms:description "Metadata platform and data catalogue with search, column-level lineage, glossary, ownership, quality assertions and an event-driven metadata model."@en ;
  skos:altLabel "DataHub Core"@en ;
  skos:altLabel "DataHub open source"@en ;
  dpc:realises dpc:data-catalogue ;
  dpc:realises dpc:column-lineage ;
  dpc:realises dpc:business-glossary ;
  dpc:realises dpc:metadata-harvesting ;
  dpc:realises dpc:active-metadata ;
  dpc:realises dpc:data-domains ;
  dpc:realises dpc:ai-context-layer ;
  dpc:platform dpc:platform-open-source ;
  rdfs:seeAlso <https://github.com/datahub-project/datahub> .

dpc:datahub-cloud a dpc:Technology ;
  skos:prefLabel "DataHub Cloud"@en ;
  dcterms:description "Managed, extended edition of the open-source DataHub metadata platform that adds data observability assertions, AI documentation, access request workflows and an AI assistant."@en ;
  skos:altLabel "Acryl Cloud"@en ;
  skos:altLabel "Managed DataHub"@en ;
  dpc:realises dpc:data-catalogue ;
  dpc:realises dpc:data-observability ;
  dpc:realises dpc:access-requests ;
  dpc:realises dpc:ai-generated-documentation ;
  dpc:realises dpc:cross-system-lineage ;
  dpc:realises dpc:ai-context-layer ;
  dpc:realises dpc:data-domains ;
  dpc:realises dpc:stewardship-workflows ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://docs.datahub.com/docs/managed-datahub/managed-datahub-overview> .

dpc:dataiku a dpc:Technology ;
  skos:prefLabel "Dataiku DSS"@en ;
  dcterms:description "Platform in which teams build data pipelines, models, generative AI applications and agents as shared projects, with managed code environments, Git-based version control, containerised execution and per-user security."@en ;
  skos:altLabel "Dataiku"@en ;
  skos:altLabel "Data Science Studio"@en ;
  skos:altLabel "Platform for AI Success"@en ;
  skos:altLabel "Universal AI Platform"@en ;
  dpc:realises dpc:runtime-management ;
  dpc:realises dpc:version-control ;
  dpc:realises dpc:container-services ;
  dpc:realises dpc:compute-user-isolation ;
  dpc:realises dpc:secrets-management ;
  dpc:realises dpc:audit-logging ;
  dpc:realises dpc:data-consumer-portal ;
  dpc:platform dpc:platform-dataiku ;
  rdfs:seeAlso <https://www.dataiku.com/product/> .

dpc:dataiku-agent-hub a dpc:Technology ;
  skos:prefLabel "Dataiku Agent Hub"@en ;
  dcterms:description "Portal in which business users chat with the agents an organisation publishes and build their own quick agents over documents and data."@en ;
  skos:altLabel "Agent Chat"@en ;
  skos:altLabel "Quick Agents"@en ;
  dpc:realises dpc:enterprise-ai-assistant ;
  dpc:platform dpc:platform-dataiku ;
  rdfs:seeAlso <https://doc.dataiku.com/dss/latest/generative-ai/chat-ui/index.html> .

dpc:dataiku-agent-management a dpc:Technology ;
  skos:prefLabel "Dataiku Agent Management"@en ;
  dcterms:description "Standalone product that finds AI agents running on Dataiku and other vendors' platforms, maps the tools and models they use, and tracks their performance, risk and certification status."@en ;
  dpc:realises dpc:ai-system-discovery ;
  dpc:realises dpc:agent-registry ;
  dpc:realises dpc:genai-observability ;
  dpc:platform dpc:platform-dataiku ;
  rdfs:seeAlso <https://www.dataiku.com/company/news/dataiku-agent-management-general-availability> .

dpc:dataiku-agents a dpc:Technology ;
  skos:prefLabel "Dataiku Visual Agents and Code Agents"@en ;
  dcterms:description "Agents built visually or in Python on the LLM Mesh, using managed tools, knowledge banks, semantic models and MCP tools, with human approval steps, tracing, evaluation and MCP and A2A servers for other systems."@en ;
  skos:altLabel "Visual Agents"@en ;
  skos:altLabel "Code Agents"@en ;
  skos:altLabel "Structured Visual Agents"@en ;
  skos:altLabel "Agent Skills"@en ;
  dpc:realises dpc:ai-agents ;
  dpc:realises dpc:agent-tool-access ;
  dpc:realises dpc:human-oversight ;
  dpc:realises dpc:genai-observability ;
  dpc:realises dpc:genai-evaluation ;
  dpc:realises dpc:agent-interoperability ;
  dpc:platform dpc:platform-dataiku ;
  rdfs:seeAlso <https://doc.dataiku.com/dss/latest/agents/index.html> .

dpc:dataiku-catalog a dpc:Technology ;
  skos:prefLabel "Dataiku Catalog"@en ;
  dcterms:description "Instance-wide catalogue for finding datasets, models, agents, knowledge banks and other project assets, with curated collections, a most-used datasets view and AI-generated descriptions."@en ;
  skos:altLabel "Dataiku Data Catalog"@en ;
  dpc:realises dpc:data-catalogue ;
  dpc:realises dpc:usage-metadata ;
  dpc:realises dpc:ai-generated-documentation ;
  dpc:platform dpc:platform-dataiku ;
  rdfs:seeAlso <https://doc.dataiku.com/dss/latest/catalog/index.html> .

dpc:dataiku-cloud a dpc:Technology ;
  skos:prefLabel "Dataiku Cloud"@en ;
  dcterms:description "Edition of Dataiku that Dataiku hosts, operates and upgrades as a service, administered through a Launchpad and connected to the customer's own data sources."@en ;
  dpc:realises dpc:deployment-options ;
  dpc:platform dpc:platform-dataiku ;
  rdfs:seeAlso <https://knowledge.dataiku.com/latest/kb/dataiku-cloud-offer/launchpad.html> .

dpc:dataiku-cloud-stacks a dpc:Technology ;
  skos:prefLabel "Dataiku Cloud Stacks and Fleet Manager"@en ;
  dcterms:description "Self-managed deployment of Dataiku in the customer's AWS, Azure or Google Cloud account, where Fleet Manager creates, upgrades, backs up and configures the Dataiku instances."@en ;
  skos:altLabel "Fleet Manager"@en ;
  skos:altLabel "Dataiku Cloud Stacks"@en ;
  dpc:realises dpc:deployment-options ;
  dpc:realises dpc:backup-restore ;
  dpc:platform dpc:platform-dataiku ;
  rdfs:seeAlso <https://doc.dataiku.com/dss/latest/installation/cloudstacks-aws/index.html> .

dpc:dataiku-cobuild a dpc:Technology ;
  skos:prefLabel "Dataiku Cobuild"@en ;
  dcterms:description "Agent inside a Dataiku project that builds and edits Flows, recipes, models, knowledge banks, agents, dashboards, notebooks and scenarios from natural-language requests."@en ;
  dpc:realises dpc:data-engineering-agents ;
  dpc:platform dpc:platform-dataiku ;
  rdfs:seeAlso <https://doc.dataiku.com/dss/latest/ai-assistants/cobuild.html> .

dpc:dataiku-code-recipes-notebooks a dpc:Technology ;
  skos:prefLabel "Dataiku code recipes and notebooks"@en ;
  dcterms:description "Python, R, SQL, Hive, Impala, PySpark, SparkR, SparkSQL, Spark Scala and shell recipes and Jupyter and SQL notebooks that run inside the Flow alongside visual recipes."@en ;
  dpc:realises dpc:notebooks ;
  dpc:realises dpc:sql-transformation ;
  dpc:realises dpc:distributed-processing ;
  dpc:platform dpc:platform-dataiku ;
  rdfs:seeAlso <https://doc.dataiku.com/dss/latest/code-recipes/index.html> .

dpc:dataiku-code-studios a dpc:Technology ;
  skos:prefLabel "Dataiku Code Studios"@en ;
  dcterms:description "Browser-based development environments such as VS Code, JupyterLab and RStudio that run in containers next to a project, with coding agents such as Claude Code, OpenAI Codex and GitHub Copilot."@en ;
  dpc:realises dpc:local-development ;
  dpc:realises dpc:ai-assisted-development ;
  dpc:platform dpc:platform-dataiku ;
  rdfs:seeAlso <https://doc.dataiku.com/dss/latest/code-studios/index.html> .

dpc:dataiku-connections a dpc:Technology ;
  skos:prefLabel "Dataiku connections"@en ;
  dcterms:description "Connectors that read and write data in SQL databases, cloud warehouses, object storage, Iceberg tables, NoSQL stores and business applications, and let recipes run inside the connected engine."@en ;
  dpc:realises dpc:database-extraction ;
  dpc:realises dpc:saas-connectors ;
  dpc:realises dpc:engine-interoperability ;
