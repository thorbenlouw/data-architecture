dpc:fivetran-hvr a dpc:Technology ;
  skos:prefLabel "Fivetran HVR"@en ;
  dcterms:description "Self-hosted replication software from Fivetran that captures changes from database transaction logs and replicates databases and file systems at high volume."@en ;
  skos:altLabel "HVR 6"@en ;
  skos:altLabel "HVR"@en ;
  skos:altLabel "High-Volume Replicator"@en ;
