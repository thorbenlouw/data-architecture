  skos:broader dpc:sql-transformation ;
  skos:related dpc:data-testing ;
  skos:related dpc:ci-cd ;
  skos:related dpc:table-lineage ;
  skos:related dpc:environment-promotion ;
  skos:related dpc:declarative-pipelines ;
  dpc:dependsOn dpc:version-control ;
  skos:altLabel "dbt"@en ;
  skos:altLabel "models as code"@en ;
  skos:altLabel "SQL frameworks"@en ;
  skos:definition "Define transformations as version-controlled, tested, modular code whose dependencies are resolved automatically."@en .

dpc:trino a dpc:Technology ;
  skos:prefLabel "Trino"@en ;
  dcterms:description "Distributed SQL query engine that queries data in place across object storage, lakehouse tables and many databases through connectors."@en ;
  skos:altLabel "PrestoSQL"@en ;
  dpc:realises dpc:sql-query-engine ;
  dpc:realises dpc:query-federation ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:decoupled-storage-compute ;
  dpc:realises dpc:approximate-query-processing ;
  dpc:platform dpc:platform-open-source ;
  rdfs:seeAlso <https://trino.io/> .

dpc:twilio-segment a dpc:Technology ;
  skos:prefLabel "Twilio Segment"@en ;
  dcterms:description "Customer data platform that collects behavioural events through SDKs, validates them against tracking plans, unifies profiles and sends data to destinations, including from the warehouse."@en ;
  skos:altLabel "Segment"@en ;
  dpc:realises dpc:behavioural-event-collection ;
  dpc:realises dpc:data-contracts ;
  dpc:realises dpc:entity-resolution ;
  dpc:realises dpc:reverse-etl ;
  dpc:realises dpc:audience-activation ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://www.twilio.com/docs/segment> .

dpc:unity-catalog a dpc:Technology ;
  skos:prefLabel "Unity Catalog (open source)"@en ;
  dcterms:description "Open-source catalogue for tables, volumes of files, functions and AI models, with an Iceberg REST and Hive Metastore compatible API."@en ;
  skos:altLabel "Unity Catalog OSS"@en ;
  dpc:realises dpc:table-catalogue ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:access-control ;
  dpc:realises dpc:unstructured-data ;
  dpc:realises dpc:credential-vending ;
  dpc:platform dpc:platform-open-source ;
  rdfs:seeAlso <https://github.com/unitycatalog/unitycatalog> .

dpc:unstructured a dpc:Technology ;
  skos:prefLabel "Unstructured.io"@en ;
  dcterms:description "Managed service that partitions documents into structured elements, then chunks and embeds them and loads them into vector stores and data platforms, from 20+ source connectors."@en ;
  skos:altLabel "Unstructured"@en ;
  skos:altLabel "Unstructured Transform"@en ;
  dpc:realises dpc:document-processing ;
  dpc:realises dpc:retrieval-pipelines ;
