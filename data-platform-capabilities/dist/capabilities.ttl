dpc:pgvector a dpc:Technology ;
  skos:prefLabel "pgvector"@en ;
  dcterms:description "PostgreSQL extension that adds a vector type, distance operators and HNSW and IVFFlat indexes for similarity search."@en ;
  dpc:realises dpc:vector-search ;
  dpc:realises dpc:retrieval-augmented-generation ;
  dpc:platform dpc:platform-open-source ;
  rdfs:seeAlso <https://github.com/pgvector/pgvector> .

dpc:pinecone a dpc:Technology ;
  skos:prefLabel "Pinecone"@en ;
  dcterms:description "Managed vector database for dense, sparse, full-text and hybrid retrieval, with hosted embedding and reranking models and a managed RAG assistant."@en ;
  dpc:realises dpc:vector-search ;
  dpc:realises dpc:embedding-generation ;
  dpc:realises dpc:retrieval-augmented-generation ;
  dpc:realises dpc:full-text-search ;
  dpc:realises dpc:hybrid-data-plane ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://docs.pinecone.io/guides/get-started/overview> .

