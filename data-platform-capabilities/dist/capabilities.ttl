dpc:gcp-bigquery-workload-management a dpc:Technology ;
  skos:prefLabel "BigQuery workload management"@en ;
  dcterms:description "Reservations, assignments, idle-slot sharing, target concurrency, query queues and reservation groups that divide slot capacity between projects and workload types."@en ;
  skos:altLabel "BigQuery reservations"@en ;
  skos:altLabel "BigQuery capacity management"@en ;
  dpc:realises dpc:workload-management ;
  dpc:realises dpc:workload-isolation ;
  dpc:realises dpc:spend-controls ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/reservations-intro> .

dpc:gcp-bigtable a dpc:Technology ;
  skos:prefLabel "Bigtable"@en ;
