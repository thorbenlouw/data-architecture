  skos:prefLabel "Shadow deployment"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:model-release-strategies ;
  skos:related dpc:canary-ab-testing ;
  skos:related dpc:champion-challenger ;
  skos:related dpc:model-performance-monitoring ;
  skos:related dpc:real-time-inference ;
  dpc:dependsOn dpc:inference-logging ;
  skos:altLabel "shadow mode"@en ;
  skos:altLabel "dark launch"@en ;
  skos:definition "Run a new model on live traffic without acting on its outputs, to compare it with the production model."@en .

dpc:shift-left a dpc:Pattern ;
  skos:prefLabel "Shift-left data quality and governance"@en ;
  dcterms:description "Move quality checks, contracts and governance controls upstream to where data is produced."@en ;
  skos:altLabel "shift left"@en ;
  skos:altLabel "quality at source"@en ;
  dpc:uses dpc:data-contracts ;
  dpc:uses dpc:schema-registry ;
  dpc:uses dpc:schema-change-management ;
  dpc:uses dpc:data-quality-rules ;
  dpc:uses dpc:data-testing ;
  dpc:uses dpc:ci-cd ;
  dpc:uses dpc:data-classification ;
  dpc:uses dpc:data-ownership ;
  dpc:uses dpc:active-metadata .

dpc:sifflet a dpc:Technology ;
  skos:prefLabel "Sifflet"@en ;
  dcterms:description "Data observability service that combines monitors, field-level lineage, a catalogue and incident management, with AI agents that recommend monitors and investigate root causes."@en ;
  dpc:realises dpc:data-observability ;
  dpc:realises dpc:data-anomaly-detection ;
  dpc:realises dpc:cross-system-lineage ;
  dpc:realises dpc:data-issue-management ;
  dpc:realises dpc:data-catalogue ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://docs.siffletdata.com/> .

dpc:sigma a dpc:Technology ;
  skos:prefLabel "Sigma Computing"@en ;
  dcterms:description "Warehouse-native BI and apps service with a spreadsheet interface that compiles to SQL, input tables that write back to the warehouse, and AI agents and apps."@en ;
  skos:altLabel "Sigma"@en ;
  dpc:realises dpc:ad-hoc-analysis ;
  dpc:realises dpc:spreadsheet-integration ;
  dpc:realises dpc:data-applications ;
  dpc:realises dpc:dashboards-reports ;
  dpc:realises dpc:embedded-analytics ;
  dpc:realises dpc:data-writeback ;
  dpc:realises dpc:analytical-sandboxes ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://www.sigmacomputing.com/product> .

dpc:sigstore-model-signing a dpc:Technology ;
  skos:prefLabel "OpenSSF Model Signing"@en ;
  dcterms:description "Open specification and library for signing machine learning model files with Sigstore so consumers can check who produced a model and that it has not been altered."@en ;
  skos:altLabel "model-transparency"@en ;
  skos:altLabel "OMS"@en ;
  skos:altLabel "Sigstore model signing"@en ;
  dpc:realises dpc:ai-supply-chain-security ;
  dpc:platform dpc:platform-open-source ;
  rdfs:seeAlso <https://github.com/sigstore/model-transparency> .

dpc:similar-capabilities a dpc:Reference ;
  skos:prefLabel "Choosing between similar capabilities"@en ;
  dcterms:description "Groups of capabilities that are easily confused, with one line on what each is and when to choose it."@en .

dpc:single-node-processing a skos:Concept ;
  skos:prefLabel "Single-node processing"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:processing ;
  skos:related dpc:distributed-processing ;
  skos:related dpc:dataframe-apis ;
  skos:related dpc:credential-vending ;
  skos:related dpc:engine-interoperability ;
  skos:related dpc:local-development ;
  dpc:dependsOn dpc:file-formats ;
  skos:altLabel "small data"@en ;
  skos:altLabel "DuckDB"@en ;
  skos:altLabel "Polars"@en ;
  skos:altLabel "pandas"@en ;
  skos:definition "Process small to medium datasets quickly on one machine using in-process engines."@en .

dpc:sisense a dpc:Technology ;
  skos:prefLabel "Sisense"@en ;
  dcterms:description "Analytics platform aimed mainly at embedding dashboards and AI-driven analytics in other products, with the Compose SDK for API-first development."@en ;
  dpc:realises dpc:embedded-analytics ;
  dpc:realises dpc:dashboards-reports ;
  dpc:realises dpc:data-applications ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://www.sisense.com/platform/> .

dpc:skyflow-data-privacy-vault a dpc:Technology ;
  skos:prefLabel "Skyflow Data Privacy Vault"@en ;
  dcterms:description "Isolates sensitive personal data in a dedicated vault and gives applications, analytics and AI tokens or policy-controlled detokenised values instead."@en ;
  skos:altLabel "Skyflow"@en ;
  dpc:realises dpc:deidentification ;
  dpc:realises dpc:data-residency ;
  dpc:realises dpc:column-masking ;
  dpc:realises dpc:ai-guardrails ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://www.skyflow.com/> .

dpc:slowly-changing-dimensions a dpc:Pattern ;
  skos:prefLabel "Slowly changing dimensions"@en ;
  dcterms:description "Track changes to descriptive attributes over time, for example by overwriting values or versioning rows."@en ;
  skos:altLabel "SCD"@en ;
  skos:altLabel "SCD type 2"@en ;
  skos:altLabel "SCD2"@en ;
  skos:altLabel "SCD type 1"@en ;
  dpc:uses dpc:data-modelling ;
  dpc:uses dpc:change-data-capture ;
  dpc:uses dpc:row-level-updates ;
  dpc:uses dpc:incremental-processing ;
  dpc:uses dpc:sql-transformation ;
  dpc:uses dpc:transformation-as-code ;
  dpc:uses dpc:temporal-data ;
  dpc:uses dpc:time-travel .

dpc:snorkel-ai a dpc:Technology ;
  skos:prefLabel "Snorkel AI"@en ;
  dcterms:description "Builds expert-labelled datasets, rubrics and evaluation environments for training and testing models and agents, having started with programmatic labelling (Snorkel Flow)."@en ;
  skos:altLabel "Snorkel Flow"@en ;
  dpc:realises dpc:data-labelling ;
  dpc:realises dpc:genai-evaluation ;
  dpc:realises dpc:model-customisation ;
  dpc:realises dpc:training-dataset-management ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://snorkel.ai/> .

dpc:snowflake-access-control a dpc:Technology ;
  skos:prefLabel "Snowflake access control (RBAC and database roles)"@en ;
  dcterms:description "A hierarchy of account roles, database roles and application roles that hold privileges on securable objects, with secondary roles and managed access schemas."@en ;
  skos:altLabel "Snowflake RBAC"@en ;
  dpc:realises dpc:role-based-access ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/security-access-control-overview> .

dpc:snowflake-access-history a dpc:Technology ;
  skos:prefLabel "Snowflake Access History"@en ;
  dcterms:description "An ACCOUNT_USAGE view that records which columns each query read and which objects it wrote, including through views and policies."@en ;
  dpc:realises dpc:audit-logging ;
  dpc:realises dpc:usage-metadata ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/access-history> .

dpc:snowflake-account-usage a dpc:Technology ;
  skos:prefLabel "Snowflake ACCOUNT_USAGE and ORGANIZATION_USAGE"@en ;
  dcterms:description "Shared SNOWFLAKE database schemas that expose query, login, metering, storage, access, task, AI and billing history as views, for one account or the whole organisation."@en ;
  skos:altLabel "ACCOUNT_USAGE"@en ;
  skos:altLabel "ORGANIZATION_USAGE"@en ;
  dpc:realises dpc:system-telemetry ;
  dpc:realises dpc:cost-attribution ;
  dpc:realises dpc:usage-metadata ;
  dpc:realises dpc:query-performance-analysis ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/sql-reference/account-usage> .

dpc:snowflake-adaptive-compute a dpc:Technology ;
  skos:prefLabel "Snowflake Adaptive Compute"@en ;
  dcterms:description "A warehouse type (adaptive warehouses) for which Snowflake decides the resources for each query, so you do not set a size, multi-cluster settings or suspend policies."@en ;
  dpc:realises dpc:serverless-compute ;
  dpc:realises dpc:elastic-scaling ;
  dpc:realises dpc:workload-management ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/warehouses-adaptive> .

dpc:snowflake-aggregation-policies a dpc:Technology ;
  skos:prefLabel "Snowflake aggregation policies"@en ;
  dcterms:description "Require queries on a protected table to aggregate rows into groups above a minimum size, at row or entity level, so individual records cannot be returned."@en ;
  dpc:realises dpc:privacy-enhancing-technologies ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/aggregation-policies> .

dpc:snowflake-ai-observability a dpc:Technology ;
  skos:prefLabel "Snowflake AI Observability"@en ;
  dcterms:description "Tracing, cost tracking and batch evaluation for agents, Cortex Search, CoCo and custom TruLens-instrumented apps, stored in an account event table and viewed in Snowsight."@en ;
  dpc:realises dpc:genai-observability ;
  dpc:realises dpc:genai-evaluation ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/ai-observability> .

dpc:snowflake-alerts a dpc:Technology ;
  skos:prefLabel "Snowflake alerts and notifications"@en ;
  dcterms:description "Scheduled or event-driven conditions written in SQL that run an action, such as sending email, webhook or cloud-queue notifications, when data meets them."@en ;
  dpc:realises dpc:data-alerting ;
  dpc:realises dpc:freshness-monitoring ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/alerts> .

dpc:snowflake-authentication a dpc:Technology ;
  skos:prefLabel "Snowflake authentication (SSO, OAuth, key pair, PATs, workload identity federation)"@en ;
  dcterms:description "Authenticates users and services through SAML SSO, Snowflake or external OAuth, key pairs, programmatic access tokens, MFA and workload identity federation with cloud identities."@en ;
  dpc:realises dpc:identity-authentication ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/admin-security-fed-auth-overview> .

dpc:snowflake-backups a dpc:Technology ;
  skos:prefLabel "Snowflake backups"@en ;
  dcterms:description "Point-in-time, zero-copy backups of tables, schemas and databases, managed through backup sets and backup policies, with optional retention locks and legal holds."@en ;
  skos:altLabel "Snowflake snapshots"@en ;
  skos:altLabel "snapshot sets"@en ;
  dpc:realises dpc:backup-restore ;
  dpc:realises dpc:data-retention ;
  dpc:realises dpc:immutable-backups ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/backups> .

dpc:snowflake-budgets a dpc:Technology ;
  skos:prefLabel "Snowflake budgets"@en ;
  dcterms:description "Monthly credit limits for the account or for custom groups of objects (including by tag) that forecast spend, send notifications and can run stored procedures, for example to suspend warehouses."@en ;
  dpc:realises dpc:spend-controls ;
  dpc:realises dpc:cost-attribution ;
  dpc:realises dpc:ai-spend-controls ;
  dpc:realises dpc:cost-forecasting ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/budgets> .

dpc:snowflake-catalog-linked-databases a dpc:Technology ;
  skos:prefLabel "Snowflake catalog-linked databases"@en ;
  dcterms:description "Databases linked to an external Iceberg REST catalogue (for example AWS Glue, Unity Catalog, Open Catalog, BigLake or S3 Tables) that discover and sync remote namespaces and tables automatically for querying and writing."@en ;
  dpc:realises dpc:catalogue-federation ;
  dpc:realises dpc:engine-interoperability ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/tables-iceberg-catalog-linked-database> .

dpc:snowflake-cli a dpc:Technology ;
  skos:prefLabel "Snowflake CLI"@en ;
  dcterms:description "An open-source command-line tool for running SQL and for building, testing and deploying Snowflake apps, Snowpark code, Streamlit apps, dbt and DCM projects from local machines and CI pipelines."@en ;
  skos:altLabel "snow CLI"@en ;
  dpc:realises dpc:local-development ;
  dpc:realises dpc:ci-cd ;
  dpc:realises dpc:environment-promotion ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowflake-cli/introduction/introduction> .

dpc:snowflake-clustering-keys a dpc:Technology ;
  skos:prefLabel "Snowflake clustering keys and Automatic Clustering"@en ;
  dcterms:description "Lets you declare clustering columns on large tables, then reorganises micro-partitions in the background to keep them well clustered so pruning stays effective."@en ;
  dpc:realises dpc:partitioning-clustering ;
  dpc:realises dpc:table-maintenance ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/tables-clustering-keys> .

dpc:snowflake-coco a dpc:Technology ;
  skos:prefLabel "Snowflake CoCo"@en ;
  dcterms:description "An AI coding agent, available in Snowsight, as a CLI, as a desktop app and in VS Code, that uses Snowflake skills and MCP tools to explore data, write SQL, and build pipelines, dbt projects and apps."@en ;
  skos:altLabel "Cortex Code"@en ;
  dpc:realises dpc:ai-assisted-development ;
  dpc:realises dpc:data-engineering-agents ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/cortex-code/cortex-code-cli> .

dpc:snowflake-connector-for-kafka a dpc:Technology ;
  skos:prefLabel "Snowflake Connector for Kafka"@en ;
  dcterms:description "A Kafka Connect sink connector that loads topics into Snowflake tables using Snowpipe Streaming."@en ;
  skos:altLabel "Snowflake Kafka connector"@en ;
  dpc:realises dpc:streaming-ingestion ;
  dpc:realises dpc:idempotent-loading ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/kafka-connector> .

dpc:snowflake-container-runtime a dpc:Technology ;
  skos:prefLabel "Snowflake Container Runtime for ML"@en ;
  dcterms:description "A prebuilt CPU and GPU ML environment on Snowpark Container Services, with distributed data loading, training and hyperparameter tuning built on Ray."@en ;
  dpc:realises dpc:model-training ;
  dpc:realises dpc:distributed-training ;
  dpc:realises dpc:hyperparameter-tuning ;
  dpc:realises dpc:gpu-compute ;
  dpc:realises dpc:runtime-management ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowflake-ml/container-runtime-ml> .

dpc:snowflake-copilot a dpc:Technology ;
  skos:prefLabel "Snowflake Copilot"@en ;
  dcterms:description "An SQL assistant in Snowsight that generates and explains queries from natural language."@en ;
  dpc:realises dpc:ai-assisted-development ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-copilot> .

dpc:snowflake-copy-into a dpc:Technology ;
  skos:prefLabel "Snowflake bulk loading (COPY INTO <table>)"@en ;
  dcterms:description "Loads staged files in bulk into tables on a warehouse, tracking which files were loaded so they are not loaded twice."@en ;
  skos:altLabel "COPY INTO <table>"@en ;
  dpc:realises dpc:batch-ingestion ;
  dpc:realises dpc:file-ingestion ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/data-load-overview> .

dpc:snowflake-cortex-agents a dpc:Technology ;
  skos:prefLabel "Snowflake Cortex Agents"@en ;
  dcterms:description "Schema-level agent objects that plan, call tools such as Cortex Analyst, Cortex Search, custom procedures, sandboxed Python code execution and web search, and answer with governed data."@en ;
  dpc:realises dpc:ai-agents ;
  dpc:realises dpc:agent-tool-access ;
  dpc:realises dpc:conversational-analytics ;
  dpc:realises dpc:agent-runtime ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-agents> .

dpc:snowflake-cortex-ai-function-studio a dpc:Technology ;
  skos:prefLabel "Snowflake Cortex AI Function Studio"@en ;
  dcterms:description "A Snowsight workspace for designing prompts for Cortex AI Functions, evaluating them against labelled data and optimising them."@en ;
  dpc:realises dpc:prompt-management ;
  dpc:realises dpc:genai-evaluation ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/release-notes/new-features-2026> .

dpc:snowflake-cortex-ai-functions a dpc:Technology ;
  skos:prefLabel "Snowflake Cortex AI Functions"@en ;
  dcterms:description "SQL functions such as AI_COMPLETE, AI_CLASSIFY, AI_FILTER, AI_AGG, AI_SUMMARIZE_AGG, AI_EMBED, AI_SENTIMENT, AI_TRANSLATE, AI_TRANSCRIBE and AI_REDACT that apply hosted models to columns and files."@en ;
  skos:altLabel "Cortex AISQL"@en ;
  skos:altLabel "Cortex LLM functions"@en ;
  dpc:realises dpc:ai-functions ;
  dpc:realises dpc:foundation-model-access ;
  dpc:realises dpc:embedding-generation ;
  dpc:realises dpc:deidentification ;
  dpc:realises dpc:audio-video-processing ;
  dpc:realises dpc:ai-spend-controls ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/aisql> .

dpc:snowflake-cortex-ai-gateway a dpc:Technology ;
  skos:prefLabel "Snowflake Cortex AI Gateway"@en ;
  dcterms:description "A single governed endpoint for AI clients that routes model calls, records traces and token use, and attributes spend to teams and users under budgets and quotas."@en ;
  dpc:realises dpc:ai-gateway ;
  dpc:realises dpc:genai-observability ;
  dpc:realises dpc:cost-attribution ;
  dpc:realises dpc:ai-spend-controls ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/user-guide/snowflake-cortex/cortex-ai-gateway> .

dpc:snowflake-cortex-ai-guardrails a dpc:Technology ;
  skos:prefLabel "Snowflake Cortex AI Guardrails"@en ;
  dcterms:description "Runtime checks that detect prompt injection and jailbreak attempts, including indirect injection in tool outputs, for Cortex Agents, CoWork and CoCo."@en ;
  dpc:realises dpc:ai-guardrails ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-ai-guardrails> .

dpc:snowflake-cortex-analyst a dpc:Technology ;
  skos:prefLabel "Snowflake Cortex Analyst"@en ;
  dcterms:description "Turns natural-language questions into SQL over semantic views and returns the answers, through a REST API or as an agent tool."@en ;
  dpc:realises dpc:conversational-analytics ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-analyst> .

dpc:snowflake-cortex-descriptions a dpc:Technology ;
  skos:prefLabel "Snowflake AI-generated descriptions"@en ;
  dcterms:description "Uses Cortex models to draft descriptions of tables, views and columns in Snowsight for owners to review and save as comments."@en ;
  dpc:realises dpc:ai-generated-documentation ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/ui-snowsight-cortex-descriptions> .

dpc:snowflake-cortex-document-functions a dpc:Technology ;
  skos:prefLabel "Snowflake Cortex AI Functions for documents (AI_PARSE_DOCUMENT, AI_EXTRACT)"@en ;
  dcterms:description "AI_PARSE_DOCUMENT turns PDFs and images into text and layout, and AI_EXTRACT pulls named fields, tables and entities out of documents."@en ;
  skos:altLabel "Snowflake Document AI"@en ;
  dpc:realises dpc:document-processing ;
  dpc:realises dpc:retrieval-pipelines ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/document-ai/overview> .

dpc:snowflake-cortex-fine-tuning a dpc:Technology ;
  skos:prefLabel "Snowflake Cortex Fine-tuning"@en ;
  dcterms:description "Builds parameter-efficient fine-tuned adaptors for supported base models from training data in Snowflake, for inference through AI_COMPLETE."@en ;
  dpc:realises dpc:model-customisation ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-finetuning> .

dpc:snowflake-cortex-knowledge-extensions a dpc:Technology ;
  skos:prefLabel "Snowflake Cortex Knowledge Extensions"@en ;
  dcterms:description "Cortex Search services shared as Marketplace or private listings, so a consumer's agents and RAG apps can search a provider's content, with citations."@en ;
  dpc:realises dpc:retrieval-augmented-generation ;
  dpc:realises dpc:data-marketplace ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-knowledge-extensions/cke-overview> .

dpc:snowflake-cortex-rest-api a dpc:Technology ;
  skos:prefLabel "Snowflake Cortex REST API"@en ;
  dcterms:description "REST endpoints, including chat-completions-style APIs, that give applications access to the large language models hosted in Snowflake's security boundary."@en ;
  dpc:realises dpc:foundation-model-access ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-rest-api> .

dpc:snowflake-cortex-search a dpc:Technology ;
  skos:prefLabel "Snowflake Cortex Search"@en ;
  dcterms:description "A managed hybrid vector and keyword search service, with reranking, that embeds, indexes and refreshes text from a query or stage on a target lag."@en ;
  dpc:realises dpc:vector-search ;
  dpc:realises dpc:retrieval-pipelines ;
  dpc:realises dpc:full-text-search ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-search/cortex-search-overview> .

dpc:snowflake-cost-anomaly-detection a dpc:Technology ;
  skos:prefLabel "Snowflake cost anomaly detection"@en ;
  dcterms:description "Flags days when account or organisation consumption falls outside the expected range, with optional anomaly monitors scoped by tags or service types."@en ;
  dpc:realises dpc:spend-controls ;
  dpc:realises dpc:cost-forecasting ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/cost-anomalies> .

dpc:snowflake-cowork a dpc:Technology ;
  skos:prefLabel "Snowflake CoWork"@en ;
  dcterms:description "A conversational agent application for business users that answers questions over structured and unstructured data, runs deep research, and produces artefacts, documents and scheduled automations."@en ;
  skos:altLabel "Snowflake Intelligence"@en ;
  dpc:realises dpc:conversational-analytics ;
  dpc:realises dpc:ai-agents ;
  dpc:realises dpc:data-alerting ;
  dpc:realises dpc:enterprise-ai-assistant ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/snowflake-cowork> .

dpc:snowflake-data-clean-rooms a dpc:Technology ;
  skos:prefLabel "Snowflake Data Clean Rooms"@en ;
  dcterms:description "Collaborations defined in YAML, in which owners, data providers and analysis runners combine data through approved templates without exposing raw rows to one another."@en ;
  skos:altLabel "Snowflake DCR"@en ;
  skos:altLabel "Samooha"@en ;
  dpc:realises dpc:data-clean-rooms ;
  dpc:realises dpc:privacy-enhancing-technologies ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/cleanrooms/introduction> .

dpc:snowflake-data-lineage a dpc:Technology ;
  skos:prefLabel "Snowflake data lineage (Snowsight lineage)"@en ;
  dcterms:description "Records table and column lineage from DML, CTAS and view dependencies, plus ML lineage across datasets, feature views, models and monitors, shown as a graph in Catalog Explorer."@en ;
  dpc:realises dpc:table-lineage ;
  dpc:realises dpc:column-lineage ;
  dpc:realises dpc:impact-analysis ;
  dpc:realises dpc:model-lineage ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/ui-snowsight-lineage> .

dpc:snowflake-data-quality-monitoring a dpc:Technology ;
  skos:prefLabel "Snowflake data quality monitoring (data metric functions)"@en ;
  dcterms:description "Schedules system and custom data metric functions on tables and views, compares results with expectations, and detects volume and freshness anomalies, with results in Snowsight."@en ;
  skos:altLabel "data metric functions"@en ;
  skos:altLabel "DMFs"@en ;
  dpc:realises dpc:data-quality-rules ;
  dpc:realises dpc:freshness-monitoring ;
  dpc:realises dpc:data-anomaly-detection ;
  dpc:realises dpc:data-quality-scorecards ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/data-quality-intro> .

dpc:snowflake-dbt-projects a dpc:Technology ;
  skos:prefLabel "dbt Projects on Snowflake"@en ;
  dcterms:description "Deploys, runs, schedules and monitors dbt projects as Snowflake objects on a dbt Core or dbt Fusion runtime that Snowflake manages, developed in Workspaces or from Git."@en ;
  dpc:realises dpc:transformation-as-code ;
  dpc:realises dpc:data-testing ;
  dpc:realises dpc:ci-cd ;
  dpc:realises dpc:ephemeral-environments ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/data-engineering/dbt-projects-on-snowflake> .

dpc:snowflake-dcm-projects a dpc:Technology ;
  skos:prefLabel "Snowflake DCM Projects"@en ;
  dcterms:description "Database Change Management projects that declare the desired state of databases, schemas, tables, dynamic tables, views, warehouses, roles, grants and data quality checks in SQL DEFINE files, then plan and deploy the changes."@en ;
  skos:altLabel "Database Change Management"@en ;
  skos:altLabel "Snowflake DCM"@en ;
  dpc:realises dpc:schema-change-management ;
  dpc:realises dpc:infrastructure-as-code ;
  dpc:realises dpc:environment-promotion ;
  dpc:realises dpc:ci-cd ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/dcm-projects/dcm-projects-overview> .

dpc:snowflake-differential-privacy a dpc:Technology ;
  skos:prefLabel "Snowflake differential privacy"@en ;
  dcterms:description "Privacy policies that add calibrated noise to aggregate results on protected tables and track each analyst's cumulative privacy loss against a budget."@en ;
  skos:altLabel "Snowflake privacy policies"@en ;
  dpc:realises dpc:privacy-enhancing-technologies ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/diff-privacy/differential-privacy-overview> .

dpc:snowflake-drivers-sql-api a dpc:Technology ;
  skos:prefLabel "Snowflake drivers, connectors and SQL API"@en ;
  dcterms:description "JDBC, ODBC, Python, Go, .NET and Node.js drivers, the Spark connector and a REST SQL API for connecting tools and applications to Snowflake."@en ;
  dpc:realises dpc:sql-access ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/drivers> .

dpc:snowflake-dynamic-tables a dpc:Technology ;
  skos:prefLabel "Snowflake Dynamic Tables"@en ;
  dcterms:description "Tables defined by a query and a target lag that Snowflake keeps refreshed, incrementally where possible, working out dependency order across chains of dynamic tables."@en ;
  dpc:realises dpc:declarative-pipelines ;
  dpc:realises dpc:incremental-processing ;
  dpc:realises dpc:sql-transformation ;
  dpc:realises dpc:asset-based-orchestration ;
  dpc:realises dpc:read-optimised-views ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/dynamic-tables-about> .

dpc:snowflake-external-access-integrations a dpc:Technology ;
  skos:prefLabel "Snowflake external network access (external access integrations)"@en ;
  dcterms:description "Lets UDFs, procedures and container services call approved external endpoints over the network, using network rules and secrets, for example to pull data from REST APIs."@en ;
  dpc:realises dpc:api-ingestion ;
  dpc:realises dpc:application-integration ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/external-network-access/external-network-access-overview> .

dpc:snowflake-external-lineage a dpc:Technology ;
  skos:prefLabel "Snowflake external lineage"@en ;
  dcterms:description "Accepts OpenLineage COMPLETE events through a REST endpoint, so tools such as dbt and Airflow can add lineage from outside Snowflake to the lineage graph."@en ;
  dpc:realises dpc:cross-system-lineage ;
  dpc:realises dpc:metadata-interoperability ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/external-lineage> .

dpc:snowflake-external-tables a dpc:Technology ;
  skos:prefLabel "Snowflake external tables"@en ;
  dcterms:description "Read-only tables over files in external stages, with optional automatic metadata refresh, so data in a lake can be queried without loading it."@en ;
  dpc:realises dpc:query-federation ;
  dpc:realises dpc:file-formats ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/tables-external-intro> .

dpc:snowflake-fail-safe a dpc:Technology ;
  skos:prefLabel "Snowflake Fail-safe"@en ;
  dcterms:description "Keeps a further non-configurable 7 days of historical data for permanent tables after Time Travel ends, recoverable only by Snowflake Support after a disaster."@en ;
  dpc:realises dpc:backup-restore ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/data-failsafe> .

dpc:snowflake-feature-store a dpc:Technology ;
  skos:prefLabel "Snowflake Feature Store"@en ;
  dcterms:description "Python APIs and objects for defining entities and feature views (as Dynamic Tables or views), generating point-in-time correct training sets and retrieving features for batch inference."@en ;
  dpc:realises dpc:feature-store ;
  dpc:realises dpc:offline-feature-store ;
  dpc:realises dpc:point-in-time-joins ;
  dpc:realises dpc:feature-engineering ;
  dpc:realises dpc:training-dataset-management ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowflake-ml/feature-store/overview> .

dpc:snowflake-gen2-warehouses a dpc:Technology ;
  skos:prefLabel "Snowflake generation 2 standard warehouses"@en ;
  dcterms:description "The newer generation of standard warehouses, running on faster hardware with optimisations for DELETE, UPDATE, MERGE and table scans."@en ;
  skos:altLabel "Gen2 warehouses"@en ;
  dpc:realises dpc:provisioned-compute ;
  dpc:realises dpc:sql-query-engine ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/warehouses-gen2> .

dpc:snowflake-geospatial a dpc:Technology ;
  skos:prefLabel "Snowflake geospatial data types and functions"@en ;
  dcterms:description "GEOGRAPHY and GEOMETRY types with spatial functions, H3 indexing and spatial joins in SQL."@en ;
  dpc:realises dpc:geospatial-data ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/sql-reference/data-types-geospatial> .

dpc:snowflake-git-integration a dpc:Technology ;
  skos:prefLabel "Snowflake Git integration (Git repository objects)"@en ;
  dcterms:description "Syncs remote Git repositories into Snowflake as repository clones, so code can be run with EXECUTE IMMEDIATE FROM and Workspaces, notebooks and Streamlit apps can commit and push."@en ;
  dpc:realises dpc:version-control ;
  dpc:realises dpc:ci-cd ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/git/git-overview> .

dpc:snowflake-horizon-catalog a dpc:Technology ;
  skos:prefLabel "Snowflake Horizon Catalog"@en ;
  dcterms:description "Snowflake's built-in catalogue and governance layer, covering object discovery, tagging, policies, quality, lineage, access history and Iceberg catalogue services for Snowflake and external data."@en ;
  skos:altLabel "Snowflake Horizon"@en ;
  dpc:realises dpc:data-catalogue ;
  dpc:realises dpc:table-catalogue ;
  dpc:realises dpc:data-policy-management ;
  dpc:realises dpc:metadata-harvesting ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-horizon> .

dpc:snowflake-horizon-context a dpc:Technology ;
  skos:prefLabel "Snowflake Horizon Context"@en ;
  dcterms:description "A layer of Horizon Catalog that gathers external metadata and lineage, enriches it with semantics, popularity and AI descriptions, and exposes it to agents and BI tools through search and MCP."@en ;
  dpc:realises dpc:semantic-layer ;
  dpc:realises dpc:active-metadata ;
  dpc:realises dpc:ai-context-layer ;
  dpc:realises dpc:semantic-model-interchange ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://www.snowflake.com/en/blog/horizon-context-governed-context/> .

dpc:snowflake-horizon-iceberg-rest-catalog a dpc:Technology ;
  skos:prefLabel "Snowflake Horizon Iceberg REST Catalog API"@en ;
  dcterms:description "An Apache Polaris-based Iceberg REST catalogue endpoint in each account that lets Spark, Trino, Flink, DuckDB, PyIceberg and other engines read and write Snowflake-managed Iceberg tables under Snowflake RBAC."@en ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:metadata-interoperability ;
  dpc:realises dpc:credential-vending ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/tables-iceberg-access-using-external-query-engine-snowflake-horizon> .

dpc:snowflake-hybrid-tables a dpc:Technology ;
  skos:prefLabel "Snowflake hybrid tables (Unistore)"@en ;
  dcterms:description "A row-oriented table type with enforced primary, unique and foreign keys, indexes and row locking, for low-latency point reads and writes in the same engine as analytical tables."@en ;
  skos:altLabel "Unistore"@en ;
  dpc:realises dpc:operational-database ;
  dpc:realises dpc:low-latency-serving ;
  dpc:realises dpc:operational-data-store ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/tables-hybrid> .

dpc:snowflake-iceberg-tables a dpc:Technology ;
  skos:prefLabel "Apache Iceberg tables in Snowflake"@en ;
  dcterms:description "Tables stored as Parquet files with Apache Iceberg metadata, managed either by Snowflake as catalogue or by an external catalogue, in customer storage or in Snowflake storage."@en ;
  dpc:realises dpc:open-table-formats ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:acid-transactions ;
  dpc:realises dpc:schema-evolution ;
  dpc:realises dpc:row-level-updates ;
  dpc:realises dpc:table-format-conversion ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/tables-iceberg> .

dpc:snowflake-intent-driven-governance a dpc:Technology ;
  skos:prefLabel "Snowflake Intent-Driven Governance"@en ;
  dcterms:description "A review-first CoCo workflow that turns a governance goal stated in plain language into a scope, a governance specification and SQL for tags and protections, which a person approves before it runs."@en ;
  dpc:realises dpc:data-policy-management ;
  dpc:realises dpc:data-classification ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/user-guide/intent-driven-governance> .

dpc:snowflake-interactive-tables a dpc:Technology ;
  skos:prefLabel "Snowflake interactive tables and interactive warehouses"@en ;
  dcterms:description "A table type and a matching warehouse type built for sub-second, highly concurrent queries such as user-facing dashboards and data APIs."@en ;
  dpc:realises dpc:real-time-analytics ;
  dpc:realises dpc:low-latency-serving ;
  dpc:realises dpc:read-optimised-views ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/interactive> .

dpc:snowflake-internal-marketplace a dpc:Technology ;
  skos:prefLabel "Snowflake Internal Marketplace (organisational listings)"@en ;
  dcterms:description "A private marketplace inside a Snowflake organisation where teams publish organisational listings as data products for discovery and access requests by other accounts."@en ;
  skos:altLabel "organizational listings"@en ;
  dpc:realises dpc:data-marketplace ;
  dpc:realises dpc:internal-data-sharing ;
  dpc:realises dpc:data-product-specification ;
  dpc:realises dpc:access-requests ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/collaboration/listings/organizational/org-listing-about> .

dpc:snowflake-listings a dpc:Technology ;
  skos:prefLabel "Snowflake listings (with Cross-Cloud Auto-Fulfillment)"@en ;
  dcterms:description "Package a share, app or service with descriptive metadata as a data product for chosen accounts, replicating it automatically to consumers in other regions and clouds."@en ;
  skos:altLabel "Cross-Cloud Auto-Fulfillment"@en ;
  dpc:realises dpc:external-data-sharing ;
  dpc:realises dpc:cross-region-sharing ;
  dpc:realises dpc:data-product-specification ;
  dpc:realises dpc:data-product-lifecycle ;
  dpc:realises dpc:data-product-metering ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/collaboration/collaboration-listings-about> .

dpc:snowflake-managed-mcp-server a dpc:Technology ;
  skos:prefLabel "Snowflake-managed MCP server"@en ;
  dcterms:description "A Snowflake object that exposes Cortex Agents, Cortex Analyst, Cortex Search, SQL execution and custom functions as Model Context Protocol tools to external AI clients under RBAC."@en ;
  dpc:realises dpc:agent-tool-access ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-cortex/cortex-agents-mcp> .

dpc:snowflake-managed-storage a dpc:Technology ;
  skos:prefLabel "Snowflake micro-partitioned table storage"@en ;
  dcterms:description "Stores standard tables in immutable, compressed, columnar micro-partitions with per-partition statistics that Snowflake manages, giving ACID transactions and partition pruning."@en ;
  dpc:realises dpc:managed-storage ;
  dpc:realises dpc:columnar-storage ;
  dpc:realises dpc:acid-transactions ;
  dpc:realises dpc:row-level-updates ;
  dpc:realises dpc:schema-evolution ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/tables-clustering-micropartitions> .

dpc:snowflake-marketplace a dpc:Technology ;
  skos:prefLabel "Snowflake Marketplace"@en ;
  dcterms:description "A public catalogue where providers publish free, paid or trial listings of data, Native Apps, Cortex Knowledge Extensions and agents, and consumers subscribe to them."@en ;
  dpc:realises dpc:data-marketplace ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/collaboration/collaboration-marketplace-about> .

dpc:snowflake-masking-policies a dpc:Technology ;
  skos:prefLabel "Snowflake masking policies"@en ;
  dcterms:description "Schema-level policies that mask, tokenise or reveal column values at query time depending on role, other context or tags, including external tokenisation through external functions."@en ;
  dpc:realises dpc:column-masking ;
  dpc:realises dpc:attribute-based-access ;
  dpc:realises dpc:deidentification ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/security-column-ddm-intro> .

dpc:snowflake-materialized-views a dpc:Technology ;
  skos:prefLabel "Snowflake materialized views"@en ;
  dcterms:description "Stores the results of a single-table query and keeps them up to date automatically in the background, so queries read precomputed results."@en ;
  dpc:realises dpc:materialised-views ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/views-materialized> .

dpc:snowflake-ml-experiments a dpc:Technology ;
  skos:prefLabel "Snowflake ML Experiments"@en ;
  dcterms:description "Records runs with parameters, metrics, artefacts and logs inside experiments, with autologging for common libraries and side-by-side comparison in Snowsight."@en ;
  dpc:realises dpc:experiment-tracking ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowflake-ml/experiments> .

dpc:snowflake-ml-functions a dpc:Technology ;
  skos:prefLabel "Snowflake ML Functions"@en ;
  dcterms:description "SQL-callable model classes for time-series forecasting, anomaly detection, classification and top insights, which train and run without ML code."@en ;
  dpc:realises dpc:in-database-ml ;
  dpc:realises dpc:automl ;
  dpc:realises dpc:augmented-analytics ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/guides-overview-ml-functions> .

dpc:snowflake-ml-jobs a dpc:Technology ;
  skos:prefLabel "Snowflake ML Jobs"@en ;
  dcterms:description "Submits Python functions, files or code bundles from any IDE or from SQL to run as jobs on Container Runtime compute pools, including on multiple nodes."@en ;
  dpc:realises dpc:ml-pipelines ;
  dpc:realises dpc:distributed-training ;
  dpc:realises dpc:continuous-training ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowflake-ml/ml-jobs/overview> .

dpc:snowflake-ml-observability a dpc:Technology ;
  skos:prefLabel "Snowflake ML Observability (model monitors)"@en ;
  dcterms:description "Model monitor objects that compute drift, performance and statistical metrics from logged inference data, with dashboards and threshold alerts."@en ;
  dpc:realises dpc:model-monitoring ;
  dpc:realises dpc:drift-detection ;
  dpc:realises dpc:model-performance-monitoring ;
  dpc:realises dpc:inference-logging ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowflake-ml/model-registry/model-observability> .

dpc:snowflake-model-registry a dpc:Technology ;
  skos:prefLabel "Snowflake Model Registry"@en ;
  dcterms:description "Stores versioned models trained in Snowflake or elsewhere as schema-level objects with metadata, metrics and aliases, and runs their methods from SQL or Python for batch inference."@en ;
  dpc:realises dpc:model-registry ;
  dpc:realises dpc:model-governance ;
  dpc:realises dpc:batch-inference ;
  dpc:realises dpc:model-explainability ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowflake-ml/model-registry/overview> .

dpc:snowflake-model-serving a dpc:Technology ;
  skos:prefLabel "Snowflake Model Serving in Snowpark Container Services"@en ;
  dcterms:description "Deploys registry models as autoscaling CPU or GPU inference services with HTTP endpoints, with gateway-based traffic splitting for shadow and canary releases."@en ;
  dpc:realises dpc:real-time-inference ;
  dpc:realises dpc:canary-ab-testing ;
  dpc:realises dpc:shadow-deployment ;
  dpc:realises dpc:batch-inference ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowflake-ml/model-registry/container> .

dpc:snowflake-multi-cluster-warehouses a dpc:Technology ;
  skos:prefLabel "Snowflake multi-cluster warehouses"@en ;
  dcterms:description "Adds and removes clusters of the same size automatically, according to a scaling policy, to absorb bursts of concurrent queries without queuing."@en ;
  dpc:realises dpc:elastic-scaling ;
  dpc:realises dpc:workload-management ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/warehouses-multicluster> .

dpc:snowflake-native-app-framework a dpc:Technology ;
  skos:prefLabel "Snowflake Native App Framework"@en ;
  dcterms:description "Packages data, code, Streamlit UIs, containers, agents and MCP servers as applications that consumers install and run in their own accounts through listings."@en ;
  skos:altLabel "Snowflake Native Apps"@en ;
  dpc:realises dpc:data-applications ;
  dpc:realises dpc:data-marketplace ;
  dpc:realises dpc:external-data-sharing ;
  dpc:realises dpc:application-sharing ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/native-apps/native-apps-about> .

dpc:snowflake-native-connectors a dpc:Technology ;
  skos:prefLabel "Snowflake native connectors (Snowflake Connectors for ServiceNow, Google Analytics, SharePoint, PostgreSQL and MySQL)"@en ;
  dcterms:description "Connectors packaged as Snowflake Native Apps that ingest and refresh data from SaaS applications and databases incrementally, some using a customer-run agent for change data capture."@en ;
  dpc:realises dpc:saas-connectors ;
  dpc:realises dpc:database-replication ;
  dpc:realises dpc:custom-connectors ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/connectors/servicenow/v2/about> .

dpc:snowflake-network-policies a dpc:Technology ;
  skos:prefLabel "Snowflake network policies and network rules"@en ;
  dcterms:description "Restrict which IP ranges, VPC endpoints or private endpoints can reach an account or user, and which external destinations workloads can reach."@en ;
  dpc:realises dpc:network-security ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/network-policies> .

dpc:snowflake-notebooks a dpc:Technology ;
  skos:prefLabel "Snowflake Notebooks in Workspaces"@en ;
  dcterms:description "Jupyter-compatible notebooks in Snowsight Workspaces that run on Container Runtime CPU or GPU compute, with Git integration, a terminal and scheduling."@en ;
  dpc:realises dpc:notebooks ;
  dpc:realises dpc:model-training ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/ui-snowsight/notebooks-in-workspaces/notebooks-in-workspaces-overview> .

dpc:snowflake-object-tagging a dpc:Technology ;
  skos:prefLabel "Snowflake object tagging"@en ;
  dcterms:description "Schema-level tags with allowed values that are attached to objects and columns, inherited down the hierarchy, and used for classification, cost attribution and tag-based policies."@en ;
  dpc:realises dpc:data-classification ;
  dpc:realises dpc:attribute-based-access ;
  dpc:realises dpc:cost-attribution ;
  dpc:realises dpc:active-metadata ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/object-tagging> .

dpc:snowflake-observe a dpc:Technology ;
  skos:prefLabel "Observe by Snowflake"@en ;
  dcterms:description "An observability platform for logs, metrics and traces, built on a Snowflake lakehouse and available standalone or paid for with Snowflake credits."@en ;
  skos:altLabel "Observe"@en ;
  dpc:realises dpc:observability-analytics ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://www.snowflake.com/en/blog/observe-acquisition-ai-powered-observability/> .

dpc:snowflake-online-feature-store a dpc:Technology ;
  skos:prefLabel "Snowflake Online Feature Store"@en ;
  dcterms:description "Syncs feature views to a low-latency online store and serves them by key through a REST API, with stream and real-time feature views for sub-minute freshness."@en ;
  dpc:realises dpc:online-feature-store ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowflake-ml/feature-store/online-feature-store> .

dpc:snowflake-open-catalog a dpc:Technology ;
  skos:prefLabel "Snowflake Open Catalog"@en ;
  dcterms:description "A separate managed Apache Polaris service that acts as an Iceberg REST catalogue with central access control for Iceberg tables shared across engines."@en ;
  skos:altLabel "Polaris Catalog"@en ;
  dpc:realises dpc:table-catalogue ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:credential-vending ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/opencatalog/overview> .

dpc:snowflake-open-data-sharing a dpc:Technology ;
  skos:prefLabel "Snowflake Open Data Sharing"@en ;
  dcterms:description "Shares Iceberg tables as live, read-only data with external consumers outside Snowflake, who read them through standard Iceberg REST Catalog APIs using a programmatic access token."@en ;
  dpc:realises dpc:external-data-sharing ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:open-protocol-sharing ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/user-guide/open-data-sharing> .

dpc:snowflake-openflow a dpc:Technology ;
  skos:prefLabel "Snowflake Openflow"@en ;
  dcterms:description "A managed integration service, built on Apache NiFi, that runs prebuilt and custom connectors for databases, SaaS, streams and unstructured content in batch or streaming mode."@en ;
  dpc:realises dpc:change-data-capture ;
  dpc:realises dpc:saas-connectors ;
  dpc:realises dpc:unstructured-ingestion ;
  dpc:realises dpc:streaming-ingestion ;
  dpc:realises dpc:custom-connectors ;
  dpc:realises dpc:hybrid-data-plane ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/data-integration/openflow/about> .

dpc:snowflake-organizations a dpc:Technology ;
  skos:prefLabel "Snowflake organisations"@en ;
  dcterms:description "Group multiple Snowflake accounts across regions and clouds under one organisation for account creation, organisation-wide usage views, organisation users and organisational listings."@en ;
  skos:altLabel "Snowflake organizations"@en ;
  dpc:realises dpc:multi-tenancy ;
  dpc:realises dpc:self-service-provisioning ;
  dpc:realises dpc:deployment-options ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/organizations> .

dpc:snowflake-pandas-on-snowflake a dpc:Technology ;
  skos:prefLabel "pandas on Snowflake"@en ;
  dcterms:description "A Modin-based pandas API that turns pandas operations on Snowflake data into SQL, and chooses per operation whether to run them locally or in Snowflake (hybrid execution)."@en ;
  skos:altLabel "Snowpark pandas API"@en ;
  dpc:realises dpc:dataframe-apis ;
  dpc:realises dpc:single-node-processing ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowpark/python/pandas-on-snowflake> .

dpc:snowflake-pg-lake a dpc:Technology ;
  skos:prefLabel "pg_lake"@en ;
  dcterms:description "An open-source Postgres extension from Snowflake that reads and writes Iceberg tables and Parquet files in object storage from Postgres."@en ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:open-table-formats ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-postgres/postgres-pg_lake> .

dpc:snowflake-postgres a dpc:Technology ;
  skos:prefLabel "Snowflake Postgres"@en ;
  dcterms:description "Fully managed PostgreSQL instances, on versions 16 to 18, created and governed from Snowflake, running on dedicated Snowflake-managed machines with PgBouncer pooling and private networking."@en ;
  dpc:realises dpc:operational-database ;
  dpc:realises dpc:low-latency-serving ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-postgres/about> .

dpc:snowflake-postgres-data-mirroring a dpc:Technology ;
  skos:prefLabel "Data mirroring for Snowflake Postgres"@en ;
  dcterms:description "Continuously replicates Postgres tables or whole schemas into Snowflake tables from the write-ahead log, with sub-minute lag and source transaction boundaries kept."@en ;
  dpc:realises dpc:database-replication ;
  dpc:realises dpc:change-data-capture ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowflake-postgres/postgres-data-mirroring> .

dpc:snowflake-private-connectivity a dpc:Technology ;
  skos:prefLabel "Snowflake private connectivity (AWS PrivateLink, Azure Private Link, Google Cloud Private Service Connect)"@en ;
  dcterms:description "Connects clients, internal stages and Snowflake-hosted endpoints to Snowflake over the cloud provider's private network rather than the public internet."@en ;
  skos:altLabel "Snowflake PrivateLink"@en ;
  dpc:realises dpc:network-security ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/admin-security-privatelink> .

dpc:snowflake-projection-policies a dpc:Technology ;
  skos:prefLabel "Snowflake projection policies"@en ;
  dcterms:description "Stop a column from being returned in query output while still allowing it in joins, filters and aggregations."@en ;
  dpc:realises dpc:privacy-enhancing-technologies ;
  dpc:realises dpc:column-masking ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/projection-policies> .

dpc:snowflake-query-acceleration-service a dpc:Technology ;
  skos:prefLabel "Snowflake Query Acceleration Service"@en ;
  dcterms:description "Offloads parts of large scans and filters in eligible queries to shared serverless compute, so outlier queries finish faster without enlarging the warehouse."@en ;
  skos:altLabel "QAS"@en ;
  dpc:realises dpc:query-acceleration ;
  dpc:realises dpc:elastic-scaling ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/query-acceleration-service> .

dpc:snowflake-query-profile a dpc:Technology ;
  skos:prefLabel "Snowflake Query History, Query Profile and query insights"@en ;
  dcterms:description "Snowsight views of query history, operator-level execution plans and automatic insights, used to diagnose slow or expensive queries."@en ;
  dpc:realises dpc:query-performance-analysis ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/ui-snowsight-activity> .

dpc:snowflake-replication-failover a dpc:Technology ;
  skos:prefLabel "Snowflake replication and failover groups"@en ;
  dcterms:description "Replicate databases, users, roles, warehouses, policies and integrations to accounts in other regions or clouds, with promotion on failover and client redirect through connection objects."@en ;
  dpc:realises dpc:cross-region-failover ;
  dpc:realises dpc:cross-region-sharing ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/account-replication-intro> .

dpc:snowflake-resource-monitors a dpc:Technology ;
  skos:prefLabel "Snowflake resource monitors"@en ;
  dcterms:description "Credit quotas on warehouses or the whole account that notify or suspend warehouses when thresholds are reached."@en ;
  dpc:realises dpc:spend-controls ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/resource-monitors> .

dpc:snowflake-result-cache a dpc:Technology ;
  skos:prefLabel "Snowflake persisted query results (result cache)"@en ;
  dcterms:description "Returns the stored result of an identical earlier query, for 24 hours and up to 31 days with reuse, when the underlying data has not changed, without using warehouse compute."@en ;
  dpc:realises dpc:result-caching ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/querying-persisted-results> .

dpc:snowflake-row-access-policies a dpc:Technology ;
  skos:prefLabel "Snowflake row access policies"@en ;
  dcterms:description "Schema-level policies that decide, using the querying role and mapping tables, which rows of a table or view a query returns."@en ;
  dpc:realises dpc:row-level-security ;
  dpc:realises dpc:attribute-based-access ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/security-row-intro> .

dpc:snowflake-search-optimization-service a dpc:Technology ;
  skos:prefLabel "Snowflake Search Optimization Service"@en ;
  dcterms:description "Builds and maintains a persistent search access path on chosen tables and columns, so point lookups, substring, semi-structured, geospatial and full-text SEARCH queries skip most micro-partitions."@en ;
  skos:altLabel "search optimization"@en ;
  dpc:realises dpc:data-skipping-indexes ;
  dpc:realises dpc:full-text-search ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/search-optimization-service> .

dpc:snowflake-secrets a dpc:Technology ;
  skos:prefLabel "Snowflake secrets"@en ;
  dcterms:description "Schema-level secret objects that hold credentials, OAuth tokens and keys for integrations, UDFs, Openflow and container services, so code does not contain them."@en ;
  dpc:realises dpc:secrets-management ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/sql-reference/sql/create-secret> .

dpc:snowflake-secure-data-sharing a dpc:Technology ;
  skos:prefLabel "Snowflake Secure Data Sharing"@en ;
  dcterms:description "Shares live, read-only database objects with other Snowflake accounts through shares, without copying data, with consumers paying for their own compute."@en ;
  dpc:realises dpc:internal-data-sharing ;
  dpc:realises dpc:external-data-sharing ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/data-sharing-intro> .

dpc:snowflake-semantic-views a dpc:Technology ;
  skos:prefLabel "Snowflake semantic views"@en ;
  dcterms:description "Schema-level objects that define logical tables, relationships, facts, dimensions and metrics, queried with SQL and used by Cortex Analyst, agents and BI tools."@en ;
  dpc:realises dpc:semantic-layer ;
  dpc:realises dpc:metric-definitions ;
  dpc:realises dpc:semantic-model-interchange ;
  dpc:realises dpc:ai-context-layer ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/views-semantic/overview> .

dpc:snowflake-semi-structured-data a dpc:Technology ;
  skos:prefLabel "Snowflake semi-structured data types (VARIANT, OBJECT, ARRAY)"@en ;
  dcterms:description "Stores JSON, Avro, ORC, Parquet and XML in VARIANT, OBJECT and ARRAY columns, extracting columns for pruning, and queries them with path notation and FLATTEN."@en ;
  dpc:realises dpc:semi-structured-data ;
  dpc:realises dpc:file-formats ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/semistructured-intro> .

dpc:snowflake-sensitive-data-classification a dpc:Technology ;
  skos:prefLabel "Snowflake sensitive data classification"@en ;
  dcterms:description "Scans tables in databases with a classification profile, assigns semantic and privacy categories to sensitive columns, and can map them to your own tags automatically."@en ;
  dpc:realises dpc:data-classification ;
  dpc:realises dpc:data-security-posture ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/classify-intro> .

dpc:snowflake-snowconvert-ai a dpc:Technology ;
  skos:prefLabel "SnowConvert AI"@en ;
  dcterms:description "A migration tool that assesses and converts SQL code and objects from Teradata, Oracle, SQL Server, Redshift, Synapse, BigQuery, Databricks SQL and other platforms to Snowflake."@en ;
  skos:altLabel "SnowConvert"@en ;
  dpc:realises dpc:code-translation ;
  dpc:realises dpc:ai-assisted-development ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/migrations/snowconvert-docs/overview> .

dpc:snowflake-snowpark a dpc:Technology ;
  skos:prefLabel "Snowpark"@en ;
  dcterms:description "DataFrame and function APIs for Python, Java and Scala that push processing down into Snowflake warehouses as SQL, plus runtimes for running that code in the engine."@en ;
  dpc:realises dpc:dataframe-apis ;
  dpc:realises dpc:user-defined-functions ;
  dpc:realises dpc:distributed-processing ;
  dpc:realises dpc:runtime-management ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowpark/index> .

dpc:snowflake-snowpark-connect-for-spark a dpc:Technology ;
  skos:prefLabel "Snowpark Connect for Apache Spark"@en ;
  dcterms:description "Runs existing Spark DataFrame and Spark SQL code on Snowflake compute through the Spark Connect protocol, so there is no Spark cluster to manage."@en ;
  skos:altLabel "Snowpark Connect"@en ;
  dpc:realises dpc:dataframe-apis ;
  dpc:realises dpc:distributed-processing ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowpark-connect/snowpark-connect-overview> .

dpc:snowflake-snowpark-container-services a dpc:Technology ;
  skos:prefLabel "Snowpark Container Services"@en ;
  dcterms:description "Runs OCI container images as long-running services or finite jobs on Snowflake-managed compute pools, including GPU nodes, inside the account's security boundary."@en ;
  skos:altLabel "SPCS"@en ;
  dpc:realises dpc:container-services ;
  dpc:realises dpc:gpu-compute ;
  dpc:realises dpc:data-applications ;
  dpc:realises dpc:object-file-access ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/snowpark-container-services/overview> .

dpc:snowflake-snowpark-optimized-warehouses a dpc:Technology ;
  skos:prefLabel "Snowpark-optimized warehouses"@en ;
  dcterms:description "Warehouses with much more memory per node, and configurable CPU architecture, for memory-intensive Snowpark, UDF and single-node ML training work."@en ;
  dpc:realises dpc:provisioned-compute ;
  dpc:realises dpc:model-training ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/warehouses-snowpark-optimized> .

dpc:snowflake-snowpipe a dpc:Technology ;
  skos:prefLabel "Snowpipe"@en ;
  dcterms:description "A serverless pipe that loads files continuously from stages as they arrive, triggered by cloud storage event notifications or REST calls."@en ;
  dpc:realises dpc:file-ingestion ;
  dpc:realises dpc:event-driven-triggering ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/data-load-snowpipe-intro> .

dpc:snowflake-snowpipe-streaming a dpc:Technology ;
  skos:prefLabel "Snowpipe Streaming"@en ;
  dcterms:description "Ingests rows directly into tables through SDKs (Java, Python, Node.js) or a REST API, with no files, making data queryable within seconds."@en ;
  dpc:realises dpc:streaming-ingestion ;
  dpc:realises dpc:iot-ingestion ;
  dpc:realises dpc:idempotent-loading ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/snowpipe-streaming/data-load-snowpipe-streaming-overview> .

dpc:snowflake-snowsight-dashboards a dpc:Technology ;
  skos:prefLabel "Snowsight dashboards"@en ;
  dcterms:description "Simple dashboards built from charts and tables of query results in Snowsight, shared with other Snowflake users."@en ;
  dpc:realises dpc:dashboards-reports ;
  dpc:realises dpc:ad-hoc-analysis ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/ui-snowsight-dashboards> .

dpc:snowflake-stages-directory-tables a dpc:Technology ;
  skos:prefLabel "Snowflake stages and directory tables"@en ;
  dcterms:description "Internal and external stages hold files in object storage, and directory tables catalogue the staged files with metadata so unstructured content can be listed, governed and processed with SQL."@en ;
  dpc:realises dpc:object-storage ;
  dpc:realises dpc:unstructured-data ;
  dpc:realises dpc:unstructured-ingestion ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/data-load-dirtables> .

dpc:snowflake-storage-lifecycle-policies a dpc:Technology ;
  skos:prefLabel "Snowflake storage lifecycle policies"@en ;
  dcterms:description "Schema-level policies that archive table rows to cheaper COOL or COLD tiers, or delete them permanently, according to conditions such as age."@en ;
  dpc:realises dpc:storage-tiering ;
  dpc:realises dpc:data-retention ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/storage-management/storage-lifecycle-policies> .

dpc:snowflake-streamlit a dpc:Technology ;
  skos:prefLabel "Streamlit in Snowflake"@en ;
  dcterms:description "Hosts Streamlit Python apps as Snowflake objects, on warehouse or container runtimes, with access governed by Snowflake roles."@en ;
  skos:altLabel "SiS"@en ;
  dpc:realises dpc:data-applications ;
  dpc:realises dpc:dashboards-reports ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/streamlit/about-streamlit> .

dpc:snowflake-streams a dpc:Technology ;
  skos:prefLabel "Snowflake streams"@en ;
  dcterms:description "Track inserts, updates and deletes on tables, views and other objects since an offset, so downstream jobs process only the changes."@en ;
  dpc:realises dpc:change-feeds ;
  dpc:realises dpc:incremental-processing ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/streams-intro> .

dpc:snowflake-synthetic-data a dpc:Technology ;
  skos:prefLabel "Snowflake synthetic data generation"@en ;
  dcterms:description "The GENERATE_SYNTHETIC_DATA procedure creates statistically similar tables, with the same column names and types, from up to five source tables without linking output rows to real records."@en ;
  dpc:realises dpc:synthetic-data ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/synthetic-data> .

dpc:snowflake-tasks a dpc:Technology ;
  skos:prefLabel "Snowflake tasks and task graphs"@en ;
  dcterms:description "Run SQL, procedures or code on a schedule, in dependency graphs, or when a stream has new data, on serverless or user-managed compute."@en ;
  dpc:realises dpc:workflow-orchestration ;
  dpc:realises dpc:event-driven-triggering ;
  dpc:realises dpc:pipeline-monitoring ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/tasks-intro> .

dpc:snowflake-terraform-provider a dpc:Technology ;
  skos:prefLabel "Snowflake Terraform provider"@en ;
  dcterms:description "A Terraform provider for managing Snowflake accounts, warehouses, databases, roles, grants and policies as code."@en ;
  dpc:realises dpc:infrastructure-as-code ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/terraform> .

dpc:snowflake-time-series-functions a dpc:Technology ;
  skos:prefLabel "Snowflake time-series functions (ASOF JOIN, TIME_SLICE, RESAMPLE)"@en ;
  dcterms:description "SQL constructs for aligning, bucketing and joining time-stamped data, including ASOF JOIN and gap filling."@en ;
  dpc:realises dpc:time-series-data ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/querying-time-series-data> .

dpc:snowflake-time-travel a dpc:Technology ;
  skos:prefLabel "Snowflake Time Travel"@en ;
  dcterms:description "Queries, clones or undrops tables, schemas and databases as they were at an earlier point within a retention period of up to 90 days."@en ;
  dpc:realises dpc:time-travel ;
  dpc:realises dpc:backup-restore ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/data-time-travel> .

dpc:snowflake-trail a dpc:Technology ;
  skos:prefLabel "Snowflake Trail (event tables, logging, tracing and metrics)"@en ;
  dcterms:description "Collects logs, OpenTelemetry-style traces and metrics from UDFs, procedures, Snowpark, Native Apps, container services and pipelines into event tables, with Snowsight dashboards."@en ;
  skos:altLabel "Snowflake event tables"@en ;
  dpc:realises dpc:platform-observability ;
  dpc:realises dpc:pipeline-monitoring ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/developer-guide/logging-tracing/logging-tracing-overview> .

dpc:snowflake-tri-secret-secure a dpc:Technology ;
  skos:prefLabel "Snowflake Tri-Secret Secure"@en ;
  dcterms:description "Combines a Snowflake-maintained key with a customer-managed key in the cloud provider's KMS to create the composite master key for account data, so revoking the customer key makes data unreadable."@en ;
  dpc:realises dpc:customer-managed-keys ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/security-encryption-manage> .

dpc:snowflake-trust-center a dpc:Technology ;
  skos:prefLabel "Snowflake Trust Center"@en ;
  dcterms:description "Runs scanner packages (Security Essentials, CIS Benchmarks, Threat Intelligence, AI Security) against accounts and reports violations, detections and at-risk entities."@en ;
  dpc:realises dpc:data-security-posture ;
  dpc:realises dpc:compliance-evidence ;
  dpc:realises dpc:audit-logging ;
  dpc:realises dpc:data-threat-detection ;
  dpc:platform dpc:platform-snowflake ;
  rdfs:seeAlso <https://docs.snowflake.com/en/user-guide/trust-center/overview> .

dpc:snowflake-udfs-and-procedures a dpc:Technology ;
  skos:prefLabel "Snowflake user-defined functions and stored procedures"@en ;
  dcterms:description "Custom scalar, table and aggregate functions and stored procedures written in SQL, Snowflake Scripting, JavaScript, Python, Java or Scala that run inside Snowflake."@en ;
  dpc:realises dpc:user-defined-functions ;
  dpc:platform dpc:platform-snowflake ;
