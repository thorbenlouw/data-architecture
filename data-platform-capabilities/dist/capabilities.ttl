  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/data-factory/data-factory-overview> .

dpc:fabric-private-links a dpc:Technology ;
  skos:prefLabel "Private links for Microsoft Fabric"@en ;
  dcterms:description "Restricts inbound access to a Fabric tenant or to individual workspaces through Azure Private Link, with managed virtual networks for Spark."@en ;
  dpc:realises dpc:network-security ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/security/security-private-links-overview> .

dpc:fabric-real-time-dashboards a dpc:Technology ;
  skos:prefLabel "Fabric Real-Time Dashboard"@en ;
  dcterms:description "Dashboards built on KQL queries over Eventhouse data, refreshing continuously for operational monitoring."@en ;
  dpc:realises dpc:dashboards-reports ;
  dpc:realises dpc:real-time-analytics ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/real-time-intelligence/dashboard-real-time-create> .

dpc:fabric-real-time-hub a dpc:Technology ;
  skos:prefLabel "Fabric Real-Time hub"@en ;
  dcterms:description "A tenant-wide catalogue of streams and system events (Fabric, OneLake, job and Azure events) that users can discover, subscribe to and route."@en ;
  dpc:realises dpc:event-driven-triggering ;
  dpc:realises dpc:event-api-catalogue ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/real-time-hub/real-time-hub-overview> .

dpc:fabric-semantic-link a dpc:Technology ;
  skos:prefLabel "Fabric semantic link (SemPy)"@en ;
  dcterms:description "A Python library and Spark connector that lets notebooks read Power BI semantic models, evaluate their measures and use their relationships."@en ;
  skos:altLabel "SemPy"@en ;
  dpc:realises dpc:dataframe-apis ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/data-science/semantic-link-overview> .

dpc:fabric-spark a dpc:Technology ;
  skos:prefLabel "Apache Spark in Microsoft Fabric"@en ;
  dcterms:description "Managed Spark runtime with starter pools, custom pools and a native vectorised execution engine for data engineering and data science jobs."@en ;
  skos:altLabel "Fabric Spark"@en ;
  skos:altLabel "Native Execution Engine"@en ;
  dpc:realises dpc:distributed-processing ;
  dpc:realises dpc:dataframe-apis ;
  dpc:realises dpc:stream-processing ;
  dpc:realises dpc:serverless-compute ;
  dpc:realises dpc:native-execution-acceleration ;
  dpc:realises dpc:runtime-management ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/data-engineering/data-engineering-overview> .

dpc:fabric-sql-analytics-endpoint a dpc:Technology ;
  skos:prefLabel "Fabric SQL analytics endpoint"@en ;
  dcterms:description "An automatically created, read-only T-SQL endpoint over the Delta tables of a lakehouse, mirrored database or SQL database."@en ;
  dpc:realises dpc:sql-access ;
  dpc:realises dpc:sql-query-engine ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/data-warehouse/data-warehousing> .

dpc:fabric-sql-database a dpc:Technology ;
  skos:prefLabel "SQL database in Microsoft Fabric"@en ;
  dcterms:description "A SaaS operational database on the Azure SQL Database engine whose tables are replicated automatically into OneLake for analytics."@en ;
  dpc:realises dpc:operational-database ;
  dpc:realises dpc:database-replication ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/database/sql/overview> .

dpc:fabric-terraform-provider a dpc:Technology ;
  skos:prefLabel "Terraform Provider for Microsoft Fabric"@en ;
  dcterms:description "A Terraform provider for creating and managing Fabric capacities, workspaces, items, role assignments and related resources as code."@en ;
  dpc:realises dpc:infrastructure-as-code ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://github.com/microsoft/terraform-provider-fabric> .

dpc:fabric-user-data-functions a dpc:Technology ;
  skos:prefLabel "Fabric user data functions"@en ;
  dcterms:description "Serverless Python functions hosted in Fabric, each with a REST endpoint, callable from pipelines, notebooks, Activator rules and Power BI reports."@en ;
  dpc:realises dpc:user-defined-functions ;
  dpc:realises dpc:data-applications ;
  dpc:realises dpc:data-apis ;
  dpc:realises dpc:data-writeback ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/data-engineering/user-data-functions/user-data-functions-overview> .

dpc:fabric-variable-library a dpc:Technology ;
  skos:prefLabel "Fabric variable library"@en ;
  dcterms:description "A workspace item holding variables with value sets per stage, consumed by pipelines, notebooks, shortcuts, dataflows and other items."@en ;
  dpc:realises dpc:environment-promotion ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/cicd/variable-library/variable-library-overview> .

dpc:fabric-warehouse-time-travel a dpc:Technology ;
  skos:prefLabel "Time travel in Fabric Data Warehouse"@en ;
  dcterms:description "Queries warehouse tables as they were at an earlier timestamp within a retention window, with read-only warehouse snapshots for stable reporting."@en ;
  dpc:realises dpc:time-travel ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/data-warehouse/time-travel> .

dpc:fabric-warehouse-zero-copy-clone a dpc:Technology ;
  skos:prefLabel "Fabric Data Warehouse zero-copy table clone"@en ;
  dcterms:description "Creates a copy of a warehouse table, at the current or a past point in time, that shares the underlying files with the original."@en ;
  dpc:realises dpc:zero-copy-cloning ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/data-warehouse/clone-table> .

dpc:fabric-workspace-identity a dpc:Technology ;
  skos:prefLabel "Fabric workspace identity"@en ;
  dcterms:description "A Microsoft Entra identity managed by Fabric for a workspace, used to authenticate to ADLS, Event Hubs and other sources without stored secrets."@en ;
  dpc:realises dpc:identity-authentication ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/security/workspace-identity> .

dpc:fabric-workspace-monitoring a dpc:Technology ;
  skos:prefLabel "Fabric workspace monitoring"@en ;
  dcterms:description "Collects logs and metrics from warehouses, pipelines, Eventhouses, semantic models and other items into a KQL database for querying and alerting."@en ;
  dpc:realises dpc:platform-observability ;
  dpc:realises dpc:pipeline-monitoring ;
  dpc:realises dpc:query-performance-analysis ;
  dpc:realises dpc:system-telemetry ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/fundamentals/workspace-monitoring-overview> .

dpc:fabric-workspaces a dpc:Technology ;
  skos:prefLabel "Fabric workspaces"@en ;
  dcterms:description "Containers for Fabric items with their own roles, capacity assignment, Git connection and network settings."@en ;
  dpc:realises dpc:multi-tenancy ;
  dpc:realises dpc:role-based-access ;
  dpc:realises dpc:analytical-sandboxes ;
  dpc:platform dpc:platform-microsoft ;
  rdfs:seeAlso <https://learn.microsoft.com/en-us/fabric/fundamentals/workspaces> .

dpc:fairness-assessment a skos:Concept ;
  skos:prefLabel "Bias and fairness assessment"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:model-evaluation ;
  skos:broader dpc:model-monitoring ;
  skos:related dpc:model-governance ;
  skos:related dpc:ai-impact-assessment ;
  skos:related dpc:data-classification ;
  skos:related dpc:drift-detection ;
  skos:related dpc:privacy-impact-assessment ;
  skos:definition "Measure whether a model's outcomes differ unfairly across groups of people."@en .

dpc:feast a dpc:Technology ;
  skos:prefLabel "Feast"@en ;
  dcterms:description "Feature store that defines features once and serves them from offline stores for training and online stores for low-latency inference, with point-in-time correct joins."@en ;
  dpc:realises dpc:feature-store ;
  dpc:realises dpc:offline-feature-store ;
  dpc:realises dpc:online-feature-store ;
  dpc:realises dpc:point-in-time-joins ;
  dpc:platform dpc:platform-open-source ;
  rdfs:seeAlso <https://docs.feast.dev/> .

dpc:feature-engineering a skos:Concept ;
  skos:prefLabel "Feature engineering"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:machine-learning ;
  skos:related dpc:stream-processing ;
  skos:related dpc:transformation-as-code ;
  skos:related dpc:dataframe-apis ;
  skos:related dpc:data-quality-rules ;
  skos:definition "Turn raw data into model inputs in reusable, consistent pipelines."@en .

dpc:feature-store a skos:Concept ;
  skos:prefLabel "Feature store"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:machine-learning ;
  skos:related dpc:data-catalogue ;
  skos:related dpc:low-latency-serving ;
  skos:related dpc:model-lineage ;
  skos:related dpc:data-classification ;
  dpc:dependsOn dpc:feature-engineering ;
  skos:definition "Manage features centrally so they are reused, documented and served consistently for training and inference."@en .

dpc:fiddler-ai-control-plane a dpc:Technology ;
  skos:prefLabel "Fiddler AI Control Plane"@en ;
  dcterms:description "Monitoring, explainability and guardrails for ML models, LLM applications and agents, using Fiddler's own small evaluation models to score outputs quickly."@en ;
  skos:altLabel "Fiddler"@en ;
  dpc:realises dpc:model-performance-monitoring ;
  dpc:realises dpc:genai-observability ;
  dpc:realises dpc:ai-guardrails ;
  dpc:realises dpc:model-explainability ;
  dpc:realises dpc:drift-detection ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://www.fiddler.ai/> .

dpc:file-formats a skos:Concept ;
  skos:prefLabel "Open file formats"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:storage ;
  skos:related dpc:engine-interoperability ;
  skos:related dpc:semi-structured-data ;
