  dpc:realises dpc:incremental-processing ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/materialized-views-intro> .

dpc:gcp-bigquery-migration-service a dpc:Technology ;
  skos:prefLabel "BigQuery Migration Service"@en ;
  dcterms:description "Tooling for moving warehouses to BigQuery, covering assessment, batch and interactive SQL translation, data transfer and validation."@en ;
