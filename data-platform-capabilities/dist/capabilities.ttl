dpc:fivetran-activations a dpc:Technology ;
  skos:prefLabel "Fivetran Activations"@en ;
  dcterms:description "Syncs modelled data from a warehouse or lake back into operational tools such as CRM, advertising and marketing platforms."@en ;
  skos:altLabel "Census"@en ;
  dpc:realises dpc:reverse-etl ;
  dpc:realises dpc:audience-activation ;
  dpc:platform dpc:platform-independent ;
