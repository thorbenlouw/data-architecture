dpc:varonis-data-security-platform a dpc:Technology ;
  skos:prefLabel "Varonis Data Security Platform"@en ;
  dcterms:description "Classifies sensitive data, maps permissions and monitors activity across file shares, SaaS, cloud and databases to remove excess access and detect threats to data."@en ;
  dpc:realises dpc:data-security-posture ;
  dpc:realises dpc:data-classification ;
  dpc:realises dpc:audit-logging ;
  dpc:realises dpc:data-retention ;
  dpc:realises dpc:data-threat-detection ;
  dpc:realises dpc:data-breach-response ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://www.varonis.com/> .

dpc:vector-search a skos:Concept ;
