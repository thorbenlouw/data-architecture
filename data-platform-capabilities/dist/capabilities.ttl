@prefix dpc: <https://example.org/data-platform-capabilities/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

dpc:capabilities a skos:ConceptScheme ;
  skos:prefLabel "Data platform capabilities"@en ;
  skos:hasTopConcept dpc:ingestion-integration ,
  skos:hasTopConcept dpc:storage ,
  skos:hasTopConcept dpc:processing ,
  skos:hasTopConcept dpc:orchestration ,
  skos:hasTopConcept dpc:compute ,
  skos:hasTopConcept dpc:serving ,
  skos:hasTopConcept dpc:analytics-bi ,
  skos:hasTopConcept dpc:machine-learning ,
  skos:hasTopConcept dpc:mlops ,
  skos:hasTopConcept dpc:generative-ai ,
  skos:hasTopConcept dpc:metadata ,
  skos:hasTopConcept dpc:data-quality ,
  skos:hasTopConcept dpc:master-data ,
  skos:hasTopConcept dpc:governance ,
  skos:hasTopConcept dpc:security ,
  skos:hasTopConcept dpc:data-sharing ,
  skos:hasTopConcept dpc:data-products ,
  skos:hasTopConcept dpc:development-lifecycle ,
  skos:hasTopConcept dpc:platform-operations ,
  skos:hasTopConcept dpc:specialised-data .

dpc:Technology a rdfs:Class .
dpc:Pattern a rdfs:Class .
dpc:Persona a rdfs:Class .
dpc:UseCase a rdfs:Class .
dpc:MaturityTrack a rdfs:Class .
dpc:Platform a rdfs:Class .
dpc:Framework a rdfs:Class .
dpc:Reference a rdfs:Class .
dpc:dependsOn a rdf:Property .
dpc:realises a rdf:Property .
dpc:platform a rdf:Property .
dpc:uses a rdf:Property .
dpc:caresAbout a rdf:Property .
dpc:requires a rdf:Property .
dpc:benefitsFrom a rdf:Property .
dpc:covers a rdf:Property .
dpc:mapsTo a rdf:Property .
dpc:involvesPersona a rdf:Property .
dpc:usesPattern a rdf:Property .
dpc:distributionOf a rdf:Property .

dpc:access-control a skos:Concept ;
  skos:prefLabel "Access control"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:security ;
  skos:related dpc:data-policy-management ;
  skos:related dpc:data-classification ;
  skos:related dpc:identity-authentication ;
  skos:related dpc:audit-logging ;
  skos:related dpc:table-catalogue ;
  dpc:dependsOn dpc:identity-authentication ;
  skos:altLabel "authorisation"@en ;
  skos:altLabel "permissions"@en ;
  skos:altLabel "entitlements"@en ;
  skos:altLabel "least privilege"@en ;
  skos:altLabel "fine-grained access control"@en ;
  skos:definition "Decide who can see and change which data, at every level from account down to individual values."@en .

dpc:access-requests a skos:Concept ;
  skos:prefLabel "Access requests and reviews"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:access-control ;
  skos:related dpc:data-ownership ;
  skos:related dpc:data-catalogue ;
  skos:related dpc:data-marketplace ;
  skos:related dpc:usage-metadata ;
  skos:related dpc:role-based-access ;
  dpc:dependsOn dpc:data-ownership ;
  dpc:dependsOn dpc:role-based-access ;
  skos:altLabel "access governance"@en ;
  skos:altLabel "entitlement reviews"@en ;
  skos:altLabel "access recertification"@en ;
  skos:altLabel "access reviews"@en ;
  skos:altLabel "user access reviews"@en ;
  skos:altLabel "access packages"@en ;
  skos:definition "Let people request access to data, have owners approve and time-limit it, and review existing access on a regular cycle."@en .

dpc:acid-transactions a skos:Concept ;
  skos:prefLabel "ACID transactions"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:open-table-formats ;
  skos:related dpc:row-level-updates ;
  skos:related dpc:idempotent-loading ;
  skos:related dpc:time-travel ;
  skos:related dpc:table-catalogue ;
  skos:related dpc:change-data-capture ;
  skos:definition "Commit concurrent writes atomically so readers never see partial or conflicting results."@en .

dpc:active-metadata a skos:Concept ;
  skos:prefLabel "Active metadata"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:metadata ;
  skos:related dpc:data-policy-management ;
  skos:related dpc:attribute-based-access ;
  skos:related dpc:data-observability ;
  skos:related dpc:event-driven-triggering ;
  skos:related dpc:data-certification ;
  dpc:dependsOn dpc:data-catalogue ;
  dpc:dependsOn dpc:metadata-interoperability ;
  skos:definition "Use metadata to trigger actions automatically, such as propagating tags, alerting owners or blocking bad data."@en .

dpc:ad-hoc-analysis a skos:Concept ;
  skos:prefLabel "Ad hoc analysis"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:analytics-bi ;
  skos:related dpc:notebooks ;
  skos:related dpc:workload-isolation ;
  skos:related dpc:data-catalogue ;
  skos:related dpc:spend-controls ;
  skos:related dpc:data-preparation ;
  dpc:dependsOn dpc:sql-query-engine ;
  dpc:dependsOn dpc:sql-access ;
  skos:altLabel "self-service analytics"@en ;
  skos:altLabel "exploration"@en ;
  skos:definition "Explore data freely with SQL editors, pivots and visual exploration to answer one-off questions."@en .

dpc:agent-identity a skos:Concept ;
  skos:prefLabel "Agent identity and authorisation"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:ai-agents ;
  skos:broader dpc:access-control ;
  skos:related dpc:permission-aware-retrieval ;
  skos:related dpc:audit-logging ;
  skos:related dpc:secrets-management ;
  skos:related dpc:agent-tool-access ;
  skos:related dpc:agent-registry ;
  dpc:dependsOn dpc:identity-authentication ;
  skos:altLabel "on-behalf-of access"@en ;
  skos:altLabel "agent permissions"@en ;
  skos:definition "Give each agent its own identity and scoped, short-lived access to data on behalf of named users, enforced at request time."@en .

dpc:agent-interoperability a skos:Concept ;
  skos:prefLabel "Agent-to-agent interoperability"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:ai-agents ;
  skos:related dpc:agent-registry ;
  skos:related dpc:agent-tool-access ;
  skos:related dpc:application-integration ;
  skos:related dpc:genai-observability ;
  dpc:dependsOn dpc:agent-identity ;
  skos:altLabel "A2A"@en ;
  skos:definition "Let agents built on different platforms discover, delegate to and call each other through open protocols."@en .

dpc:agent-memory a skos:Concept ;
  skos:prefLabel "Agent memory"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:ai-agents ;
  skos:related dpc:data-retention ;
  skos:related dpc:data-subject-requests ;
  skos:related dpc:low-latency-serving ;
  skos:related dpc:vector-search ;
  skos:related dpc:permission-aware-retrieval ;
  skos:definition "Store and recall conversation state and long-term facts for agents across sessions, with retention controls."@en .

dpc:agent-registry a skos:Concept ;
  skos:prefLabel "Agent and tool registry"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:ai-agents ;
  skos:broader dpc:ai-governance ;
  skos:related dpc:model-registry ;
  skos:related dpc:ai-system-discovery ;
  skos:related dpc:data-catalogue ;
  skos:related dpc:agent-tool-access ;
  skos:related dpc:agent-identity ;
  skos:altLabel "MCP registry"@en ;
  skos:altLabel "agent catalogue"@en ;
  skos:definition "Keep a governed inventory of agents, tools and MCP servers with owners and permissions so they can be found, approved and controlled."@en .

dpc:agent-runtime a skos:Concept ;
  skos:prefLabel "Agent hosting and runtime"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:ai-agents ;
  skos:related dpc:container-services ;
  skos:related dpc:serverless-compute ;
  skos:related dpc:compute-user-isolation ;
  skos:related dpc:workflow-orchestration ;
  skos:related dpc:genai-observability ;
  skos:altLabel "agent engine"@en ;
  skos:altLabel "agent sandbox"@en ;
  skos:definition "Deploy and run agents as managed services with identity, durable state, scaling and sandboxed code execution."@en .

dpc:agent-tool-access a skos:Concept ;
  skos:prefLabel "Agent tool and data access"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:ai-agents ;
  skos:related dpc:data-apis ;
  skos:related dpc:ai-context-layer ;
  skos:related dpc:semantic-layer ;
  skos:related dpc:audit-logging ;
  dpc:dependsOn dpc:access-control ;
  skos:altLabel "MCP servers"@en ;
  skos:altLabel "function calling"@en ;
  skos:altLabel "tool use"@en ;
  skos:definition "Give agents governed access to data and actions through tools and protocols such as MCP."@en .

dpc:agent2agent-protocol a dpc:Technology ;
  skos:prefLabel "Agent2Agent (A2A) protocol"@en ;
  dcterms:description "Open protocol for AI agents built on different frameworks to discover each other's capabilities and delegate tasks to one another."@en ;
  skos:altLabel "A2A"@en ;
  skos:altLabel "Agent2Agent"@en ;
  dpc:realises dpc:agent-interoperability ;
  dpc:platform dpc:platform-open-source ;
  rdfs:seeAlso <https://a2a-protocol.org/> .

dpc:ai-agents a skos:Concept ;
  skos:prefLabel "AI agents"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:generative-ai ;
  skos:related dpc:ai-guardrails ;
  skos:related dpc:genai-observability ;
  skos:related dpc:genai-evaluation ;
  skos:related dpc:ai-spend-controls ;
  skos:related dpc:ai-context-layer ;
  dpc:dependsOn dpc:foundation-model-access ;
  skos:altLabel "agentic AI"@en ;
  skos:altLabel "agent builder"@en ;
  skos:definition "Build systems in which models plan, call tools and act over several steps to complete a task."@en .

dpc:ai-assisted-development a skos:Concept ;
  skos:prefLabel "AI-assisted development"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:development-lifecycle ;
  skos:related dpc:ai-context-layer ;
  skos:related dpc:ai-generated-documentation ;
  skos:related dpc:data-testing ;
  skos:related dpc:conversational-analytics ;
  skos:related dpc:code-translation ;
  dpc:dependsOn dpc:foundation-model-access ;
  skos:altLabel "coding assistants"@en ;
  skos:altLabel "copilots"@en ;
  skos:definition "Use AI assistants to write, explain, fix and optimise code, SQL and pipelines."@en .

dpc:ai-content-provenance a skos:Concept ;
  skos:prefLabel "AI content marking and provenance"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:generative-ai ;
  skos:broader dpc:ai-governance ;
  skos:related dpc:compliance-evidence ;
  skos:related dpc:unstructured-lineage ;
  skos:altLabel "watermarking"@en ;
  skos:altLabel "C2PA"@en ;
  skos:definition "Mark AI-generated content in machine-readable form and detect such marks so synthetic content can be identified."@en .

dpc:ai-context-layer a skos:Concept ;
  skos:prefLabel "AI context layer"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:metadata ;
  skos:broader dpc:generative-ai ;
  skos:related dpc:semantic-layer ;
  skos:related dpc:business-glossary ;
  skos:related dpc:conversational-analytics ;
  skos:related dpc:knowledge-graphs ;
  skos:related dpc:genai-evaluation ;
  dpc:dependsOn dpc:data-catalogue ;
  skos:altLabel "context layer"@en ;
  skos:altLabel "agent context"@en ;
  skos:altLabel "verified queries"@en ;
  skos:definition "Curate and serve business definitions, verified queries, relationships and usage guidance to AI agents so they interpret and use data correctly."@en .

dpc:ai-functions a skos:Concept ;
  skos:prefLabel "AI functions in SQL"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:processing ;
  skos:broader dpc:generative-ai ;
  skos:related dpc:embedding-generation ;
  skos:related dpc:ai-spend-controls ;
  skos:related dpc:genai-evaluation ;
  skos:related dpc:in-database-ml ;
  skos:related dpc:unstructured-data ;
  dpc:dependsOn dpc:foundation-model-access ;
  skos:altLabel "AI SQL"@en ;
  skos:altLabel "LLM functions"@en ;
  skos:definition "Call language models from SQL or DataFrame code to classify, extract, summarise or translate data at scale."@en .

dpc:ai-gateway a skos:Concept ;
  skos:prefLabel "AI gateway"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:foundation-model-access ;
  skos:related dpc:ai-spend-controls ;
  skos:related dpc:ai-guardrails ;
  skos:related dpc:genai-observability ;
  skos:related dpc:secrets-management ;
  skos:related dpc:agent-tool-access ;
  dpc:dependsOn dpc:identity-authentication ;
  skos:altLabel "LLM gateway"@en ;
  skos:altLabel "model router"@en ;
  skos:definition "Route, secure, rate-limit and track model calls across providers from one place."@en .

dpc:ai-generated-documentation a skos:Concept ;
  skos:prefLabel "AI-generated documentation"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:data-catalogue ;
  skos:related dpc:ai-context-layer ;
  skos:related dpc:data-classification ;
  skos:related dpc:business-glossary ;
  skos:related dpc:transformation-as-code ;
  dpc:dependsOn dpc:metadata-harvesting ;
  dpc:dependsOn dpc:foundation-model-access ;
  skos:definition "Draft descriptions, tags and documentation for data assets using AI, for people to review."@en .

dpc:ai-governance a skos:Concept ;
  skos:prefLabel "AI governance"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:governance ;
  skos:related dpc:model-governance ;
  skos:related dpc:genai-evaluation ;
  skos:related dpc:ai-guardrails ;
  skos:related dpc:model-registry ;
  skos:related dpc:ai-gateway ;
  skos:altLabel "responsible AI"@en ;
  skos:definition "Inventory AI systems and govern their risk, approval, documentation and use in line with regulation."@en .

dpc:ai-guardrails a skos:Concept ;
  skos:prefLabel "AI guardrails"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:generative-ai ;
  skos:related dpc:data-loss-prevention ;
  skos:related dpc:ai-red-teaming ;
  skos:related dpc:ai-gateway ;
  skos:related dpc:data-classification ;
  skos:related dpc:deidentification ;
  skos:altLabel "content safety"@en ;
  skos:altLabel "content filters"@en ;
  skos:altLabel "prompt shields"@en ;
  skos:altLabel "safety filters"@en ;
  skos:definition "Check model inputs, outputs and agent tool calls against policy to block harmful content, data leakage, prompt injection and disallowed actions."@en .

dpc:ai-impact-assessment a skos:Concept ;
  skos:prefLabel "AI impact assessment"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:ai-governance ;
  skos:related dpc:privacy-impact-assessment ;
  skos:related dpc:fairness-assessment ;
  skos:related dpc:model-explainability ;
  skos:related dpc:genai-evaluation ;
  skos:related dpc:model-governance ;
  skos:altLabel "fundamental rights impact assessment"@en ;
  skos:altLabel "algorithmic impact assessment"@en ;
  skos:definition "Assess and record an AI system's effects on people and society before release and whenever it changes."@en .

dpc:ai-incident-management a skos:Concept ;
  skos:prefLabel "AI incident management"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:ai-governance ;
  skos:related dpc:genai-observability ;
  skos:related dpc:data-issue-management ;
  skos:related dpc:ai-red-teaming ;
  skos:related dpc:genai-evaluation ;
  skos:related dpc:human-oversight ;
  dpc:dependsOn dpc:inference-logging ;
  skos:definition "Record, investigate and report incidents and malfunctions involving AI systems, including notifying regulators where required."@en .

dpc:ai-red-teaming a skos:Concept ;
  skos:prefLabel "AI red teaming"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:genai-evaluation ;
  skos:related dpc:ai-guardrails ;
  skos:related dpc:ai-incident-management ;
  skos:related dpc:ai-impact-assessment ;
  skos:related dpc:agent-tool-access ;
  skos:definition "Probe models and agents adversarially for prompt injection, jailbreaks and unsafe behaviour before and after release."@en .

dpc:ai-spend-controls a skos:Concept ;
  skos:prefLabel "AI usage and spend controls"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:cost-management ;
  skos:broader dpc:generative-ai ;
  skos:related dpc:genai-observability ;
  skos:related dpc:ai-functions ;
  skos:related dpc:reserved-capacity ;
  skos:related dpc:spend-controls ;
  skos:related dpc:data-engineering-agents ;
  dpc:dependsOn dpc:ai-gateway ;
  skos:altLabel "token budgets"@en ;
  skos:altLabel "AI quotas"@en ;
  skos:definition "Limit, prioritise and attribute model and agent consumption per user, team or application."@en .

dpc:ai-supply-chain-security a skos:Concept ;
  skos:prefLabel "AI supply chain security"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:security ;
  skos:broader dpc:ai-governance ;
  skos:related dpc:model-governance ;
  skos:related dpc:agent-registry ;
  skos:related dpc:runtime-management ;
  skos:related dpc:model-registry ;
  skos:related dpc:ai-system-discovery ;
  skos:altLabel "AI bill of materials"@en ;
  skos:altLabel "AI-BOM"@en ;
  skos:altLabel "ML-BOM"@en ;
  skos:altLabel "model scanning"@en ;
  skos:altLabel "model signing"@en ;
  skos:definition "Check third-party models, model files, libraries and tool servers for tampering and malicious code before use, and record what each AI system is built from."@en .

dpc:ai-system-discovery a skos:Concept ;
  skos:prefLabel "AI system discovery"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:ai-governance ;
  skos:related dpc:ai-gateway ;
  skos:related dpc:agent-registry ;
  skos:related dpc:data-security-posture ;
  skos:related dpc:model-registry ;
  skos:related dpc:network-security ;
  skos:altLabel "shadow AI discovery"@en ;
  skos:definition "Find the AI models, agents and services in use, including unapproved ones, to build and maintain the AI inventory."@en .

dpc:airbyte a dpc:Technology ;
  skos:prefLabel "Airbyte"@en ;
  dcterms:description "Data integration platform with hundreds of prebuilt connectors for loading data from databases, APIs and SaaS applications into warehouses and lakes."@en ;
  skos:altLabel "Airbyte Core"@en ;
  skos:altLabel "Airbyte Open Source"@en ;
  dpc:realises dpc:saas-connectors ;
  dpc:realises dpc:database-extraction ;
  dpc:realises dpc:api-ingestion ;
  dpc:realises dpc:custom-connectors ;
  dpc:realises dpc:change-data-capture ;
  dpc:realises dpc:idempotent-loading ;
  dpc:platform dpc:platform-open-source ;
  rdfs:seeAlso <https://github.com/airbytehq/airbyte> .

dpc:airbyte-agents a dpc:Technology ;
  skos:prefLabel "Airbyte Agents"@en ;
  dcterms:description "Type-safe connectors that give AI agents live read access to business applications through an MCP server, a Python SDK and an HTTP API."@en ;
  dpc:realises dpc:agent-tool-access ;
  dpc:realises dpc:saas-connectors ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://docs.airbyte.com/> .

dpc:airbyte-cloud a dpc:Technology ;
  skos:prefLabel "Airbyte Cloud"@en ;
  dcterms:description "Managed version of the Airbyte data movement platform, with more than 600 source and destination connectors, a low-code Connector Builder and API and Terraform control."@en ;
  dpc:realises dpc:saas-connectors ;
  dpc:realises dpc:database-extraction ;
  dpc:realises dpc:change-data-capture ;
  dpc:realises dpc:custom-connectors ;
  dpc:realises dpc:hybrid-data-plane ;
  dpc:realises dpc:idempotent-loading ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://airbyte.com/airbyte-cloud> .

dpc:alation-aios a dpc:Technology ;
  skos:prefLabel "Alation Intelligence Operating System (AIOS)"@en ;
  dcterms:description "Alation's catalogue platform, which combines search, curation, lineage, glossary, trust flags, data products and a marketplace with AI agents that document and curate assets."@en ;
  skos:altLabel "Alation"@en ;
  skos:altLabel "AIOS"@en ;
  skos:altLabel "Alation Data Intelligence Platform"@en ;
  dpc:realises dpc:data-catalogue ;
  dpc:realises dpc:usage-metadata ;
  dpc:realises dpc:data-certification ;
  dpc:realises dpc:column-lineage ;
  dpc:realises dpc:data-marketplace ;
  dpc:realises dpc:critical-data-elements ;
  dpc:realises dpc:data-trust-indicators ;
  dpc:realises dpc:stewardship-workflows ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://www.alation.com/> .

dpc:alteryx-one a dpc:Technology ;
  skos:prefLabel "Alteryx One"@en ;
  dcterms:description "Analytics automation platform for no-code data preparation, blending and analytic workflows, with conversational analytics and an agent studio."@en ;
  skos:altLabel "Alteryx Designer"@en ;
  dpc:realises dpc:data-preparation ;
  dpc:realises dpc:low-code-transformation ;
  dpc:realises dpc:conversational-analytics ;
  dpc:realises dpc:ai-agents ;
  dpc:platform dpc:platform-independent ;
  rdfs:seeAlso <https://www.alteryx.com/> .

dpc:analytical-sandboxes a skos:Concept ;
  skos:prefLabel "Analytical sandboxes"@en ;
  skos:inScheme dpc:capabilities ;
  skos:broader dpc:analytics-bi ;
  skos:broader dpc:self-service-provisioning ;
  skos:related dpc:data-preparation ;
  skos:related dpc:ad-hoc-analysis ;
  skos:related dpc:data-classification ;
  skos:related dpc:data-retention ;
  skos:related dpc:test-data-management ;
  dpc:dependsOn dpc:access-control ;
  dpc:dependsOn dpc:spend-controls ;
  skos:altLabel "user sandboxes"@en ;
  skos:altLabel "personal schemas"@en ;
  skos:altLabel "data lab"@en ;
  skos:altLabel "scratch space"@en ;
  skos:altLabel "team analysis space"@en ;
  skos:altLabel "file upload"@en ;
  skos:definition "Give analysts and teams governed spaces on the platform where they can upload files, create tables and try out analyses, with quotas, expiry and the platform's access controls."@en .

dpc:analytics-bi a skos:Concept ;
  skos:prefLabel "Analytics and BI"@en ;
  skos:inScheme dpc:capabilities ;
  skos:topConceptOf dpc:capabilities ;
  skos:related dpc:ai-context-layer ;
  skos:related dpc:query-acceleration ;
  skos:related dpc:workload-isolation ;
  skos:related dpc:row-level-security ;
  skos:related dpc:data-certification ;
  dpc:dependsOn dpc:sql-access ;
  skos:altLabel "business intelligence"@en ;
  skos:altLabel "visualisation"@en ;
  skos:definition "Help people explore, visualise and report on data to make decisions."@en .

dpc:anomalo a dpc:Technology ;
  skos:prefLabel "Anomalo"@en ;
