  dpc:realises dpc:agent-tool-access ;
  dpc:realises dpc:agent-runtime ;
  dpc:realises dpc:agent-memory ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/products/cloud/features/ai-ml/agents> .

dpc:clickhouse-ai-functions a dpc:Technology ;
  skos:prefLabel "ClickHouse AI functions"@en ;
  dcterms:description "SQL functions such as aiGenerate, aiClassify, aiExtract, aiTranslate, aiRedact and aiEmbed that call an LLM or embedding endpoint for each row."@en ;
  dpc:realises dpc:ai-functions ;
  dpc:realises dpc:embedding-generation ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/sql-reference/functions/ai-functions> .

dpc:clickhouse-backups a dpc:Technology ;
  skos:prefLabel "ClickHouse Cloud backups and BACKUP/RESTORE"@en ;
  dcterms:description "Scheduled Cloud backups restored to a new service, and SQL BACKUP and RESTORE statements that write full or incremental backups to disk, S3 or Azure in self-managed clusters."@en ;
  dpc:realises dpc:backup-restore ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/cloud/manage/backups/overview> .

dpc:clickhouse-byoc a dpc:Technology ;
  skos:prefLabel "ClickHouse BYOC (Bring Your Own Cloud)"@en ;
  dcterms:description "Runs the ClickHouse Cloud data plane, including clusters, data and backups, inside the customer's own cloud account while ClickHouse operates the control plane."@en ;
  dpc:realises dpc:hybrid-data-plane ;
  dpc:realises dpc:data-residency ;
  dpc:realises dpc:network-security ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/cloud/reference/byoc/overview> .

dpc:clickhouse-chdb a dpc:Technology ;
  skos:prefLabel "chDB"@en ;
  dcterms:description "In-process OLAP engine built on ClickHouse that runs inside Python, Go, Rust, Node.js or C/C++ programs, with a pandas-compatible DataStore API."@en ;
  dpc:realises dpc:single-node-processing ;
  dpc:realises dpc:dataframe-apis ;
  dpc:realises dpc:local-development ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/chdb> .

dpc:clickhouse-clickpipes a dpc:Technology ;
  skos:prefLabel "ClickPipes"@en ;
  dcterms:description "Managed ingestion service in ClickHouse Cloud that runs continuous or one-off pipes from streaming platforms and object storage into ClickHouse tables, with scaling separate from the database."@en ;
  dpc:realises dpc:streaming-ingestion ;
  dpc:realises dpc:file-ingestion ;
  dpc:realises dpc:bad-data-quarantine ;
  dpc:realises dpc:iot-ingestion ;
  dpc:realises dpc:idempotent-loading ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/integrations/clickpipes> .

dpc:clickhouse-clickpipes-cdc a dpc:Technology ;
  skos:prefLabel "ClickPipes database connectors (Postgres CDC, MySQL CDC, MongoDB CDC, BigQuery)"@en ;
  dcterms:description "ClickPipes connectors that take an initial snapshot of source tables and then replicate inserts, updates and deletes from Postgres, MySQL or MongoDB logs into ClickHouse, plus a BigQuery connector for bulk and incremental loads."@en ;
  skos:altLabel "PeerDB"@en ;
  dpc:realises dpc:change-data-capture ;
  dpc:realises dpc:database-replication ;
  dpc:realises dpc:database-extraction ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/integrations/clickpipes/postgres> .

dpc:clickhouse-clickstack a dpc:Technology ;
  skos:prefLabel "ClickStack"@en ;
  dcterms:description "Observability stack that combines the HyperDX UI, a preconfigured OpenTelemetry collector and ClickHouse to store and search logs, traces, metrics and session replays, with dashboards and alerts."@en ;
  skos:altLabel "HyperDX"@en ;
  dpc:realises dpc:observability-analytics ;
  dpc:realises dpc:dashboards-reports ;
  dpc:realises dpc:data-alerting ;
  dpc:realises dpc:time-series-data ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/use-cases/observability/clickstack/overview> .

dpc:clickhouse-clients a dpc:Technology ;
  skos:prefLabel "ClickHouse interfaces and client drivers"@en ;
  dcterms:description "HTTP, native TCP, gRPC and Arrow Flight interfaces, MySQL and PostgreSQL wire-protocol compatibility, and official clients including JDBC, ODBC, ADBC, Python, Go, Node.js, Rust, C++ and .NET."@en ;
  dpc:realises dpc:sql-access ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/interfaces/overview> .

dpc:clickhouse-cloud a dpc:Technology ;
  skos:prefLabel "ClickHouse Cloud"@en ;
  dcterms:description "Fully managed ClickHouse on AWS, GCP and Azure that stores data in object storage and scales, idles and upgrades services automatically."@en ;
  dpc:realises dpc:real-time-analytics ;
  dpc:realises dpc:serverless-compute ;
  dpc:realises dpc:elastic-scaling ;
  dpc:realises dpc:identity-authentication ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/cloud/manage/cloud-tiers> .

dpc:clickhouse-cloud-monitoring a dpc:Technology ;
  skos:prefLabel "ClickHouse Query Insights and system tables"@en ;
  dcterms:description "Console views of query volume, latency and errors built on system.query_log, alongside system tables, Cloud monitoring dashboards and Prometheus endpoints that expose server, query and ClickPipes metrics."@en ;
  skos:altLabel "system.query_log"@en ;
  dpc:realises dpc:query-performance-analysis ;
  dpc:realises dpc:system-telemetry ;
  dpc:realises dpc:audit-logging ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/cloud/get-started/query-insights> .

dpc:clickhouse-cmek a dpc:Technology ;
  skos:prefLabel "ClickHouse Cloud TDE and customer-managed encryption keys (CMEK)"@en ;
  dcterms:description "Adds database-level encryption to Cloud services and lets the customer supply and rotate the wrapping key in AWS KMS, GCP KMS or Azure Key Vault."@en ;
  dpc:realises dpc:customer-managed-keys ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/cloud/security/cmek> .

dpc:clickhouse-cost-controls a dpc:Technology ;
  skos:prefLabel "ClickHouse Cloud usage breakdown and spend alerts"@en ;
  dcterms:description "Console usage breakdown by service and cost category, a usage cost API, and organisation spend alerts at set thresholds of committed or budgeted spend."@en ;
  dpc:realises dpc:cost-attribution ;
  dpc:realises dpc:spend-controls ;
  dpc:realises dpc:cost-optimisation ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/resources/changelogs/cloud/2026> .

dpc:clickhouse-data-lake a dpc:Technology ;
  skos:prefLabel "ClickHouse data lake table engines and functions (Iceberg, Delta Lake, Hudi, Paimon)"@en ;
  dcterms:description "Table functions and engines that query Apache Iceberg, Delta Lake, Apache Hudi and Apache Paimon tables in object storage, with Iceberg time travel and the ability to create and insert into Iceberg tables."@en ;
  dpc:realises dpc:query-federation ;
  dpc:realises dpc:engine-interoperability ;
  dpc:realises dpc:open-table-formats ;
  dpc:realises dpc:time-travel ;
  dpc:realises dpc:data-export ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/use-cases/data-lake/support-matrix> .

dpc:clickhouse-datalakecatalog a dpc:Technology ;
  skos:prefLabel "ClickHouse DataLakeCatalog database engine"@en ;
  dcterms:description "Database engine that connects to an external lakehouse catalogue and exposes its tables as ClickHouse tables for querying and joining."@en ;
  dpc:realises dpc:catalogue-federation ;
  dpc:realises dpc:engine-interoperability ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/engines/database-engines/datalakecatalog> .

dpc:clickhouse-dbt a dpc:Technology ;
  skos:prefLabel "dbt-clickhouse adapter"@en ;
  dcterms:description "ClickHouse-supported dbt adapter that builds views, tables, incremental and microbatch models, materialised views and dictionaries in ClickHouse."@en ;
  dpc:realises dpc:transformation-as-code ;
  dpc:realises dpc:data-testing ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/integrations/dbt> .

dpc:clickhouse-dictionaries a dpc:Technology ;
  skos:prefLabel "ClickHouse dictionaries"@en ;
  dcterms:description "In-memory key-value lookups loaded from ClickHouse tables, external databases, HTTP or files, refreshed on a set lifetime and queried with dictGet functions or as tables."@en ;
  dpc:realises dpc:query-acceleration ;
  dpc:realises dpc:query-federation ;
  dpc:realises dpc:low-latency-serving ;
  dpc:realises dpc:data-enrichment ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/sql-reference/dictionaries> .

dpc:clickhouse-geo a dpc:Technology ;
  skos:prefLabel "ClickHouse geo data types and functions"@en ;
  dcterms:description "Point, polygon and line types plus functions for great-circle distances, point-in-polygon tests, geohash, H3 and S2 indexing and Mapbox vector tile encoding."@en ;
  dpc:realises dpc:geospatial-data ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/sql-reference/functions/geo> .

dpc:clickhouse-grafana-plugin a dpc:Technology ;
  skos:prefLabel "ClickHouse data source plugin for Grafana"@en ;
  dcterms:description "Signed Grafana data source with a query builder for building dashboards and exploring logs and traces stored in ClickHouse."@en ;
  dpc:realises dpc:dashboards-reports ;
  dpc:realises dpc:platform-observability ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/integrations/grafana> .

dpc:clickhouse-integration-engines a dpc:Technology ;
  skos:prefLabel "ClickHouse integration table engines and table functions"@en ;
  dcterms:description "Engines and functions such as postgresql, mysql, mongodb, s3, url, jdbc, odbc and arrowflight that read from and write to external databases and storage directly in SQL."@en ;
  dpc:realises dpc:query-federation ;
  dpc:realises dpc:database-extraction ;
  dpc:realises dpc:data-export ;
  dpc:realises dpc:file-formats ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/engines/table-engines/integrations> .

dpc:clickhouse-json-types a dpc:Technology ;
  skos:prefLabel "ClickHouse JSON, Dynamic and Variant data types"@en ;
  dcterms:description "Column types that store semi-structured JSON as typed sub-columns per path, and values whose type varies from row to row, without flattening them first."@en ;
  dpc:realises dpc:semi-structured-data ;
  dpc:realises dpc:schema-evolution ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/sql-reference/data-types/newjson> .

dpc:clickhouse-kafka-engine a dpc:Technology ;
  skos:prefLabel "ClickHouse Kafka table engine"@en ;
  dcterms:description "Table engine that consumes Kafka topics as a consumer group and, with a materialised view, writes messages continuously into MergeTree tables; RabbitMQ and NATS engines work the same way."@en ;
  dpc:realises dpc:streaming-ingestion ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/engines/table-engines/integrations/kafka> .

dpc:clickhouse-keeper a dpc:Technology ;
  skos:prefLabel "ClickHouse Keeper"@en ;
  dcterms:description "Raft-based coordination service, compatible with the ZooKeeper client protocol, that coordinates replication, distributed DDL and queue engines."@en ;
  dpc:realises dpc:business-continuity ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/guides/sre/keeper/clickhouse-keeper> .

dpc:clickhouse-langfuse a dpc:Technology ;
  skos:prefLabel "Langfuse"@en ;
  dcterms:description "LLM engineering platform that traces model and agent calls, runs evaluations and experiments on datasets, and versions prompts, available self-hosted or as Langfuse Cloud."@en ;
  dpc:realises dpc:genai-observability ;
  dpc:realises dpc:genai-evaluation ;
  dpc:realises dpc:prompt-management ;
  dpc:realises dpc:training-dataset-management ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://langfuse.com/docs> .

dpc:clickhouse-lightweight-updates-deletes a dpc:Technology ;
  skos:prefLabel "ClickHouse lightweight updates and deletes"@en ;
  dcterms:description "Changes or removes individual rows in MergeTree tables by writing small patch parts or a deleted-row mask that queries apply at once, instead of rewriting whole parts."@en ;
  dpc:realises dpc:row-level-updates ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/sql-reference/statements/update> .

dpc:clickhouse-local a dpc:Technology ;
  skos:prefLabel "clickhouse-local"@en ;
  dcterms:description "Mode of the ClickHouse binary that runs SQL over local or remote files and piped data without starting a server."@en ;
  dpc:realises dpc:single-node-processing ;
  dpc:realises dpc:local-development ;
  dpc:realises dpc:file-formats ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/operations/utilities/clickhouse-local> .

dpc:clickhouse-managed-postgres a dpc:Technology ;
  skos:prefLabel "ClickHouse Managed Postgres"@en ;
  dcterms:description "Managed PostgreSQL on local NVMe storage with high availability, read replicas and point-in-time recovery, wired to ClickHouse through built-in CDC and the pg_clickhouse extension."@en ;
  skos:altLabel "Postgres managed by ClickHouse"@en ;
  dpc:realises dpc:operational-database ;
  dpc:realises dpc:change-data-capture ;
  dpc:realises dpc:query-federation ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/cloud/managed-postgres> .

dpc:clickhouse-materialized-views a dpc:Technology ;
  skos:prefLabel "ClickHouse incremental materialized views"@en ;
  dcterms:description "Insert triggers that run a query over each newly inserted block and write the results to a target table, usually an AggregatingMergeTree or SummingMergeTree that merges partial aggregates."@en ;
  dpc:realises dpc:materialised-views ;
  dpc:realises dpc:incremental-processing ;
  dpc:realises dpc:sql-transformation ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/materialized-view/incremental-materialized-view> .

dpc:clickhouse-mcp-server a dpc:Technology ;
  skos:prefLabel "ClickHouse MCP server (open-source and Remote MCP in Cloud)"@en ;
  dcterms:description "Model Context Protocol servers that let AI assistants list ClickHouse databases and tables and run read-only queries, including a managed remote endpoint for ClickHouse Cloud."@en ;
  skos:altLabel "mcp-clickhouse"@en ;
  dpc:realises dpc:agent-tool-access ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/products/cloud/features/ai-ml/remote-mcp> .

dpc:clickhouse-mergetree a dpc:Technology ;
  skos:prefLabel "MergeTree table engine family"@en ;
  dcterms:description "Core storage engines that write sorted, compressed column parts, merge them in the background, and index them with a sparse primary index, with variants that deduplicate, sum, aggregate or collapse rows during merges."@en ;
  dpc:realises dpc:columnar-storage ;
  dpc:realises dpc:partitioning-clustering ;
  dpc:realises dpc:table-maintenance ;
  dpc:realises dpc:row-level-updates ;
  dpc:realises dpc:data-skipping-indexes ;
  dpc:realises dpc:idempotent-loading ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/engines/table-engines/mergetree-family> .

dpc:clickhouse-private-link a dpc:Technology ;
  skos:prefLabel "ClickHouse Cloud private networking (AWS PrivateLink, GCP Private Service Connect, Azure Private Link)"@en ;
  dcterms:description "Connects ClickHouse Cloud services and ClickPipes to customer virtual networks over the cloud providers' private endpoint services, and restricts public access with IP filters."@en ;
  dpc:realises dpc:network-security ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/cloud/security/private-link-overview> .

dpc:clickhouse-projections a dpc:Technology ;
  skos:prefLabel "ClickHouse projections"@en ;
  dcterms:description "Hidden, automatically maintained copies of a table with a different sort order or pre-aggregation that the optimiser picks when they reduce the data read."@en ;
  dpc:realises dpc:query-acceleration ;
  dpc:realises dpc:data-skipping-indexes ;
  dpc:realises dpc:materialised-views ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/data-modeling/projections> .

dpc:clickhouse-query-api-endpoints a dpc:Technology ;
  skos:prefLabel "ClickHouse Cloud Query API Endpoints"@en ;
  dcterms:description "Turns a saved, parameterised SQL query in the Cloud console into an authenticated HTTP endpoint that returns results in any ClickHouse format."@en ;
  dpc:realises dpc:data-apis ;
  dpc:realises dpc:low-latency-serving ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/cloud/get-started/query-endpoints> .

dpc:clickhouse-query-cache a dpc:Technology ;
  skos:prefLabel "ClickHouse query cache"@en ;
  dcterms:description "Stores the results of SELECT queries in memory, or optionally on disk, and serves repeats until a time to live expires."@en ;
  dpc:realises dpc:result-caching ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/operations/query-cache> .

dpc:clickhouse-refreshable-materialized-views a dpc:Technology ;
  skos:prefLabel "ClickHouse refreshable materialized views"@en ;
  dcterms:description "Views that rerun a full query on a schedule and replace or append to a target table, with optional dependencies between views."@en ;
  dpc:realises dpc:materialised-views ;
  dpc:realises dpc:sql-transformation ;
  dpc:realises dpc:workflow-orchestration ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/materialized-view/refreshable-materialized-view> .

dpc:clickhouse-s3queue a dpc:Technology ;
  skos:prefLabel "S3Queue and AzureQueue table engines"@en ;
  dcterms:description "Table engines that watch an S3 or Azure Blob path and load new files in the background through a materialised view, tracking which files have been processed in Keeper."@en ;
  dpc:realises dpc:file-ingestion ;
  dpc:realises dpc:event-driven-triggering ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/engines/table-engines/integrations/s3queue> .

dpc:clickhouse-server a dpc:Technology ;
  skos:prefLabel "ClickHouse server"@en ;
  dcterms:description "Open-source column-oriented SQL database that runs analytical queries over very large tables with vectorised, parallel execution on single servers or sharded and replicated clusters."@en ;
  skos:altLabel "ClickHouse OSS"@en ;
  skos:altLabel "open-source ClickHouse"@en ;
  dpc:realises dpc:real-time-analytics ;
  dpc:realises dpc:sql-query-engine ;
  dpc:realises dpc:distributed-processing ;
  dpc:realises dpc:time-series-data ;
  dpc:realises dpc:approximate-query-processing ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs> .

dpc:clickhouse-sharedmergetree a dpc:Technology ;
  skos:prefLabel "SharedMergeTree"@en ;
  dcterms:description "Cloud-native counterpart of the MergeTree family that keeps table data and metadata in shared object storage and coordinates replicas through Keeper instead of copying data between them."@en ;
  dpc:realises dpc:decoupled-storage-compute ;
  dpc:realises dpc:managed-storage ;
  dpc:realises dpc:elastic-scaling ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/cloud/reference/shared-merge-tree> .

dpc:clickhouse-skipping-indexes a dpc:Technology ;
  skos:prefLabel "ClickHouse data skipping indexes"@en ;
  dcterms:description "Per-block minmax, set and Bloom filter indexes that let queries skip granules which cannot match a filter, after the primary index has pruned data."@en ;
  dpc:realises dpc:data-skipping-indexes ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/optimize/skipping-indexes> .

dpc:clickhouse-sql-console a dpc:Technology ;
  skos:prefLabel "ClickHouse Cloud SQL console (with Dashboards and ClickHouse Assistant)"@en ;
  dcterms:description "Browser workspace for writing and sharing queries, charting results, building parameterised dashboards from saved queries and asking an AI assistant to write SQL or explore data."@en ;
  skos:altLabel "ClickHouse Assistant"@en ;
  dpc:realises dpc:ad-hoc-analysis ;
  dpc:realises dpc:dashboards-reports ;
  dpc:realises dpc:conversational-analytics ;
  dpc:realises dpc:ai-assisted-development ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/cloud/get-started/sql-console> .

dpc:clickhouse-terraform a dpc:Technology ;
  skos:prefLabel "ClickHouse Terraform provider"@en ;
  dcterms:description "Official Terraform provider for ClickHouse Cloud services, scaling, private endpoints, organisation roles and API keys, ClickPipes, ClickStack resources and Managed Postgres."@en ;
  dpc:realises dpc:infrastructure-as-code ;
  dpc:realises dpc:environment-promotion ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://github.com/ClickHouse/terraform-provider-clickhouse> .

dpc:clickhouse-text-indexes a dpc:Technology ;
  skos:prefLabel "ClickHouse text indexes (full-text search)"@en ;
  dcterms:description "Inverted indexes on string, array and map columns with configurable tokenisers that answer token, phrase and pattern searches without scanning."@en ;
  dpc:realises dpc:full-text-search ;
  dpc:realises dpc:data-skipping-indexes ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/engines/table-engines/mergetree-family/textindexes> .

dpc:clickhouse-timeseries a dpc:Technology ;
  skos:prefLabel "ClickHouse TimeSeries table engine"@en ;
  dcterms:description "Experimental engine that stores Prometheus-style metrics as samples, tags and metric tables and accepts Prometheus remote-write and remote-read traffic."@en ;
  dpc:realises dpc:time-series-data ;
  dpc:realises dpc:observability-analytics ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/engines/table-engines/special/time_series> .

dpc:clickhouse-ttl a dpc:Technology ;
  skos:prefLabel "ClickHouse TTL (time to live)"@en ;
  dcterms:description "Table and column rules that delete, roll up, recompress or move data once it reaches a given age, applied during background merges."@en ;
  dpc:realises dpc:data-retention ;
  dpc:realises dpc:storage-tiering ;
  dpc:realises dpc:table-maintenance ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/guides/developer/ttl> .

dpc:clickhouse-udfs a dpc:Technology ;
  skos:prefLabel "ClickHouse user-defined functions"@en ;
  dcterms:description "Extends ClickHouse with SQL lambda functions, executable functions that call external scripts such as Python over standard input and output, and experimental WebAssembly functions."@en ;
  dpc:realises dpc:user-defined-functions ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/sql-reference/functions/udf> .

dpc:clickhouse-vector-search a dpc:Technology ;
  skos:prefLabel "ClickHouse vector similarity indexes"@en ;
  dcterms:description "HNSW indexes on embedding columns for approximate nearest-neighbour search with L2, cosine or dot-product distance, alongside exact brute-force search and the QBit type."@en ;
  dpc:realises dpc:vector-search ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/engines/table-engines/mergetree-family/annindexes> .

dpc:clickhouse-warehouses a dpc:Technology ;
  skos:prefLabel "ClickHouse Cloud Warehouses (compute-compute separation)"@en ;
  dcterms:description "Groups several Cloud services with their own replicas and endpoints over the same data, so ingestion, reporting and ad hoc workloads can run on separately sized compute."@en ;
  skos:altLabel "compute-compute separation"@en ;
  dpc:realises dpc:workload-isolation ;
  dpc:realises dpc:decoupled-storage-compute ;
  dpc:realises dpc:elastic-scaling ;
  dpc:platform dpc:platform-clickhouse ;
  rdfs:seeAlso <https://clickhouse.com/docs/cloud/reference/warehouses> .

dpc:clickhouse-workload-scheduling a dpc:Technology ;
  skos:prefLabel "ClickHouse workload scheduling"@en ;
