dpc:vllm a dpc:Technology ;
  skos:prefLabel "vLLM"@en ;
  dcterms:description "High-throughput inference and serving engine for large language models, with an OpenAI-compatible API."@en ;
  dpc:realises dpc:generative-model-serving ;
  dpc:realises dpc:real-time-inference ;
  dpc:realises dpc:gpu-compute ;
