  dpc:realises dpc:internal-data-sharing ;
  dpc:realises dpc:data-marketplace ;
  dpc:realises dpc:cross-region-sharing ;
  dpc:realises dpc:data-product-metering ;
  dpc:platform dpc:platform-google-cloud ;
  rdfs:seeAlso <https://docs.cloud.google.com/bigquery/docs/analytics-hub-introduction> .

dpc:gcp-bigquery-storage-write-api a dpc:Technology ;
  skos:prefLabel "BigQuery Storage Write API"@en ;
  dcterms:description "High-throughput API for streaming or batch-committing rows into BigQuery tables with exactly-once semantics, readable within seconds."@en ;
  dpc:realises dpc:streaming-ingestion ;
  dpc:realises dpc:batch-ingestion ;
  dpc:realises dpc:idempotent-loading ;
  dpc:platform dpc:platform-google-cloud ;
